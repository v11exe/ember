+
+class BrowserView;
+
+namespace ui {
+class KeyEvent;
+class MenuModel;
+class MouseEvent;
+}  // namespace ui
+
+namespace ember {
+
+class EmberGlassMenuPanel;
+
+// One BrowserView-owned native overlay host shared by EmberGlass consumers.
+// Context-menu capture is one-shot per opening; pointer movement only advances
+// the cheap highlight animation over the cached glass panel.
+class EmberGlassOverlayController : public views::View,
+                                    public gfx::AnimationDelegate {
+ public:
+  explicit EmberGlassOverlayController(BrowserView* browser_view);
+  EmberGlassOverlayController(const EmberGlassOverlayController&) = delete;
+  EmberGlassOverlayController& operator=(
+      const EmberGlassOverlayController&) = delete;
+  ~EmberGlassOverlayController() override;
+
+  void ShowMenu(ui::MenuModel* model, const gfx::Point& page_point);
+  void CancelContextMenu(const ui::MenuModel* model);
+  bool IsShowingContextMenu() const;
+
+  // views::View:
+  bool OnMousePressed(const ui::MouseEvent& event) override;
+  bool OnKeyPressed(const ui::KeyEvent& event) override;
+  void Layout(PassKey) override;
+
+  // gfx::AnimationDelegate:
+  void AnimationProgressed(const gfx::Animation* animation) override;
+
+ private:
+  friend class EmberGlassMenuPanel;
+
+  gfx::Rect ClampToOverlayBounds(const gfx::Point& origin,
+                                 const gfx::Size& panel_size) const;
+  void RebuildMenu(ui::MenuModel* model);
+  void ActivateMenuItem(size_t model_index, int event_flags);
+  void HoverMenuItem(size_t model_index, float target_y);
+  void OpenSubmenu(size_t model_index);
+  void CloseSubmenu();
+  void MoveSelection(int delta);
+  void CloseContextMenu(bool restore_page_focus);
+  void CaptureBackdrop(uint64_t generation);
+  void OnBackdropCaptured(uint64_t generation, SkBitmap bitmap);
+  void UpdateMenuColors();
+  float MenuHighlightY() const;
+
+  raw_ptr<BrowserView> browser_view_;
+  raw_ptr<EmberGlassMenuPanel> menu_panel_ = nullptr;
+  EmberGlassMaterial material_;
+  std::vector<base::WeakPtr<ui::MenuModel>> menu_stack_;
+  std::vector<size_t> visible_model_indices_;
+  std::vector<raw_ptr<views::View>> menu_rows_;
+  size_t selected_visible_index_ = 0;
+  gfx::Rect menu_panel_rect_;
+  SkBitmap backdrop_snapshot_;
+  uint64_t backdrop_generation_ = 0;
+  float highlight_from_y_ = 0.0f;
+  float highlight_to_y_ = 0.0f;
