+void ToolbarView::MoveExtensionsToSidebar(views::View* sidebar_footer) {
+  if (!extensions_container_ || !sidebar_footer ||
+      extensions_container_->parent() != this) {
+    return;
+  }
+  extensions_container_->ClearProperty(views::kFlexBehaviorKey);
+  sidebar_footer->AddChildView(RemoveChildViewT(extensions_container_.get()));
