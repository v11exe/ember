+void EmberGlassOverlayController::RebuildCtrlTabCards() {
+  switcher_panel_->RemoveAllChildViews();
+  ctrl_tab_cards_.clear();
+  const size_t displayed_count = std::min<size_t>(4, ctrl_tab_entries_.size());
+  if (selected_ctrl_tab_index_ < displayed_count) {
+    displayed_ctrl_tab_start_ = 0;
+  } else {
+    displayed_ctrl_tab_start_ = std::min(
+        selected_ctrl_tab_index_ - displayed_count + 1,
+        ctrl_tab_entries_.size() - displayed_count);
+  }
+  const int panel_width = 20 + static_cast<int>(displayed_count) * 185;
+  switcher_panel_rect_.set_size(gfx::Size(panel_width, 176));
+  const size_t selected_slot =
+      selected_ctrl_tab_index_ - displayed_ctrl_tab_start_;
+  switcher_to_x_ = EmberGlassView::kShadowMargin + 12.0f +
+                   static_cast<float>(selected_slot) * 185.0f;
+
+  for (size_t slot = 0; slot < displayed_count; ++slot) {
+    const size_t entry_index = displayed_ctrl_tab_start_ + slot;
+    tabs::TabInterface* tab = ctrl_tab_entries_[entry_index];
+    content::WebContents* contents = tab ? tab->GetContents() : nullptr;
+    const std::u16string title =
+        contents && !contents->GetTitle().empty() ? contents->GetTitle()
+                                                  : u"New Tab";
+    const std::u16string domain =
+        contents ? base::UTF8ToUTF16(contents->GetLastCommittedURL().host())
+                 : std::u16string();
+    std::u16string label = title;
+    if (!domain.empty()) {
+      label += u"\n" + domain;
+    }
+    auto card = std::make_unique<views::LabelButton>(
+        base::BindRepeating(
+            [](base::WeakPtr<EmberGlassOverlayController> controller,
+               size_t index, const ui::Event&) {
+              if (controller) {
+                controller->SelectCtrlTabCard(index);
+              }
+            },
+            weak_ptr_factory_.GetWeakPtr(), entry_index),
+        label);
+    card->SetHorizontalAlignment(gfx::ALIGN_CENTER);
+    card->SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(10, 9)));
+    card->SetImageLabelSpacing(8);
+    card->SetEnabledTextColors(switcher_panel_->PrimaryTextColor());
+    card->SetFocusBehavior(views::View::FocusBehavior::ALWAYS);
+    card->GetViewAccessibility().SetRole(ax::mojom::Role::kTab);
+    card->GetViewAccessibility().SetName(title);
+    card->GetViewAccessibility().SetIsSelected(
+        entry_index == selected_ctrl_tab_index_);
+    if (TabUIHelper* helper = TabUIHelper::From(tab)) {
+      const ui::ImageModel favicon = helper->GetFavicon();
+      if (!favicon.IsEmpty()) {
+        card->SetImageModel(views::Button::STATE_NORMAL, favicon);
+      }
+    }
+    card->SetBounds(EmberGlassView::kShadowMargin + 12 +
+                        static_cast<int>(slot) * 185,
+                    EmberGlassView::kShadowMargin + 12, 176, 152);
+    views::View* card_ptr = card.get();
+    switcher_panel_->AddChildView(
+        std::unique_ptr<views::View>(std::move(card)));
+    ctrl_tab_cards_.push_back(card_ptr);
+  }
+  switcher_panel_->SchedulePaint();
+}
+
+void EmberGlassOverlayController::SelectCtrlTabCard(size_t entry_index) {
+  if (entry_index >= ctrl_tab_entries_.size()) {
+    return;
+  }
+  selected_ctrl_tab_index_ = entry_index;
+  CommitCtrlTab();
+}
+
+void EmberGlassOverlayController::CloseCtrlTab(bool restore_page_focus) {
+  switcher_animation_.Stop();
+  ctrl_tab_cards_.clear();
+  ctrl_tab_entries_.clear();
+  ctrl_tab_model_ = nullptr;
+  switcher_panel_->RemoveAllChildViews();
+  switcher_panel_->SetVisible(false);
+  SetVisible(false);
+  backdrop_snapshot_.reset();
+  material_.Invalidate();
+  if (restore_page_focus && browser_view_->GetActiveWebContents()) {
+    browser_view_->GetActiveWebContents()->Focus();
+  }
+}
+
+float EmberGlassOverlayController::CtrlTabHighlightX() const {
+  if (!switcher_animation_.is_animating()) {
+    return switcher_to_x_;
+  }
+  const float progress =
+      EaseInOut(static_cast<float>(switcher_animation_.GetCurrentValue()));
+  return switcher_from_x_ + (switcher_to_x_ - switcher_from_x_) * progress;
+}
+
 }  // namespace ember
