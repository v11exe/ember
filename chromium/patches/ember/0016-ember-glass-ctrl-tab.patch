+void BrowserView::ShowEmberCtrlTabSwitcher(bool reverse) {
+  if (!ember_glass_overlay_) {
+    return;
+  }
+  if (ember_glass_overlay_->IsShowingCtrlTab()) {
+    ember_glass_overlay_->AdvanceCtrlTab(reverse);
+    return;
+  }
+  TabStripModel* model = browser_->tab_strip_model();
+  std::erase_if(ember_tab_mru_, [model](tabs::TabInterface* tab) {
+    return model->GetIndexOfTab(tab) == TabStripModel::kNoTab;
+  });
+  for (int index = 0; index < model->count(); ++index) {
+    tabs::TabInterface* tab = model->GetTabAtIndex(index);
+    if (std::find(ember_tab_mru_.begin(), ember_tab_mru_.end(), tab) ==
+        ember_tab_mru_.end()) {
+      ember_tab_mru_.push_back(tab);
+    }
+  }
+  ember_glass_overlay_->ShowCtrlTab(model, ember_tab_mru_, reverse);
+}
+
+void BrowserView::CommitEmberCtrlTabSwitcher() {
+  if (ember_glass_overlay_) {
+    ember_glass_overlay_->CommitCtrlTab();
+  }
+}
+
+void BrowserView::CancelEmberCtrlTabSwitcher() {
+  if (ember_glass_overlay_) {
+    ember_glass_overlay_->CancelCtrlTab();
