+  void GetUnsplashPhoto(const base::ListValue& args) {
+    if (args.empty()) return;
+    AllowJavascript();
+    CancelUnsplashRequest();
+    base::DictValue result;
+    const PrefService* prefs = profile_->GetPrefs();
+    const std::string& key = prefs->GetString(prefs::kEmberUnsplashAccessKey);
+    if (!prefs->GetBoolean(prefs::kEmberUnsplashEnabled) || key.empty()) {
+      result.Set("status", 0);
+      ResolveJavascriptCallback(args[0], base::Value(std::move(result)));
+      return;
+    }
+
+    auto request = std::make_unique<network::ResourceRequest>();
+    request->url = GURL("https://api.unsplash.com/photos/random?"
+                        "orientation=landscape&content_filter=high");
+    request->method = "GET";
+    request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+    request->headers.SetHeader("Authorization", "Client-ID " + key);
+    unsplash_callback_id_ = args[0].Clone();
+    unsplash_loader_ = network::SimpleURLLoader::Create(
+        std::move(request), kUnsplashTrafficAnnotation);
+    unsplash_loader_->SetTimeoutDuration(base::Seconds(10));
+    unsplash_loader_->DownloadToString(
+        profile_->GetDefaultStoragePartition()
+            ->GetURLLoaderFactoryForBrowserProcess().get(),
+        base::BindOnce(&EmberNewTabNavigationHandler::OnUnsplashFetched,
+                       weak_ptr_factory_.GetWeakPtr()),
+        kMaxUnsplashResponseBytes);
+  }
+
+  void OnUnsplashFetched(std::optional<std::string> body) {
+    if (!unsplash_loader_ || !unsplash_callback_id_) return;
+    int status = 0;
+    if (unsplash_loader_->ResponseInfo() &&
+        unsplash_loader_->ResponseInfo()->headers) {
+      status = unsplash_loader_->ResponseInfo()->headers->response_code();
+    }
+    const bool network_ok = unsplash_loader_->NetError() == net::OK;
+    unsplash_loader_.reset();
+    base::DictValue result;
+    result.Set("status", network_ok ? status : 0);
+    if (network_ok && status == 200 && body) {
+      std::optional<base::Value> parsed = base::JSONReader::Read(*body, 0);
+      const base::DictValue* photo = parsed && parsed->is_dict()
+                                         ? &parsed->GetDict()
+                                         : nullptr;
+      const std::string* image =
+          photo ? photo->FindStringByDottedPath("urls.regular") : nullptr;
+      const std::string* profile =
+          photo ? photo->FindStringByDottedPath("user.links.html") : nullptr;
+      const std::string* photographer =
+          photo ? photo->FindStringByDottedPath("user.name") : nullptr;
+      if (image && profile && photographer) {
+        const GURL image_url(*image);
+        const GURL profile_url(*profile);
+        if (image_url.SchemeIs("https") &&
+            image_url.host() == "images.unsplash.com" &&
+            profile_url.SchemeIs("https") &&
+            profile_url.host() == "unsplash.com") {
+          result.Set("imageUrl", image_url.spec());
+          result.Set("profileUrl", profile_url.spec());
+          result.Set("photographer", *photographer);
+        }
+      }
+    }
+    if (IsJavascriptAllowed()) {
+      ResolveJavascriptCallback(*unsplash_callback_id_,
+                                base::Value(std::move(result)));
+    }
+    unsplash_callback_id_.reset();
+  }
