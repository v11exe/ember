+base::DictValue AppearanceHandler::BuildEmberFavoritesState() const {
+  base::ListValue favorites;
+  auto* model = BookmarkModelFactory::GetForBrowserContext(profile_);
+  if (model && model->loaded()) {
+    ember_favorites::EnsureFolder(model);
+    for (const auto* node : ember_favorites::GetNodes(model)) {
+      base::DictValue favorite;
+      favorite.Set("id", base::NumberToString(node->id()));
+      favorite.Set("title", node->GetTitle());
+      favorite.Set("url", node->url().spec());
+      favorites.Append(std::move(favorite));
+    }
+  }
+  base::DictValue state;
+  state.Set("favorites", std::move(favorites));
+  return state;
+}
