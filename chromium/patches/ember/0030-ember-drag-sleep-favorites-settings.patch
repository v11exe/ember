+void AppearanceHandler::GetEmberFavorites(const base::ListValue& args) {
+  CHECK_EQ(1U, args.size());
+  AllowJavascript();
+  ResolveJavascriptCallback(args[0], base::Value(BuildEmberFavoritesState()));
+}
+
+void AppearanceHandler::AddEmberFavorite(const base::ListValue& args) {
+  CHECK_EQ(3U, args.size());
+  const std::string* title = args[1].GetIfString();
+  const std::string* url_text = args[2].GetIfString();
+  auto* model = BookmarkModelFactory::GetForBrowserContext(profile_);
+  const GURL url(url_text ? *url_text : std::string());
+  if (!model || !model->loaded() || !title || title->empty() ||
+      !url.is_valid() || !url.SchemeIsHTTPOrHTTPS()) {
+    RejectJavascriptCallback(args[0],
+                             base::Value("Use a valid HTTP(S) URL and name"));
+    return;
+  }
+  ember_favorites::Add(model, url, base::UTF8ToUTF16(*title),
+                       ember_favorites::GetNodes(model).size());
+  ResolveJavascriptCallback(args[0], base::Value(BuildEmberFavoritesState()));
+}
+
+void AppearanceHandler::UpdateEmberFavorite(const base::ListValue& args) {
+  CHECK_EQ(4U, args.size());
+  const std::string* id_text = args[1].GetIfString();
+  const std::string* title = args[2].GetIfString();
+  const std::string* url_text = args[3].GetIfString();
+  int64_t id = 0;
+  const GURL url(url_text ? *url_text : std::string());
+  auto* model = BookmarkModelFactory::GetForBrowserContext(profile_);
+  if (!model || !id_text || !base::StringToInt64(*id_text, &id) || !title ||
+      title->empty() || !url.is_valid() || !url.SchemeIsHTTPOrHTTPS()) {
+    RejectJavascriptCallback(args[0],
+                             base::Value("Use a valid HTTP(S) URL and name"));
+    return;
+  }
+  for (const auto* node : ember_favorites::GetNodes(model)) {
+    if (node->id() == id) {
+      model->SetTitle(node, base::UTF8ToUTF16(*title),
+                      bookmarks::metrics::BookmarkEditSource::kUser);
+      model->SetURL(node, url, bookmarks::metrics::BookmarkEditSource::kUser);
+      ResolveJavascriptCallback(args[0],
+                                base::Value(BuildEmberFavoritesState()));
+      return;
+    }
+  }
+  RejectJavascriptCallback(args[0], base::Value("Favorite no longer exists"));
+}
+
+void AppearanceHandler::RemoveEmberFavorite(const base::ListValue& args) {
+  CHECK_EQ(2U, args.size());
+  const std::string* id_text = args[1].GetIfString();
+  int64_t id = 0;
+  auto* model = BookmarkModelFactory::GetForBrowserContext(profile_);
+  if (!model || !id_text || !base::StringToInt64(*id_text, &id) ||
+      !ember_favorites::Remove(model, id)) {
+    RejectJavascriptCallback(args[0], base::Value("Favorite no longer exists"));
+    return;
+  }
+  ResolveJavascriptCallback(args[0], base::Value(BuildEmberFavoritesState()));
+}
+
+void AppearanceHandler::MoveEmberFavorite(const base::ListValue& args) {
+  CHECK_EQ(3U, args.size());
+  const std::string* id_text = args[1].GetIfString();
+  const std::optional<int> destination = args[2].GetIfInt();
+  int64_t id = 0;
+  auto* model = BookmarkModelFactory::GetForBrowserContext(profile_);
+  if (!model || !id_text || !base::StringToInt64(*id_text, &id) ||
+      !destination.has_value() || *destination < 0 ||
+      !ember_favorites::Move(model, id, *destination)) {
+    RejectJavascriptCallback(args[0], base::Value("Favorite no longer exists"));
+    return;
+  }
+  ResolveJavascriptCallback(args[0], base::Value(BuildEmberFavoritesState()));
 }
 
