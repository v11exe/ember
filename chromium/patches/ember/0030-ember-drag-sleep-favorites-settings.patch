+bool TabDragController::UpdateEmberFloatingBackgroundTab(
+    const gfx::Point& point_in_screen) {
+  constexpr int kBackgroundTabReleaseDistance = 28;
+  constexpr int kBackgroundTabReattachDistance = 14;
+  gfx::Rect strip_bounds = GetTabstripScreenBounds(source_context_);
+  const int magnetism = ember_floating_tab_widget_
+                            ? kBackgroundTabReattachDistance
+                            : kBackgroundTabReleaseDistance;
+  if (point_in_screen.y() >= strip_bounds.y() - magnetism &&
+      point_in_screen.y() <= strip_bounds.bottom() + magnetism) {
+    CloseEmberFloatingBackgroundTab();
+    return false;
+  }
+
+  TabSlotView* dragged_view = drag_data_.source_view_drag_data()->attached_view;
+  if (!dragged_view) {
+    return false;
+  }
+  const gfx::Size tab_size = dragged_view->size();
+  const gfx::Point origin(
+      point_in_screen.x() -
+          base::ClampRound(drag_data_.mouse_offset_to_size_ratios.x() *
+                           tab_size.width()),
+      point_in_screen.y() - tab_size.height() / 2);
+  if (!ember_floating_tab_widget_) {
+    views::Widget::InitParams params(
+        views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+        views::Widget::InitParams::TYPE_POPUP);
+    params.z_order = ui::ZOrderLevel::kFloatingUIElement;
+    params.opacity = views::Widget::InitParams::WindowOpacity::kTranslucent;
+    params.accept_events = false;
+    params.context = source_context_->GetWidget()->GetNativeWindow();
+    params.bounds = gfx::Rect(origin, tab_size);
+    ember_floating_tab_widget_ = std::make_unique<views::Widget>();
+    ember_floating_tab_widget_->Init(std::move(params));
+    auto image_view = std::make_unique<views::ImageView>();
+    image_view->SetBackground(views::CreateRoundedRectBackground(
+        SkColorSetARGB(0xEE, 0x33, 0x2A, 0x26), 8));
+    ember_floating_tab_image_ =
+        ember_floating_tab_widget_->SetContentsView(std::move(image_view));
+    ember_floating_source_view_ =
+        std::make_unique<views::ViewTracker>(dragged_view);
+
+    gfx::Rect capture_bounds = dragged_view->GetBoundsInScreen();
+    const gfx::Rect window_bounds =
+        source_context_->GetWidget()->GetWindowBoundsInScreen();
+    capture_bounds.Offset(-window_bounds.x(), -window_bounds.y());
+    const int generation = ++ember_floating_tab_generation_;
+    ui::GrabViewSnapshot(
+        source_context_->GetWidget()->GetNativeView(), capture_bounds,
+        base::BindOnce(
+            [](base::WeakPtr<TabDragController> controller, int generation,
+               gfx::Image snapshot) {
+              if (!controller || !controller->ember_floating_tab_image_ ||
+                  controller->ember_floating_tab_generation_ != generation ||
+                  snapshot.IsEmpty()) {
+                return;
+              }
+              controller->ember_floating_tab_image_->SetImage(
+                  ui::ImageModel::FromImageSkia(snapshot.AsImageSkia()));
+              if (views::View* original =
+                      controller->ember_floating_source_view_->view()) {
+                controller->ember_floating_source_created_layer_ =
+                    !original->layer();
+                if (controller->ember_floating_source_created_layer_) {
+                  original->SetPaintToLayer();
+                  original->layer()->SetFillsBoundsOpaquely(false);
+                }
+                controller->ember_floating_source_original_opacity_ =
+                    original->layer()->opacity();
+                original->layer()->SetOpacity(0.f);
+              }
+            },
+            weak_factory_.GetWeakPtr(), generation));
+
+    ember_floating_tab_widget_->Show();
+#if defined(USE_AURA)
+    ui::Layer* layer = ember_floating_tab_widget_->GetNativeWindow()->layer();
+    layer->SetOpacity(0.f);
+    ui::ScopedLayerAnimationSettings animation(layer->GetAnimator());
+    animation.SetTransitionDuration(base::Milliseconds(180));
+    animation.SetTweenType(gfx::Tween::FAST_OUT_SLOW_IN);
+    layer->SetOpacity(1.f);
+#endif
+  } else {
+    ember_floating_tab_widget_->SetBounds(gfx::Rect(origin, tab_size));
+  }
+  return true;
+}
+
+void TabDragController::CloseEmberFloatingBackgroundTab() {
+  ++ember_floating_tab_generation_;
+  ember_floating_tab_image_ = nullptr;
+  if (ember_floating_source_view_) {
+    if (views::View* original = ember_floating_source_view_->view()) {
+      if (original->layer()) {
+        original->layer()->SetOpacity(ember_floating_source_original_opacity_);
+        if (ember_floating_source_created_layer_) {
+          original->DestroyLayer();
+        }
+      }
+    }
+    ember_floating_source_view_.reset();
+    ember_floating_source_created_layer_ = false;
+    ember_floating_source_original_opacity_ = 1.f;
+  }
+  if (ember_floating_tab_widget_) {
+    ember_floating_tab_widget_->CloseNow();
+    ember_floating_tab_widget_.reset();
+  }
+}
