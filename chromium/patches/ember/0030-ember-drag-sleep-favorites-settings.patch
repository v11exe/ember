+  }
+  favorites_notify_pending_ = true;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&AppearanceHandler::NotifyEmberFavoritesChanged,
+                                weak_ptr_factory_.GetWeakPtr()));
+}
+
+void AppearanceHandler::BookmarkModelBeingDeleted() {
+  bookmark_model_observation_.Reset();
