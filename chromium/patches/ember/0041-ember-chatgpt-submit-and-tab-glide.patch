+  void Layout(PassKey) override {
+    LayoutSuperclass<views::ScrollView>(this);
+    const int maximum = MaximumOffset();
+    target_ = std::clamp(target_, 0.0, static_cast<double>(maximum));
+    if (CurrentOffset().x() > maximum) {
+      ScrollToOffset(gfx::PointF(maximum, 0));
+    }
+  }
+
+  void ScrollRectToVisible(const gfx::Rect& rect) override {
+    views::ScrollView::ScrollRectToVisible(rect);
+    target_ = CurrentOffset().x();
+    timer_.Stop();
+  }
+
+ private:
+  int MaximumOffset() const {
+    return contents() ? std::max(0, contents()->width() - GetVisibleRect().width())
+                      : 0;
+  }
+
+  void Animate() {
+    const base::TimeTicks now = base::TimeTicks::Now();
+    const double elapsed =
+        std::clamp((now - last_tick_).InMillisecondsF(), 0.0, 64.0);
+    last_tick_ = now;
+    const double current = CurrentOffset().x();
+    const double fraction = 1.0 - std::pow(0.76, elapsed / 16.667);
+    const double next = std::clamp(current + (target_ - current) * fraction,
+                                   0.0, static_cast<double>(MaximumOffset()));
+    if (std::abs(target_ - next) < 0.5) {
+      ScrollToOffset(gfx::PointF(target_, 0));
+      timer_.Stop();
+      return;
+    }
+    ScrollToOffset(gfx::PointF(next, 0));
+  }
+
+  base::RepeatingTimer timer_;
+  base::TimeTicks last_tick_;
+  double target_ = 0;
 };
 
