+void BrowserView::DocumentOnLoadCompletedInPrimaryMainFrame() {
+  if (!ember_chatgpt_bang_prompt_.empty()) {
+    // ChatGPT may rewrite ?q= into a second document. Allow that navigation
+    // to settle before installing the one-shot composer check.
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&BrowserView::MaybeInjectEmberChatGPTBang,
+                       weak_ptr_factory_.GetWeakPtr()),
+        base::Milliseconds(450));
+  }
+}
+
+void BrowserView::ArmEmberChatGPTBang(const GURL& target) {
+  ember_chatgpt_bang_prompt_.clear();
+  std::string prompt;
+  if (!target.SchemeIs("https") || target.host() != "chatgpt.com" ||
+      target.path() != "/" ||
+      !net::GetValueForKeyInQuery(target, "q", &prompt) || prompt.empty() ||
+      prompt.size() > 8192) {
+    return;
+  }
+  ember_chatgpt_bang_prompt_ = std::move(prompt);
+  ember_chatgpt_bang_started_ = base::TimeTicks::Now();
+}
+
+void BrowserView::MaybeInjectEmberChatGPTBang() {
+  if (ember_chatgpt_bang_prompt_.empty()) {
+    return;
+  }
+  if (base::TimeTicks::Now() - ember_chatgpt_bang_started_ >
+      base::Seconds(15)) {
+    ember_chatgpt_bang_prompt_.clear();
+    return;
+  }
+  content::WebContents* contents = GetActiveWebContents();
+  if (!contents || !contents->GetLastCommittedURL().SchemeIs("https") ||
+      contents->GetLastCommittedURL().host() != "chatgpt.com") {
+    return;
+  }
+  const std::optional<std::string> prompt_json =
+      base::WriteJson(base::Value(ember_chatgpt_bang_prompt_));
+  if (!prompt_json) {
+    ember_chatgpt_bang_prompt_.clear();
+    return;
+  }
+  const std::string script = "(() => { const expected = " + *prompt_json + R"JS(;
+    if (location.hostname !== 'chatgpt.com' ||
+        window.__emberChatGPTBangPrompt === expected) return;
+    window.__emberChatGPTBangPrompt = expected;
+    const visible = element => !!element && !!element.getClientRects().length;
+    const textOf = element =>
+        (element?.value ?? element?.innerText ?? element?.textContent ?? '').trim();
+    let matchedSince = 0;
+    const timer = setInterval(() => {
+      if (location.hostname !== 'chatgpt.com') {
+        clearInterval(timer);
+        return;
+      }
+      if ([...document.querySelectorAll('[data-message-author-role="user"]')]
+              .some(message => textOf(message) === expected)) {
+        clearInterval(timer);
+        return;
+      }
+      const composers = [...document.querySelectorAll(
+          '#prompt-textarea, [data-testid="prompt-textarea"], ' +
+          '[contenteditable="true"][role="textbox"], textarea')]
+          .filter(visible);
+      const composer = composers.find(element => textOf(element) === expected);
+      if (!composer) {
+        if (composers.some(element => textOf(element))) clearInterval(timer);
+        return;
+      }
+      const form = composer.closest('form');
+      const selector = 'button[data-testid="send-button"], ' +
+          'button[aria-label="Send prompt"], ' +
+          'button[aria-label="Send message"], button[type="submit"]';
+      const send = [...(form ?? document).querySelectorAll(selector)]
+          .filter(visible)
+          .find(button => !button.disabled &&
+              button.getAttribute('aria-disabled') !== 'true' &&
+              (button.matches('[data-testid="send-button"], ' +
+                  '[aria-label="Send prompt"], [aria-label="Send message"]') ||
+               (form && button.type === 'submit')));
+      if (!send) return;
+      if (!matchedSince) matchedSince = Date.now();
+      if (Date.now() - matchedSince < 300) return;
+      clearInterval(timer);
+      send.click();
+    }, 150);
+    setTimeout(() => clearInterval(timer), 15000);
+  })();)JS";
+  contents->GetPrimaryMainFrame()->ExecuteJavaScriptInIsolatedWorld(
+      base::UTF8ToUTF16(script), base::BindOnce([](base::Value) {}),
+      ISOLATED_WORLD_ID_CHROME_INTERNAL);
+}
