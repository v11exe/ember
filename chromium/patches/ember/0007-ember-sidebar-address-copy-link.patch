+class EmberSidebarCopyButton : public views::LabelButton {
+ public:
+  explicit EmberSidebarCopyButton(views::Button::PressedCallback callback)
+      : views::LabelButton(std::move(callback), std::u16string()),
+        transition_(kEmberSidebarTransitionDuration,
+                    gfx::LinearAnimation::kDefaultFrameRate,
+                    this) {}
+
+  EmberSidebarCopyButton(const EmberSidebarCopyButton&) = delete;
+  EmberSidebarCopyButton& operator=(const EmberSidebarCopyButton&) = delete;
+  ~EmberSidebarCopyButton() override = default;
+
+ protected:
+  void StateChanged(ButtonState old_state) override {
+    views::LabelButton::StateChanged(old_state);
+    StartVisualTransition();
+  }
+
+  void PaintButtonContents(gfx::Canvas* canvas) override {
+    const float button_width = width() * current_button_scale_;
+    const float button_height = height() * current_button_scale_;
+    const gfx::RectF button_bounds(
+        (width() - button_width) / 2.0f,
+        (height() - button_height) / 2.0f,
+        button_width, button_height);
+
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setStyle(cc::PaintFlags::kFill_Style);
+    flags.setColor(SkColorSetARGB(current_fill_alpha_, 0xFF, 0xFF, 0xFF));
+    canvas->DrawRoundRect(button_bounds,
+                          6.0f * current_button_scale_, flags);
+
+    const float glyph_scale =
+        current_button_scale_ * current_glyph_scale_;
+    const float glyph_width = kEmberSidebarCopyGlyphWidth * glyph_scale;
+    const float glyph_height = kEmberSidebarCopyGlyphHeight * glyph_scale;
+    const float x = (width() - glyph_width) / 2.0f;
+    const float y = (height() - glyph_height) / 2.0f;
+    const float scale_x = glyph_width / kEmberSidebarCopyGlyphWidth;
+    const float scale_y = glyph_height / kEmberSidebarCopyGlyphHeight;
+
+    SkPathBuilder glyph;
+    glyph.moveTo(x + 4.6f * scale_x, y + 1.5f * scale_y);
+    glyph.lineTo(x + 2.4f * scale_x, y + 1.5f * scale_y);
+    glyph.cubicTo(x + 0.9f * scale_x, y + 1.5f * scale_y,
+                  x + 0.4f * scale_x, y + 2.6f * scale_y,
+                  x + 0.4f * scale_x, y + 3.5f * scale_y);
+    glyph.cubicTo(x + 0.4f * scale_x, y + 4.4f * scale_y,
+                  x + 0.9f * scale_x, y + 5.5f * scale_y,
+                  x + 2.4f * scale_x, y + 5.5f * scale_y);
+    glyph.lineTo(x + 4.6f * scale_x, y + 5.5f * scale_y);
+    glyph.moveTo(x + 7.4f * scale_x, y + 5.5f * scale_y);
+    glyph.lineTo(x + 9.6f * scale_x, y + 5.5f * scale_y);
+    glyph.cubicTo(x + 11.1f * scale_x, y + 5.5f * scale_y,
+                  x + 11.6f * scale_x, y + 4.4f * scale_y,
+                  x + 11.6f * scale_x, y + 3.5f * scale_y);
+    glyph.cubicTo(x + 11.6f * scale_x, y + 2.6f * scale_y,
+                  x + 11.1f * scale_x, y + 1.5f * scale_y,
+                  x + 9.6f * scale_x, y + 1.5f * scale_y);
+    glyph.lineTo(x + 7.4f * scale_x, y + 1.5f * scale_y);
+    glyph.moveTo(x + 4.3f * scale_x, y + 3.5f * scale_y);
+    glyph.lineTo(x + 7.7f * scale_x, y + 3.5f * scale_y);
+
+    flags.setStyle(cc::PaintFlags::kStroke_Style);
+    flags.setStrokeWidth(1.15f * glyph_scale);
+    flags.setStrokeCap(cc::PaintFlags::kRound_Cap);
+    flags.setColor(
+        SkColorSetARGB(current_glyph_alpha_, 0xFF, 0xFF, 0xFF));
+    canvas->DrawPath(glyph.detach(), flags);
+  }
+
+  void AnimationProgressed(const gfx::Animation* animation) override {
+    if (animation != &transition_) {
+      views::LabelButton::AnimationProgressed(animation);
+      return;
+    }
+    ApplyTransition(animation->GetCurrentValue());
+  }
+
+  void AnimationEnded(const gfx::Animation* animation) override {
+    if (animation == &transition_) {
+      ApplyTransition(1.0);
+    }
+  }
+
+ private:
+  void StartVisualTransition() {
+    transition_.Stop();
+    start_fill_alpha_ = current_fill_alpha_;
+    start_button_scale_ = current_button_scale_;
+    start_glyph_scale_ = current_glyph_scale_;
+    start_glyph_alpha_ = current_glyph_alpha_;
+    const bool hovered =
+        GetState() == STATE_HOVERED || GetState() == STATE_PRESSED;
+    target_fill_alpha_ = hovered ? kEmberSidebarCopyHoverFillAlpha : 0;
+    target_button_scale_ =
+        GetState() == STATE_PRESSED ? kEmberSidebarCopyPressedScale : 1.0f;
+    target_glyph_scale_ =
+        GetState() == STATE_PRESSED
+            ? kEmberSidebarCopyPressedGlyphScale
+            : (hovered ? kEmberSidebarCopyHoverGlyphScale : 1.0f);
+    target_glyph_alpha_ =
+        hovered ? 0xFF : kEmberSidebarCopyRestingGlyphAlpha;
+    if (gfx::Animation::PrefersReducedMotion()) {
+      ApplyTransition(1.0);
+      return;
+    }
+    transition_.Start();
+  }
+
+  void ApplyTransition(double value) {
+    static const auto ease = gfx::CubicBezier(0.2, 0.8, 0.2, 1.0);
+    const double eased_value = ease.Solve(value);
+    current_fill_alpha_ = gfx::Tween::IntValueBetween(
+        eased_value, start_fill_alpha_, target_fill_alpha_);
+    current_button_scale_ = gfx::Tween::FloatValueBetween(
+        eased_value, start_button_scale_, target_button_scale_);
+    current_glyph_scale_ = gfx::Tween::FloatValueBetween(
+        eased_value, start_glyph_scale_, target_glyph_scale_);
+    current_glyph_alpha_ = gfx::Tween::IntValueBetween(
+        eased_value, start_glyph_alpha_, target_glyph_alpha_);
+    SchedulePaint();
+  }
+
+  int current_fill_alpha_ = 0;
+  float current_button_scale_ = 1.0f;
+  float current_glyph_scale_ = 1.0f;
+  int current_glyph_alpha_ = kEmberSidebarCopyRestingGlyphAlpha;
+  int start_fill_alpha_ = current_fill_alpha_;
+  float start_button_scale_ = current_button_scale_;
+  float start_glyph_scale_ = current_glyph_scale_;
+  int start_glyph_alpha_ = current_glyph_alpha_;
+  int target_fill_alpha_ = current_fill_alpha_;
+  float target_button_scale_ = current_button_scale_;
+  float target_glyph_scale_ = current_glyph_scale_;
+  int target_glyph_alpha_ = current_glyph_alpha_;
+  gfx::LinearAnimation transition_;
+};
