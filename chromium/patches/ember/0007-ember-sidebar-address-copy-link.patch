+constexpr int kEmberSidebarAddressRestingFillAlpha = 0x13;
+constexpr int kEmberSidebarAddressRestingBorderAlpha = 0x06;
+constexpr int kEmberSidebarAddressHoverFillAlpha = 0x21;
+constexpr int kEmberSidebarAddressFocusFillAlpha = 0x2E;
+constexpr int kEmberSidebarAddressFocusBorderAlpha = 0x0E;
+constexpr int kEmberSidebarCopyWidth = 26;
