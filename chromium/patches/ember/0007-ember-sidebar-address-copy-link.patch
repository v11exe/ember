+void BrowserView::UpdateEmberSidebar() {
+  if (!ember_sidebar_address_ || !ember_sidebar_copy_link_) {
+    return;
+  }
+
+  content::WebContents* contents = GetActiveWebContents();
+  const GURL url = contents ? contents->GetVisibleURL() : GURL();
+  const std::u16string display_url =
+      url.is_empty() ? l10n_util::GetStringUTF16(IDS_NEW_TAB)
+                     : url_formatter::FormatUrl(url);
+  ember_sidebar_address_->SetText(display_url);
+  ember_sidebar_address_->SetTooltipText(display_url);
+  ember_sidebar_copy_link_->SetEnabled(url.is_valid() && !url.is_empty());
+  ember_sidebar_copy_feedback_timer_.Stop();
+  ResetEmberSidebarCopyFeedback();
+}
+
+void BrowserView::CopyEmberSidebarLink() {
+  content::WebContents* contents = GetActiveWebContents();
+  const GURL url = contents ? contents->GetVisibleURL() : GURL();
+  if (!url.is_valid() || url.is_empty() || !ember_sidebar_copy_link_) {
+    return;
+  }
+
+  ui::ScopedClipboardWriter(ui::ClipboardBuffer::kCopyPaste)
+      .WriteText(base::UTF8ToUTF16(url.spec()));
+  ember_sidebar_copy_link_->SetText(u"Copied");
+  ember_sidebar_copy_link_->SetTooltipText(u"Link copied");
+  ember_sidebar_copy_link_->GetViewAccessibility().AnnounceText(u"Link copied");
+  ember_sidebar_copy_feedback_timer_.Start(
+      FROM_HERE, base::Milliseconds(1200),
+      base::BindOnce(&BrowserView::ResetEmberSidebarCopyFeedback,
+                     weak_ptr_factory_.GetWeakPtr()));
+}
+
+void BrowserView::ResetEmberSidebarCopyFeedback() {
+  if (!ember_sidebar_copy_link_) {
+    return;
+  }
+  ember_sidebar_copy_link_->SetText(u"Copy");
+  ember_sidebar_copy_link_->SetTooltipText(u"Copy link");
+}
