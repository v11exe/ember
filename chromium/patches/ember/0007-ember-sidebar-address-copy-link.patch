+constexpr base::TimeDelta kEmberSidebarTransitionDuration =
+    base::Milliseconds(130);
+
+std::u16string FormatEmberSidebarUrl(const GURL& url) {
+  std::string display_url = url.spec();
+  size_t scheme_length = 0;
+  if (base::StartsWith(display_url, "http://",
+                       base::CompareCase::INSENSITIVE_ASCII)) {
+    scheme_length = 7;
+  } else if (base::StartsWith(display_url, "https://",
+                              base::CompareCase::INSENSITIVE_ASCII)) {
+    scheme_length = 8;
+  }
+  if (scheme_length > 0) {
+    display_url.erase(0, scheme_length);
+    if (base::StartsWith(display_url, "www.",
+                         base::CompareCase::INSENSITIVE_ASCII)) {
+      display_url.erase(0, 4);
+    }
+  }
+  return base::UTF8ToUTF16(display_url);
+}
