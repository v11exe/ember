+class EmberSidebarAddressTextfield : public views::Textfield {
+ public:
+  EmberSidebarAddressTextfield(
+      base::RepeatingClosure focus_callback,
+      base::RepeatingClosure blur_callback,
+      base::RepeatingCallback<void(std::u16string)> submit_callback,
+      base::RepeatingClosure cancel_callback)
+      : focus_callback_(std::move(focus_callback)),
+        blur_callback_(std::move(blur_callback)),
+        submit_callback_(std::move(submit_callback)),
+        cancel_callback_(std::move(cancel_callback)) {}
+
+  EmberSidebarAddressTextfield(const EmberSidebarAddressTextfield&) = delete;
+  EmberSidebarAddressTextfield& operator=(
+      const EmberSidebarAddressTextfield&) = delete;
+  ~EmberSidebarAddressTextfield() override = default;
+
+ protected:
+  void OnFocus() override {
+    views::Textfield::OnFocus();
+    focus_callback_.Run();
+  }
+
+  void OnBlur() override {
+    views::Textfield::OnBlur();
+    blur_callback_.Run();
+  }
+
+  bool PreHandleKeyPressed(const ui::KeyEvent& event) override {
+    if (event.key_code() == ui::VKEY_RETURN) {
+      submit_callback_.Run(std::u16string(GetText()));
+      return true;
+    }
+    if (event.key_code() == ui::VKEY_ESCAPE) {
+      cancel_callback_.Run();
+      return true;
+    }
+    return views::Textfield::PreHandleKeyPressed(event);
+  }
+
+ private:
+  base::RepeatingClosure focus_callback_;
+  base::RepeatingClosure blur_callback_;
+  base::RepeatingCallback<void(std::u16string)> submit_callback_;
+  base::RepeatingClosure cancel_callback_;
+};
