+class EmberSidebarAddressRow : public views::View,
+                               public gfx::AnimationDelegate {
+ public:
+  EmberSidebarAddressRow()
+      : transition_(kEmberSidebarTransitionDuration,
+                    gfx::LinearAnimation::kDefaultFrameRate,
+                    this) {
+    SetNotifyEnterExitOnChild(true);
+  }
+
+  EmberSidebarAddressRow(const EmberSidebarAddressRow&) = delete;
+  EmberSidebarAddressRow& operator=(const EmberSidebarAddressRow&) = delete;
+  ~EmberSidebarAddressRow() override = default;
+
+  void SetAddressFocused(bool focused) {
+    if (focused_ == focused) {
+      return;
+    }
+    focused_ = focused;
+    StartVisualTransition();
+  }
+
+ protected:
+  void OnMouseEntered(const ui::MouseEvent& event) override {
+    views::View::OnMouseEntered(event);
+    hovered_ = true;
+    StartVisualTransition();
+  }
+
+  void OnMouseExited(const ui::MouseEvent& event) override {
+    views::View::OnMouseExited(event);
+    hovered_ = false;
+    StartVisualTransition();
+  }
+
+  void OnPaintBackground(gfx::Canvas* canvas) override {
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setStyle(cc::PaintFlags::kFill_Style);
+    flags.setColor(SkColorSetARGB(current_fill_alpha_, 0xFF, 0xFF, 0xFF));
+    canvas->DrawRoundRect(gfx::RectF(GetLocalBounds()),
+                          kEmberSidebarAddressRadius, flags);
+
+    gfx::RectF border_bounds(GetLocalBounds());
+    border_bounds.Inset(0.5f);
+    flags.setStyle(cc::PaintFlags::kStroke_Style);
+    flags.setStrokeWidth(1.0f);
+    flags.setColor(
+        SkColorSetARGB(current_border_alpha_, 0xFF, 0xFF, 0xFF));
+    canvas->DrawRoundRect(border_bounds,
+                          kEmberSidebarAddressRadius - 0.5f, flags);
+  }
+
+  void AnimationProgressed(const gfx::Animation* animation) override {
+    if (animation == &transition_) {
+      ApplyTransition(animation->GetCurrentValue());
+    }
+  }
+
+  void AnimationEnded(const gfx::Animation* animation) override {
+    if (animation == &transition_) {
+      ApplyTransition(1.0);
+    }
+  }
+
+ private:
+  int TargetFillAlpha() const {
+    if (focused_) {
+      return kEmberSidebarAddressFocusFillAlpha;
+    }
+    return hovered_ ? kEmberSidebarAddressHoverFillAlpha
+                    : kEmberSidebarAddressRestingFillAlpha;
+  }
+
+  int TargetBorderAlpha() const {
+    return focused_ ? kEmberSidebarAddressFocusBorderAlpha
+                    : kEmberSidebarAddressRestingBorderAlpha;
+  }
+
+  void StartVisualTransition() {
+    transition_.Stop();
+    start_fill_alpha_ = current_fill_alpha_;
+    start_border_alpha_ = current_border_alpha_;
+    target_fill_alpha_ = TargetFillAlpha();
+    target_border_alpha_ = TargetBorderAlpha();
+    if (start_fill_alpha_ == target_fill_alpha_ &&
+        start_border_alpha_ == target_border_alpha_) {
+      return;
+    }
+    if (gfx::Animation::PrefersReducedMotion()) {
+      ApplyTransition(1.0);
+      return;
+    }
+    transition_.Start();
+  }
+
+  void ApplyTransition(double value) {
+    static const auto ease = gfx::CubicBezier(0.25, 0.1, 0.25, 1.0);
+    const double eased_value = ease.Solve(value);
+    current_fill_alpha_ = gfx::Tween::IntValueBetween(
+        eased_value, start_fill_alpha_, target_fill_alpha_);
+    current_border_alpha_ = gfx::Tween::IntValueBetween(
+        eased_value, start_border_alpha_, target_border_alpha_);
+    SchedulePaint();
+  }
+
+  bool hovered_ = false;
+  bool focused_ = false;
+  int current_fill_alpha_ = kEmberSidebarAddressRestingFillAlpha;
+  int current_border_alpha_ = kEmberSidebarAddressRestingBorderAlpha;
+  int start_fill_alpha_ = current_fill_alpha_;
+  int start_border_alpha_ = current_border_alpha_;
+  int target_fill_alpha_ = current_fill_alpha_;
+  int target_border_alpha_ = current_border_alpha_;
+  gfx::LinearAnimation transition_;
+};
