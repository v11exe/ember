+void BrowserView::UpdateEmberSidebar() {
+  if (!ember_sidebar_address_ || !ember_sidebar_copy_link_) {
+    return;
+  }
+
+  content::WebContents* contents = GetActiveWebContents();
+  const GURL url = contents ? contents->GetVisibleURL() : GURL();
+  if (!ember_sidebar_editing_) {
+    const std::u16string display_url =
+        url.is_empty() ? l10n_util::GetStringUTF16(IDS_NEW_TAB)
+                       : FormatEmberSidebarUrl(url);
+    ember_sidebar_address_->SetText(display_url);
+    ember_sidebar_address_->SetTooltipText(
+        url.is_empty() ? display_url : base::UTF8ToUTF16(url.spec()));
+  }
+  ember_sidebar_copy_link_->SetEnabled(url.is_valid() && !url.is_empty());
+  ember_sidebar_copy_feedback_timer_.Stop();
+  ResetEmberSidebarCopyFeedback();
+}
+
+void BrowserView::OnEmberSidebarAddressFocused() {
+  if (!ember_sidebar_address_ || !ember_sidebar_address_row_) {
+    return;
+  }
+
+  ember_sidebar_editing_ = true;
+  static_cast<EmberSidebarAddressRow*>(ember_sidebar_address_row_.get())
+      ->SetAddressFocused(true);
+  content::WebContents* contents = GetActiveWebContents();
+  const GURL url = contents ? contents->GetVisibleURL() : GURL();
+  ember_sidebar_address_->SetText(
+      url.is_empty() ? l10n_util::GetStringUTF16(IDS_NEW_TAB)
+                     : base::UTF8ToUTF16(url.spec()));
+  ember_sidebar_address_->SelectAll(false);
+}
+
+void BrowserView::OnEmberSidebarAddressBlurred() {
+  ember_sidebar_editing_ = false;
+  if (ember_sidebar_address_row_) {
+    static_cast<EmberSidebarAddressRow*>(ember_sidebar_address_row_.get())
+        ->SetAddressFocused(false);
+  }
+  UpdateEmberSidebar();
+}
+
+void BrowserView::SubmitEmberSidebarAddress(std::u16string text) {
+  LocationBar* location_bar = GetLocationBar();
+  if (!location_bar || text.empty()) {
+    return;
+  }
+  OmniboxView* omnibox_view = location_bar->GetOmniboxView();
+  OmniboxController* omnibox_controller =
+      location_bar->GetOmniboxController();
+  if (!omnibox_view || !omnibox_controller) {
+    return;
+  }
+  omnibox_view->SetUserText(text, false);
+  omnibox_controller->edit_model()->OpenCurrentSelection(
+      base::TimeTicks(), WindowOpenDisposition::CURRENT_TAB,
+      /*via_keyboard=*/true);
+  if (views::FocusManager* focus_manager = GetFocusManager()) {
+    focus_manager->ClearFocus();
+  }
+}
+
+void BrowserView::CancelEmberSidebarAddressEdit() {
+  if (!ember_sidebar_address_) {
+    return;
+  }
+  content::WebContents* contents = GetActiveWebContents();
+  const GURL url = contents ? contents->GetVisibleURL() : GURL();
+  ember_sidebar_address_->SetText(
+      url.is_empty() ? l10n_util::GetStringUTF16(IDS_NEW_TAB)
+                     : base::UTF8ToUTF16(url.spec()));
+  if (views::FocusManager* focus_manager = GetFocusManager()) {
+    focus_manager->ClearFocus();
+  }
+}
+
+void BrowserView::CopyEmberSidebarLink() {
+  content::WebContents* contents = GetActiveWebContents();
+  const GURL url = contents ? contents->GetVisibleURL() : GURL();
+  if (!url.is_valid() || url.is_empty() || !ember_sidebar_copy_link_) {
+    return;
+  }
+
+  ui::ScopedClipboardWriter(ui::ClipboardBuffer::kCopyPaste)
+      .WriteText(base::UTF8ToUTF16(url.spec()));
+  ShowEmberSidebarCopyToast();
+  ember_sidebar_copy_link_->GetViewAccessibility().AnnounceText(u"Copied");
+  ember_sidebar_copy_feedback_timer_.Start(
+      FROM_HERE, base::Milliseconds(1200),
+      base::BindOnce(&BrowserView::ResetEmberSidebarCopyFeedback,
+                     weak_ptr_factory_.GetWeakPtr()));
+}
+
+void BrowserView::ShowEmberSidebarCopyToast() {
+  if (!GetWidget() || !ember_sidebar_ || !ember_sidebar_address_row_) {
+    return;
+  }
+
+  ember_sidebar_copy_toast_.reset();
+  gfx::Rect address_bounds = ember_sidebar_address_row_->GetBoundsInScreen();
+  const gfx::Rect sidebar_bounds = ember_sidebar_->GetBoundsInScreen();
+  views::Widget::InitParams params(
+      views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+      views::Widget::InitParams::TYPE_POPUP);
+  params.name = "EmberSidebarCopyToast";
+  params.parent = GetWidget()->GetNativeView();
+  params.opacity = views::Widget::InitParams::WindowOpacity::kTranslucent;
+  params.shadow_type = views::Widget::InitParams::ShadowType::kNone;
+  params.activatable = views::Widget::InitParams::Activatable::kNo;
+  params.bounds = gfx::Rect(
+      sidebar_bounds.right() + 8, address_bounds.y() + 1,
+      kEmberSidebarCopyToastWidth, kEmberSidebarCopyToastHeight);
+
+  auto toast = std::make_unique<views::Widget>();
+  toast->Init(std::move(params));
+  auto toast_contents = std::make_unique<views::View>();
+  toast_contents->SetPreferredSize(
+      gfx::Size(kEmberSidebarCopyToastWidth, kEmberSidebarCopyToastHeight));
+  toast_contents->SetBackground(views::CreateRoundedRectBackground(
+      SkColorSetARGB(0xFA, 0x0A, 0x2B, 0x1F), 15));
+  toast_contents->SetBorder(views::CreateRoundedRectBorder(
+      1, 15, SkColorSetARGB(0x7A, 0x5C, 0xF2, 0xA1)));
+  auto* toast_layout =
+      toast_contents->SetLayoutManager(std::make_unique<views::BoxLayout>(
+          views::BoxLayout::Orientation::kHorizontal,
+          gfx::Insets::VH(0, 10), 6));
+  toast_layout->set_cross_axis_alignment(
+      views::BoxLayout::CrossAxisAlignment::kCenter);
+
+  auto* mark =
+      toast_contents->AddChildView(std::make_unique<views::Label>(u"\u2713"));
+  mark->SetPreferredSize(gfx::Size(14, 14));
+  mark->SetHorizontalAlignment(gfx::ALIGN_CENTER);
+  mark->SetEnabledColor(SkColorSetRGB(0x9D, 0xFF, 0xC5));
+  mark->SetFontList(gfx::FontList("Segoe UI, Bold 10px"));
+  mark->SetBorder(views::CreateRoundedRectBorder(
+      1, 7, SkColorSetARGB(0x94, 0x83, 0xFF, 0xBE)));
+
+  auto* label = toast_contents->AddChildView(
+      std::make_unique<views::Label>(u"Link copied"));
+  label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  label->SetEnabledColor(SkColorSetRGB(0xEC, 0xFF, 0xF4));
+  label->SetFontList(gfx::FontList("Segoe UI, Semi-Bold 11px"));
+
+  toast->SetContentsView(std::move(toast_contents));
+  toast->ShowInactive();
+  ember_sidebar_copy_toast_ = std::move(toast);
+}
+
+void BrowserView::ResetEmberSidebarCopyFeedback() {
+  ember_sidebar_copy_toast_.reset();
+}
