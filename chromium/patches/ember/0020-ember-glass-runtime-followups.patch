+
+constexpr float kBubbleCornerRadius = 14.0f;
+
+class EmberGlassBitmapBackground : public views::Background {
+ public:
+  explicit EmberGlassBitmapBackground(SkBitmap bitmap)
+      : bitmap_(std::move(bitmap)) {}
+
+  void Paint(gfx::Canvas* canvas, views::View* view) const override {
+    cc::PaintCanvas* paint_canvas = canvas->sk_canvas();
+    const SkRect bounds = gfx::RectToSkRect(view->GetLocalBounds());
+    paint_canvas->save();
+    paint_canvas->clipRRect(
+        SkRRect::MakeRectXY(bounds, kBubbleCornerRadius, kBubbleCornerRadius),
+        true);
+    paint_canvas->drawImageRect(
+        cc::PaintImage::CreateFromBitmap(bitmap_),
+        SkRect::MakeWH(bitmap_.width(), bitmap_.height()), bounds,
+        SkSamplingOptions(SkFilterMode::kLinear), nullptr,
+        SkCanvas::kStrict_SrcRectConstraint);
+    paint_canvas->restore();
+  }
+
+ private:
+  const SkBitmap bitmap_;
+};
+
+void OnBubbleBackdropCaptured(std::unique_ptr<views::ViewTracker> tracker,
+                              gfx::Rect source_rect,
+                              SkBitmap bitmap) {
+  views::View* surface = tracker->view();
+  if (!surface || bitmap.empty()) {
+    return;
+  }
+  source_rect.set_x(std::clamp(source_rect.x(), 0,
+                               std::max(0, bitmap.width() - source_rect.width())));
+  source_rect.set_y(std::clamp(source_rect.y(), 0,
+                               std::max(0, bitmap.height() - source_rect.height())));
+  source_rect.set_width(std::min(source_rect.width(), bitmap.width()));
+  source_rect.set_height(std::min(source_rect.height(), bitmap.height()));
+  EmberGlassMaterial material;
+  const EmberGlassPanel* panel = material.RenderPanel(
+      bitmap, source_rect, 1, EmberGlassPreset::kPopover);
+  if (!panel) {
+    return;
+  }
+  surface->SetBackground(
+      std::make_unique<EmberGlassBitmapBackground>(panel->bitmap));
+  surface->SchedulePaint();
+}
+
+}  // namespace
+
+void ConfigureEmberGlassBubble(views::View* surface,
+                               views::BubbleDialogDelegate* bubble) {
+  CHECK(surface);
+  CHECK(bubble);
+  bubble->SetBackgroundColor(SK_ColorTRANSPARENT);
+  surface->SetPaintToLayer();
+  surface->layer()->SetFillsBoundsOpaquely(false);
+  surface->layer()->SetRoundedCornerRadius(
+      gfx::RoundedCornersF(kBubbleCornerRadius));
+  surface->layer()->SetIsFastRoundedCorner(true);
+  surface->SetBackground(views::CreateRoundedRectBackground(
+      SkColorSetARGB(104, 28, 31, 38), kBubbleCornerRadius, 1));
+  surface->SetBorder(views::CreateRoundedRectBorder(
+      1, kBubbleCornerRadius, SkColorSetARGB(62, 255, 255, 255)));
+}
+
+void CaptureEmberGlassBubbleBackdrop(BrowserView* browser_view,
+                                     views::View* surface) {
+  content::WebContents* web_contents =
+      browser_view ? browser_view->GetActiveWebContents() : nullptr;
+  content::RenderFrameHost* frame =
+      web_contents ? web_contents->GetPrimaryMainFrame() : nullptr;
+  content::RenderWidgetHostView* renderer_view = frame ? frame->GetView() : nullptr;
+  if (!renderer_view || !surface || surface->size().IsEmpty()) {
+    return;
+  }
+  const gfx::Rect renderer_bounds = renderer_view->GetViewBounds();
+  const gfx::Rect bubble_bounds = surface->GetBoundsInScreen();
+  const gfx::Vector2d offset =
+      bubble_bounds.origin() - renderer_bounds.origin();
+  gfx::Rect source_rect(offset.x(), offset.y(), bubble_bounds.width(),
+                        bubble_bounds.height());
+  auto ready = base::BindPostTask(
+      content::GetUIThreadTaskRunner({}),
+      base::BindOnce(&OnBubbleBackdropCaptured,
+                     std::make_unique<views::ViewTracker>(surface),
+                     source_rect));
+  renderer_view->CopyFromSurface(
+      gfx::Rect(), renderer_bounds.size(), base::Milliseconds(250),
+      base::BindOnce(
+          [](base::OnceCallback<void(SkBitmap)> callback,
+             const content::CopyFromSurfaceResult& result) {
+            std::move(callback).Run(result.has_value() ? result->bitmap
+                                                       : SkBitmap());
+          },
+          std::move(ready)));
+}
 
