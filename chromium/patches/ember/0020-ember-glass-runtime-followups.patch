+void EmberGlassOverlayController::HoverCtrlTabAtPoint(
+    const gfx::Point& panel_point) {
+  if (!switcher_viewport_ || ctrl_tab_entries_.empty() || ctrl_tab_closing_ ||
+      !switcher_viewport_->bounds().Contains(panel_point)) {
+    return;
+  }
+  const float strip_x = static_cast<float>(panel_point.x() -
+                                           switcher_viewport_->x()) -
+                          CurrentCtrlTabStripOffset();
+  const int card_stride = kSwitcherCardWidth + kSwitcherCardGap;
+  if (strip_x < 0.0f) {
+    return;
+  }
+  const size_t entry_index = static_cast<size_t>(strip_x / card_stride);
+  const float within_card = strip_x - entry_index * card_stride;
+  if (entry_index < ctrl_tab_entries_.size() &&
+      within_card < kSwitcherCardWidth) {
+    SelectCtrlTabCard(entry_index);
+  }
+}
