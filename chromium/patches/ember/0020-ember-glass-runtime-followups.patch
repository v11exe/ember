+void EmberGlassOverlayController::ActivateCtrlTabAtPoint(
+    const gfx::Point& panel_point) {
+  const size_t prior_selection = selected_ctrl_tab_index_;
+  HoverCtrlTabAtPoint(panel_point);
+  if (selected_ctrl_tab_index_ != prior_selection ||
+      (switcher_viewport_ &&
+       switcher_viewport_->bounds().Contains(panel_point))) {
+    CommitCtrlTab();
+  }
 }
 
