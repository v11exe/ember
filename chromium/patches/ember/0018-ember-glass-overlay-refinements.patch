+    preview_->SetImage(ui::ImageModel::FromImageSkia(cropped));
+    preview_->SetImageSize(
+        gfx::Size(kSwitcherCardWidth, kSwitcherPreviewHeight));
+  }
+
+  const size_t entry_index_;
+  std::u16string title_;
