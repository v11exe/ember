+      glyph.setAntiAlias(true);
+      glyph.setStyle(cc::PaintFlags::kStroke_Style);
+      glyph.setStrokeWidth(2);
+      glyph.setColor(SkColorSetARGB(0xDE, 0xFF, 0xFF, 0xFF));
+      canvas->DrawRoundRect(gfx::RectF((width() - 45) / 2.0f, 18, 45, 48), 5,
+                            glyph);
+      canvas->DrawLine(gfx::PointF((width() - 31) / 2.0f, 54),
+                       gfx::PointF((width() + 1) / 2.0f, 37), glyph);
+      canvas->DrawLine(gfx::PointF((width() + 1) / 2.0f, 37),
+                       gfx::PointF((width() + 31) / 2.0f, 54), glyph);
+    }
+    if (multiple_) {
+      const float opacity =
+          selected_ ? 1.0f
+                    : static_cast<float>(checkbox_animation_.GetCurrentValue());
+      if (opacity > 0) {
+        cc::PaintFlags box;
+        box.setAntiAlias(true);
+        box.setColor(
+            SkColorSetARGB(static_cast<uint8_t>(opacity * 222), 255, 255, 255));
+        box.setStyle(cc::PaintFlags::kStroke_Style);
+        box.setStrokeWidth(1.5f);
+        canvas->DrawRoundRect(gfx::RectF(width() - 20, 8, 16, 16), 3, box);
+        if (selected_) {
+          cc::PaintFlags tick;
+          tick.setAntiAlias(true);
+          tick.setColor(SK_ColorWHITE);
+          tick.setStyle(cc::PaintFlags::kStroke_Style);
+          tick.setStrokeWidth(2);
+          canvas->DrawLine(gfx::PointF(width() - 17, 16),
+                           gfx::PointF(width() - 13, 20), tick);
+          canvas->DrawLine(gfx::PointF(width() - 13, 20),
+                           gfx::PointF(width() - 7, 12), tick);
+        }
+      }
+    }
+  }
+
+ private:
+  void OnIconLoaded(gfx::Image image, const IconLoader::IconGroup&) {
+    if (!image.IsEmpty()) {
+      icon_loaded_ = true;
+      icon_->SetImage(ui::ImageModel::FromImageSkia(image.AsImageSkia()));
+      SchedulePaint();
+    }
+  }
+
+  raw_ptr<views::ImageView> icon_ = nullptr;
+  bool clipboard_image_ = false;
+  bool multiple_ = false;
+  bool icon_loaded_ = false;
+  bool selected_ = false;
+  gfx::SlideAnimation checkbox_animation_;
+  base::WeakPtrFactory<UploadTile> weak_ptr_factory_{this};
+};
+
+class UploadActionButton final : public views::LabelButton {
+ public:
+  UploadActionButton(PressedCallback callback, const std::u16string& text)
+      : views::LabelButton(std::move(callback), text) {
+    SetPreferredSize(gfx::Size(text == u"×" ? 36 : 150, 36));
+    SetBorder(views::CreateEmptyBorder(gfx::Insets()));
+    SetHorizontalAlignment(gfx::ALIGN_CENTER);
+    SetFocusBehavior(views::View::FocusBehavior::ALWAYS);
+    SetTextColor(STATE_NORMAL, SK_ColorWHITE);
+    SetTextColor(STATE_HOVERED, SK_ColorWHITE);
+    SetTextColor(STATE_PRESSED, SK_ColorWHITE);
+  }
+
+  void OnPaintBackground(gfx::Canvas* canvas) override {
+    const bool active =
+        GetState() == STATE_HOVERED || GetState() == STATE_PRESSED;
+    cc::PaintFlags fill;
+    fill.setAntiAlias(true);
+    fill.setColor(SkColorSetARGB(active ? 0x45 : 0x24, 0xFF, 0xFF, 0xFF));
+    canvas->DrawRoundRect(gfx::RectF(GetLocalBounds()), 8, fill);
+    cc::PaintFlags rim;
+    rim.setAntiAlias(true);
+    rim.setStyle(cc::PaintFlags::kStroke_Style);
+    rim.setStrokeWidth(1);
+    rim.setColor(SkColorSetARGB(active ? 0x62 : 0x38, 0xFF, 0xFF, 0xFF));
+    gfx::RectF border(GetLocalBounds());
+    border.Inset(0.5f);
+    canvas->DrawRoundRect(border, 7.5f, rim);
+  }
+};
