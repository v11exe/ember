+  ember_sidebar_motion_from_ = ember_sidebar_width_;
+  ember_sidebar_motion_to_ = open ? 168 : 8;
+  ember_sidebar_motion_started_ = base::TimeTicks::Now();
+  ember_sidebar_motion_timer_.Stop();
+  if (gfx::Animation::PrefersReducedMotion() || !GetWidget()) {
+    SetEmberSidebarWidth(ember_sidebar_motion_to_);
+    return;
+  }
+  ember_sidebar_motion_timer_.Start(
+      FROM_HERE, base::Milliseconds(16),
+      base::BindRepeating(&BrowserView::OnEmberSidebarMotionTick,
+                          weak_ptr_factory_.GetWeakPtr()));
+  OnEmberSidebarMotionTick();
