+void RememberEmberUploads(Profile* profile,
+                          const std::vector<ui::SelectedFileInfo>& files,
+                          const base::FilePath& temporary_file) {
+  if (!IsValidProfile(profile) || profile->IsOffTheRecord() || files.empty()) {
+    return;
+  }
+  PrefService* prefs = profile->GetPrefs();
+  if (!prefs->FindPreference(prefs::kEmberRecentUploads)) {
+    return;
+  }
+  base::ListValue recent;
+  for (const auto& file : files) {
+    if (file.file_path == temporary_file || !base::PathExists(file.file_path) ||
+        base::DirectoryExists(file.file_path)) {
+      continue;
+    }
+    const std::string path = file.file_path.AsUTF8Unsafe();
+    if (!path.empty() && !recent.contains(path)) {
+      recent.Append(path);
+    }
+  }
+  for (const auto& entry : prefs->GetList(prefs::kEmberRecentUploads)) {
+    if (!entry.is_string() || recent.size() >= 20) {
+      continue;
+    }
+    if (!recent.contains(entry.GetString())) {
+      recent.Append(entry.GetString());
+    }
+  }
+  prefs->SetList(prefs::kEmberRecentUploads, std::move(recent));
+}
