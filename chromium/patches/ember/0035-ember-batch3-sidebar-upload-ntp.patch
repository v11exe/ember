+
+  void OnPaintBackground(gfx::Canvas* canvas) override {
+    const bool active =
+        selected_ || GetState() == STATE_HOVERED || GetState() == STATE_PRESSED;
+    cc::PaintFlags fill;
+    fill.setAntiAlias(true);
+    fill.setColor(SkColorSetARGB(active ? 0x30 : 0x11, 0xFF, 0xFF, 0xFF));
+    canvas->DrawRoundRect(gfx::RectF(GetLocalBounds()), 11, fill);
+    if (active) {
+      cc::PaintFlags rim;
+      rim.setAntiAlias(true);
+      rim.setStyle(cc::PaintFlags::kStroke_Style);
+      rim.setStrokeWidth(1);
+      rim.setColor(SkColorSetARGB(0x4E, 0xFF, 0xFF, 0xFF));
+      gfx::RectF border(GetLocalBounds());
+      border.Inset(0.5f);
+      canvas->DrawRoundRect(border, 10.5f, rim);
+    }
