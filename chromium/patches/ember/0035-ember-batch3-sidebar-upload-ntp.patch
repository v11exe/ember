+    name->SetPreferredSize(gfx::Size(104, 19));
+    name->SetFontList(gfx::FontList("Inter, 12px"));
+    name->SetElideBehavior(gfx::ELIDE_MIDDLE);
+    name->SetEnabledColor(SkColorSetARGB(0xC8, 0xFF, 0xFF, 0xFF));
+    name->SetCanProcessEventsWithinSubtree(false);
+    GetViewAccessibility().SetName(std::u16string(name->GetText()));
+    if (!path.empty()) {
+      IconLoader::LoadIcon(path, IconLoader::LARGE, 1.0f,
