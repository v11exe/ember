+class UploadBubble final : public views::View {
+ public:
+  using SelectionCallback =
+      base::RepeatingCallback<void(std::vector<base::FilePath>, bool)>;
+
+  UploadBubble(bool multiple,
+               const std::u16string& origin,
+               const std::vector<base::FilePath>& clipboard_files,
+               bool clipboard_image,
+               const SkBitmap& clipboard_thumbnail,
+               const std::vector<base::FilePath>& recents,
+               const std::vector<base::FilePath>& downloads,
+               int width,
+               int height,
+               int columns,
+               SelectionCallback select,
+               base::RepeatingClosure show_all,
+               base::RepeatingClosure close)
+      : multiple_(multiple),
+        columns_(columns),
+        select_(std::move(select)),
+        show_all_(std::move(show_all)),
+        close_(std::move(close)) {
+    auto* layout = SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical,
+        gfx::Insets::TLBR(16, 18, 16, 18), 12));
+    SetPreferredSize(gfx::Size(width, height));
+
+    auto* header = AddChildView(std::make_unique<views::View>());
+    auto* header_layout =
+        header->SetLayoutManager(std::make_unique<views::BoxLayout>(
+            views::BoxLayout::Orientation::kHorizontal, gfx::Insets(), 9));
+    std::unique_ptr<views::LabelButton> show_all_button =
+        std::make_unique<UploadActionButton>(
+            base::BindRepeating(&UploadBubble::PrimaryAction,
+                                base::Unretained(this)),
+            u"Show all files");
+    primary_button_ = header->AddChildView(std::move(show_all_button));
+    primary_button_->GetViewAccessibility().SetName(
+        u"Show all files in native chooser");
+    auto* title = header->AddChildView(std::make_unique<views::Label>(
+        multiple ? u"Choose files" : u"Choose a file"));
+    title->SetFontList(gfx::FontList("Inter, Medium 14px"));
+    header_layout->SetFlexForView(title, 1);
+    std::unique_ptr<views::LabelButton> close_action =
+        std::make_unique<UploadActionButton>(
+            base::BindRepeating(&UploadBubble::Close, base::Unretained(this)),
+            u"×");
+    auto* close_button = header->AddChildView(std::move(close_action));
+    close_button->GetViewAccessibility().SetName(u"Cancel file selection");
+
+    if (!origin.empty()) {
+      auto* site = AddChildView(std::make_unique<views::Label>(origin));
+      site->SetEnabledColor(SkColorSetARGB(0xA0, 0xFF, 0xFF, 0xFF));
+      site->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    }
+    auto* scroll = AddChildView(std::make_unique<views::ScrollView>());
+    scroll->SetBackgroundColor(SK_ColorTRANSPARENT);
+    scroll->SetDrawOverflowIndicator(false);
+    scroll->SetHorizontalScrollBarMode(
+        views::ScrollView::ScrollBarMode::kDisabled);
+    scroll->SetVerticalScrollBar(std::make_unique<views::OverlayScrollBar>(
+        views::ScrollBar::Orientation::kVertical));
+    scroll->ClipHeightTo(0, std::max(150, height - 120));
+    layout->SetFlexForView(scroll, 1);
+    auto body = std::make_unique<views::View>();
+    body->SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical, gfx::Insets(), 11));
+    body_ = scroll->SetContents(std::move(body));
+    const size_t clipboard_count =
+        clipboard_files.size() + static_cast<size_t>(clipboard_image);
+    AddSectionHeadings(clipboard_count, downloads.size(), recents.size());
+    std::vector<TileSpec> tiles;
+    for (const auto& path : clipboard_files) {
+      tiles.push_back({path, false});
+    }
+    if (clipboard_image) {
+      tiles.push_back({base::FilePath(), true});
+    }
+    for (const auto& path : downloads) {
+      tiles.push_back({path, false});
+    }
+    for (const auto& path : recents) {
+      tiles.push_back({path, false});
+    }
+    if (tiles.empty()) {
+      auto* empty = body_->AddChildView(
+          std::make_unique<views::Label>(u"No recent files match this upload"));
+      empty->SetEnabledColor(SkColorSetARGB(0xA0, 0xFF, 0xFF, 0xFF));
+    } else {
+      AddGrid(tiles, clipboard_thumbnail);
+    }
+  }
+
+ private:
+  struct TileSpec {
+    base::FilePath path;
+    bool clipboard_image;
+  };
+
+  void AddSectionHeadings(size_t clipboard_count,
+                          size_t download_count,
+                          size_t recent_count) {
+    if (!clipboard_count && !download_count && !recent_count) {
+      return;
+    }
+    auto* headings = body_->AddChildView(std::make_unique<views::View>());
+    headings->SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kHorizontal, gfx::Insets(), kTileGap));
+    for (int column = 0; column < columns_; ++column) {
+      std::u16string text;
+      if (column == 0 && clipboard_count) {
+        text = u"CLIPBOARD";
+      } else if (static_cast<size_t>(column) == clipboard_count &&
+                 download_count) {
+        text = u"DOWNLOADED";
+      } else if (static_cast<size_t>(column) ==
+                     clipboard_count + download_count &&
+                 recent_count) {
+        text = u"RECENT UPLOADS";
+      }
+      auto* label =
+          headings->AddChildView(std::make_unique<views::Label>(text));
+      label->SetPreferredSize(gfx::Size(kTileWidth, 16));
+      label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+      label->SetEnabledColor(SkColorSetARGB(0xB0, 0xFF, 0xFF, 0xFF));
+      label->SetFontList(gfx::FontList("Inter, Medium 10px"));
+    }
+  }
+
+  void AddGrid(const std::vector<TileSpec>& tiles,
+               const SkBitmap& clipboard_thumbnail) {
+    views::View* row = nullptr;
+    for (size_t index = 0; index < tiles.size(); ++index) {
+      if (index % columns_ == 0) {
+        row = body_->AddChildView(std::make_unique<views::View>());
+        row->SetLayoutManager(std::make_unique<views::BoxLayout>(
+            views::BoxLayout::Orientation::kHorizontal, gfx::Insets(),
+            kTileGap));
+      }
+      AddTile(row, tiles[index], clipboard_thumbnail);
+    }
+  }
+
+  void AddTile(views::View* row,
+               const TileSpec& spec,
+               const SkBitmap& clipboard_thumbnail) {
+    auto tile = std::make_unique<UploadTile>(
+        spec.path, spec.clipboard_image, clipboard_thumbnail, multiple_,
+        base::BindRepeating(&UploadBubble::OnTile, base::Unretained(this),
+                            spec.path, spec.clipboard_image));
+    tile_views_.push_back({tile.get(), spec.path, spec.clipboard_image});
+    std::unique_ptr<views::View> tile_view = std::move(tile);
+    row->AddChildView(std::move(tile_view));
+  }
+
+  void OnTile(const base::FilePath& path,
+              bool clipboard_image,
+              const ui::Event& event) {
+    bool checkbox_click = false;
+    if (multiple_ && event.IsLocatedEvent()) {
+      const gfx::Point location = event.AsLocatedEvent()->location();
+      checkbox_click = location.x() >= kTileWidth - 30 && location.y() <= 34;
+    }
+    if (!multiple_ || (!selection_started_ && !checkbox_click)) {
+      select_.Run(path.empty() ? std::vector<base::FilePath>()
+                               : std::vector<base::FilePath>{path},
+                  clipboard_image);
+      return;
+    }
+    selection_started_ = true;
+    if (clipboard_image) {
+      selected_image_ = !selected_image_;
+    } else {
+      auto it = std::find(selected_paths_.begin(), selected_paths_.end(), path);
+      if (it == selected_paths_.end()) {
+        selected_paths_.push_back(path);
+      } else {
+        selected_paths_.erase(it);
+      }
+    }
+    for (const auto& tile : tile_views_) {
+      tile.view->SetSelected(
+          tile.clipboard_image
+              ? selected_image_
+              : std::find(selected_paths_.begin(), selected_paths_.end(),
+                          tile.path) != selected_paths_.end());
+    }
+    UpdatePrimaryButton();
+  }
+
+  void UpdatePrimaryButton() {
+    const size_t count =
+        selected_paths_.size() + static_cast<size_t>(selected_image_);
+    if (!count) {
+      primary_button_->SetText(u"Show all files");
+      primary_button_->GetViewAccessibility().SetName(
+          u"Show all files in native chooser");
+      return;
+    }
+    primary_button_->SetText(u"Upload " + base::NumberToString16(count) +
+                             (count == 1 ? u" item" : u" items"));
+    primary_button_->GetViewAccessibility().SetName(
+        std::u16string(primary_button_->GetText()));
+  }
+
+  void PrimaryAction(const ui::Event&) {
+    if (!selected_paths_.empty() || selected_image_) {
+      select_.Run(selected_paths_, selected_image_);
+    } else {
+      show_all_.Run();
+    }
+  }
+  void Close(const ui::Event&) { close_.Run(); }
+
+  struct TileRef {
+    raw_ptr<UploadTile> view;
+    base::FilePath path;
+    bool clipboard_image;
+  };
+  bool multiple_;
+  int columns_;
+  bool selection_started_ = false;
+  bool selected_image_ = false;
+  std::vector<base::FilePath> selected_paths_;
+  std::vector<TileRef> tile_views_;
+  raw_ptr<views::LabelButton> primary_button_ = nullptr;
+  raw_ptr<views::View> body_ = nullptr;
+  SelectionCallback select_;
+  base::RepeatingClosure show_all_;
+  base::RepeatingClosure close_;
+};
+
+}  // namespace
+
+EmberUploadRequest::EmberUploadRequest(
+    BrowserView* browser_view,
+    content::RenderFrameHost* render_frame_host,
+    scoped_refptr<content::FileSelectListener> listener,
+    const blink::mojom::FileChooserParams& params)
+    : content::WebContentsObserver(
+          content::WebContents::FromRenderFrameHost(render_frame_host)),
+      browser_view_(browser_view),
+      render_frame_host_(render_frame_host),
+      listener_(std::move(listener)),
+      params_(params.Clone()) {
+  if (tabs::TabInterface* tab =
+          tabs::TabInterface::MaybeGetFromContents(web_contents())) {
+    tab_deactivated_subscription_ =
+        tab->RegisterWillDeactivate(base::BindRepeating(
+            [](base::WeakPtr<EmberUploadRequest> request, tabs::TabInterface*) {
+              if (request) {
+                request->Cancel();
+              }
+            },
+            weak_ptr_factory_.GetWeakPtr()));
+  }
+}
+
+EmberUploadRequest::~EmberUploadRequest() {
+  Cancel();
+}
+
+bool EmberUploadRequest::IsRequestValid() const {
+  return !finished_ && render_frame_host_ && web_contents() &&
+         render_frame_host_->IsRenderFrameLive();
+}
+
+void EmberUploadRequest::Start() {
+  if (!IsRequestValid()) {
+    Cancel();
+    return;
+  }
+  anchor_in_screen_ = web_contents()->GetViewBounds().CenterPoint();
+  anchor_top_in_screen_ = anchor_in_screen_.y();
+  anchor_timeout_.Start(
+      FROM_HERE, base::Milliseconds(250),
+      base::BindOnce(&EmberUploadRequest::OnAnchorMeasured,
+                     weak_ptr_factory_.GetWeakPtr(), base::Value()));
+  render_frame_host_->ExecuteJavaScriptInIsolatedWorld(
+      uR"JS((() => {
+        let target = document.activeElement;
+        const input = target?.matches?.('input[type="file"]') ? target :
+            document.querySelector('input[type="file"]:focus') ||
+            document.querySelector('input[type="file"]');
+        if (!target || target === document.body ||
+            target === document.documentElement) {
+          target = input;
+        }
+        if (!target) return null;
+        let rect = target.getBoundingClientRect();
+        if ((!rect.width || !rect.height) && input) {
+          for (const label of input.labels || []) {
+            const labelRect = label.getBoundingClientRect();
+            if (labelRect.width && labelRect.height) {
+              rect = labelRect;
+              break;
+            }
+          }
+        }
+        if (!rect.width || !rect.height) return null;
+        return [rect.left + rect.width / 2, rect.bottom, rect.top];
+      })())JS",
+      base::BindOnce(&EmberUploadRequest::OnAnchorMeasured,
+                     weak_ptr_factory_.GetWeakPtr()),
+      ISOLATED_WORLD_ID_CHROME_INTERNAL);
+  ui::Clipboard* clipboard = ui::Clipboard::GetForCurrentThread();
+  if (!clipboard) {
+    clipboard_ready_ = true;
+    MaybeShow();
+    return;
+  }
+  clipboard->ReadFilenames(ui::ClipboardBuffer::kCopyPaste, std::nullopt,
+                           base::BindOnce(&EmberUploadRequest::OnClipboardFiles,
+                                          weak_ptr_factory_.GetWeakPtr()));
+}
+
+void EmberUploadRequest::OnClipboardFiles(std::vector<ui::FileInfo> files) {
+  if (!IsRequestValid()) {
+    Cancel();
+    return;
+  }
+  for (const auto& file : files) {
+    if (base::PathExists(file.path) && !base::DirectoryExists(file.path) &&
+        Accepts(file.path, params_->accept_types)) {
+      clipboard_files_.push_back(file.path);
+    }
+  }
+  ui::Clipboard::GetForCurrentThread()->ReadPng(
+      ui::ClipboardBuffer::kCopyPaste, std::nullopt,
+      base::BindOnce(&EmberUploadRequest::OnClipboardPng,
+                     weak_ptr_factory_.GetWeakPtr()));
+}
+
+void EmberUploadRequest::OnClipboardPng(const std::vector<uint8_t>& png) {
+  if (!IsRequestValid()) {
+    Cancel();
+    return;
+  }
+  if (png.size() <= 25 * 1024 * 1024 &&
+      Accepts(base::FilePath(FILE_PATH_LITERAL("Clipboard.png")),
+              params_->accept_types)) {
+    clipboard_png_ = png;
+    if (!png.empty()) {
+      base::ThreadPool::PostTaskAndReplyWithResult(
+          FROM_HERE, {base::TaskPriority::USER_VISIBLE},
+          base::BindOnce(&DecodeClipboardThumbnail, png),
+          base::BindOnce(&EmberUploadRequest::OnClipboardThumbnail,
+                         weak_ptr_factory_.GetWeakPtr()));
+      return;
+    }
+  }
+  clipboard_ready_ = true;
+  MaybeShow();
+}
+
+void EmberUploadRequest::OnClipboardThumbnail(SkBitmap thumbnail) {
+  if (!IsRequestValid()) {
+    Cancel();
+    return;
+  }
+  clipboard_thumbnail_ = std::move(thumbnail);
+  clipboard_ready_ = true;
+  MaybeShow();
+}
+
+void EmberUploadRequest::OnAnchorMeasured(base::Value result) {
+  if (anchor_ready_ || finished_) {
+    return;
+  }
+  anchor_timeout_.Stop();
+  const base::ListValue* coords = result.GetIfList();
+  if (coords && coords->size() == 3 && render_frame_host_ &&
+      render_frame_host_->GetView()) {
+    const auto number = [](const base::Value& value) -> std::optional<double> {
+      if (value.is_double()) {
+        return value.GetDouble();
+      }
+      if (value.is_int()) {
+        return value.GetInt();
+      }
+      return std::nullopt;
+    };
+    const auto x = number((*coords)[0]);
+    const auto bottom = number((*coords)[1]);
+    const auto top = number((*coords)[2]);
+    if (x && bottom && top) {
+      const gfx::Point origin =
+          render_frame_host_->GetView()->GetViewBounds().origin();
+      anchor_in_screen_ = gfx::Point(origin.x() + static_cast<int>(*x),
+                                     origin.y() + static_cast<int>(*bottom));
+      anchor_top_in_screen_ = origin.y() + static_cast<int>(*top);
+    }
+  }
+  anchor_ready_ = true;
+  MaybeShow();
+}
+
+void EmberUploadRequest::MaybeShow() {
+  if (anchor_ready_ && clipboard_ready_ && !bubble_ && !finished_) {
+    Show();
+  }
+}
+
+void EmberUploadRequest::Show() {
+  if (!IsRequestValid()) {
+    Cancel();
+    return;
+  }
+  std::vector<base::FilePath> recents;
+  std::vector<base::FilePath> downloads;
+  Profile* profile = browser_view_->GetProfile();
+  if (!profile->IsOffTheRecord()) {
+    const PrefService* prefs = profile->GetPrefs();
+    for (const auto& entry : prefs->GetList(prefs::kEmberRecentUploads)) {
+      if (!entry.is_string()) {
+        continue;
+      }
+      const base::FilePath path =
+          base::FilePath::FromUTF8Unsafe(entry.GetString());
+      if (base::PathExists(path) && !base::DirectoryExists(path) &&
+          Accepts(path, params_->accept_types)) {
+        recents.push_back(path);
+      }
+      if (recents.size() == 20) {
+        break;
+      }
+    }
+  }
+  if (content::DownloadManager* manager = profile->GetDownloadManager()) {
+    download::SimpleDownloadManager::DownloadVector items;
+    manager->GetAllDownloads(&items);
+    std::sort(items.begin(), items.end(), [](const auto& a, const auto& b) {
+      return a->GetEndTime() > b->GetEndTime();
+    });
+    for (const auto& item : items) {
+      if (item->GetState() != download::DownloadItem::COMPLETE ||
+          item->GetFileExternallyRemoved()) {
+        continue;
+      }
+      const base::FilePath& path = item->GetTargetFilePath();
+      if (!base::PathExists(path) || base::DirectoryExists(path) ||
+          !Accepts(path, params_->accept_types) ||
+          std::find(recents.begin(), recents.end(), path) != recents.end() ||
+          std::find(downloads.begin(), downloads.end(), path) !=
+              downloads.end()) {
+        continue;
+      }
+      downloads.push_back(path);
+      if (downloads.size() == 45) {
+        break;
+      }
+    }
+  }
+  gfx::Rect page_bounds = web_contents()->GetViewBounds();
+  if (page_bounds.IsEmpty()) {
+    page_bounds = browser_view_->multi_contents_view()->GetBoundsInScreen();
+  }
+  page_bounds.Inset(gfx::Insets(8));
+  const int width = std::min(kPopupWidth, page_bounds.width());
+  const int columns =
+      std::clamp((width - 36 + kTileGap) / (kTileWidth + kTileGap), 1, 5);
+  const size_t tile_count = clipboard_files_.size() +
+                            static_cast<size_t>(!clipboard_png_.empty()) +
+                            recents.size() + downloads.size();
+  const int visible_rows =
+      std::clamp(static_cast<int>((tile_count + columns - 1) / columns), 1, 3);
+  const int desired_height =
+      std::min(kPopupMaxHeight, 165 + visible_rows * kTileHeight +
+                                    (visible_rows - 1) * kTileGap);
+  const int height = std::min(desired_height, page_bounds.height());
+  int left = anchor_in_screen_.x() - 48;
+  if (left + width > page_bounds.right()) {
+    left = anchor_in_screen_.x() - width + 48;
+  }
+  left = std::clamp(left, page_bounds.x(), page_bounds.right() - width);
+  int top = anchor_in_screen_.y() + 12;
+  if (top + height > page_bounds.bottom()) {
+    top = anchor_top_in_screen_ - height - 12;
+  }
+  top = std::clamp(top, page_bounds.y(), page_bounds.bottom() - height);
+  const gfx::Rect popup_bounds(left, top, width, height);
+  const std::u16string origin =
+      base::UTF8ToUTF16(render_frame_host_->GetLastCommittedURL().host());
+  auto bubble = std::make_unique<UploadBubble>(
+      params_->mode == blink::mojom::FileChooserParams::Mode::kOpenMultiple,
+      origin, clipboard_files_, !clipboard_png_.empty(), clipboard_thumbnail_,
+      recents, downloads, width, height, columns,
+      base::BindRepeating(&EmberUploadRequest::Select,
+                          weak_ptr_factory_.GetWeakPtr()),
+      base::BindRepeating(&EmberUploadRequest::ShowAllFiles,
+                          weak_ptr_factory_.GetWeakPtr()),
+      base::BindRepeating(&EmberUploadRequest::Cancel,
+                          weak_ptr_factory_.GetWeakPtr()));
+  auto delegate = std::make_unique<views::BubbleDialogDelegate>(
+      views::BubbleAnchor(), views::BubbleBorder::NONE,
+      views::BubbleBorder::NO_SHADOW);
+  delegate->set_parent_window(browser_view_->GetWidget()->GetNativeView());
+  delegate->SetAnchorRect(gfx::Rect(anchor_in_screen_, gfx::Size(1, 1)));
+  delegate->set_margins(gfx::Insets());
+  delegate->SetButtons(static_cast<int>(ui::mojom::DialogButton::kNone));
+  delegate->set_close_on_deactivate(true);
+  delegate->RegisterWindowClosingCallback(base::BindOnce(
+      &EmberUploadRequest::OnBubbleClosing, weak_ptr_factory_.GetWeakPtr()));
+  ember::ConfigureEmberGlassBubble(bubble.get(), delegate.get());
+  views::View* surface = delegate->SetContentsView(std::move(bubble));
+  bubble_ = views::BubbleDialogDelegate::CreateBubbleDeprecated(
+      std::move(delegate),
+      views::Widget::InitParams::NATIVE_WIDGET_OWNS_WIDGET);
+  bubble_->Show();
+  bubble_->SetBounds(popup_bounds);
+  ember::CaptureEmberGlassBubbleBackdrop(browser_view_, surface,
+                                         anchor_in_screen_, web_contents());
+  browser_view_->SetEmberUploadScrim(true);
+}
+
+void EmberUploadRequest::Select(std::vector<base::FilePath> paths,
+                                bool clipboard_image) {
+  if (!IsRequestValid()) {
+    Cancel();
+    return;
+  }
+  base::FilePath temporary;
+  if (clipboard_image && !clipboard_png_.empty()) {
+    if (base::CreateTemporaryFile(&temporary)) {
+      const base::FilePath png_path =
+          temporary.RemoveExtension().AddExtension(FILE_PATH_LITERAL("png"));
+      if (base::Move(temporary, png_path) &&
+          base::WriteFile(png_path, base::span(clipboard_png_))) {
+        temporary = png_path;
+        paths.push_back(png_path);
+      } else {
+        base::DeleteFile(temporary);
+        temporary.clear();
+      }
+    }
+  }
+  if (paths.empty()) {
+    return;
+  }
+  auto listener = std::move(listener_);
+  finished_ = true;
+  browser_view_->SetEmberUploadScrim(false);
+  if (bubble_) {
+    bubble_->Close();
+    bubble_ = nullptr;
+  }
+  FileSelectHelper::SelectEmberFiles(render_frame_host_, std::move(listener),
+                                     *params_, paths, temporary);
+}
+
+void EmberUploadRequest::ShowAllFiles() {
+  if (!IsRequestValid()) {
+    Cancel();
+    return;
+  }
+  auto listener = std::move(listener_);
+  finished_ = true;
+  browser_view_->SetEmberUploadScrim(false);
+  if (bubble_) {
+    bubble_->Close();
+    bubble_ = nullptr;
+  }
+  FileSelectHelper::RunFileChooser(render_frame_host_, std::move(listener),
+                                   *params_);
+}
+
+void EmberUploadRequest::OnBubbleClosing() {
+  bubble_ = nullptr;
+  Cancel();
+}
+
+void EmberUploadRequest::Cancel() {
+  if (finished_) {
+    return;
+  }
+  finished_ = true;
+  anchor_timeout_.Stop();
+  browser_view_->SetEmberUploadScrim(false);
+  if (bubble_) {
+    bubble_->Close();
+    bubble_ = nullptr;
+  }
+  if (listener_) {
+    listener_->FileSelectionCanceled();
+    listener_.reset();
+  }
+}
+
+void EmberUploadRequest::RenderFrameDeleted(content::RenderFrameHost* frame) {
+  if (frame == render_frame_host_) {
+    render_frame_host_ = nullptr;
+    Cancel();
+  }
+}
+
+void EmberUploadRequest::DidStartNavigation(
+    content::NavigationHandle* navigation) {
+  if (navigation->GetRenderFrameHost() == render_frame_host_ &&
+      !navigation->IsSameDocument()) {
+    Cancel();
+  }
+}
+
+void EmberUploadRequest::WebContentsDestroyed() {
+  render_frame_host_ = nullptr;
+  Cancel();
+}
+
+}  // namespace ember
