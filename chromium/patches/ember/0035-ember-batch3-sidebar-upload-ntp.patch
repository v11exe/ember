+
+void BrowserView::OnEmberSidebarMotionTick() {
+  // The Favorite rail already uses a 180 ms FAST_OUT_SLOW_IN reflow. Advance
+  // shell and page bounds on that same clock so split panes and drop targets
+  // receive the geometry from Chromium's existing BrowserView layout.
+  const double elapsed =
+      (base::TimeTicks::Now() - ember_sidebar_motion_started_)
+          .InMillisecondsF();
+  const double progress = std::clamp(elapsed / 180.0, 0.0, 1.0);
+  const double eased =
+      gfx::Tween::CalculateValue(gfx::Tween::FAST_OUT_SLOW_IN, progress);
+  const int width = std::lround(
+      ember_sidebar_motion_from_ +
+      (ember_sidebar_motion_to_ - ember_sidebar_motion_from_) * eased);
+  SetEmberSidebarWidth(width);
+  if (progress >= 1.0) {
+    ember_sidebar_motion_timer_.Stop();
+    SetEmberSidebarWidth(ember_sidebar_motion_to_);
+  }
+}
