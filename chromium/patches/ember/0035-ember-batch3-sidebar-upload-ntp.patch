+// static
+void FileSelectHelper::SelectEmberFiles(
+    content::RenderFrameHost* render_frame_host,
+    scoped_refptr<content::FileSelectListener> listener,
+    const FileChooserParams& params,
+    const std::vector<base::FilePath>& paths,
+    const base::FilePath& temporary_file) {
+  if (!render_frame_host || paths.empty() ||
+      (params.mode != FileChooserParams::Mode::kOpen &&
+       params.mode != FileChooserParams::Mode::kOpenMultiple)) {
+    listener->FileSelectionCanceled();
+    return;
+  }
+  std::vector<ui::SelectedFileInfo> selected;
+  for (const base::FilePath& path : paths) {
+    if (!base::PathExists(path) || base::DirectoryExists(path)) {
+      continue;
+    }
+    selected.emplace_back(path);
+    if (params.mode == FileChooserParams::Mode::kOpen) {
+      break;
+    }
+  }
+  if (selected.empty()) {
+    listener->FileSelectionCanceled();
+    return;
+  }
+  Profile* profile = Profile::FromBrowserContext(
+      render_frame_host->GetProcess()->GetBrowserContext());
+  scoped_refptr<FileSelectHelper> helper(new FileSelectHelper(profile));
+  helper->render_frame_host_ = render_frame_host;
+  helper->web_contents_ = WebContents::FromRenderFrameHost(render_frame_host);
+  helper->listener_ = std::move(listener);
+  helper->dialog_mode_ = params.mode;
+  helper->dialog_type_ = params.mode == FileChooserParams::Mode::kOpenMultiple
+                             ? ui::SelectFileDialog::SELECT_OPEN_MULTI_FILE
+                             : ui::SelectFileDialog::SELECT_OPEN_FILE;
+  helper->InitLifecycleObserver(helper->web_contents_);
+  helper->self_ptr_ = helper.get();
+  if (!temporary_file.empty()) {
+    helper->temporary_files_.push_back(temporary_file);
+  }
+  if (selected.size() == 1) {
+    helper->FileSelected(selected.front(), 0);
+  } else {
+    helper->MultiFilesSelected(selected);
+  }
+}
