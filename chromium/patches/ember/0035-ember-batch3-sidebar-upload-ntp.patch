+SkBitmap DecodeClipboardThumbnail(std::vector<uint8_t> png) {
+  SkBitmap bitmap = gfx::PNGCodec::Decode(png);
+  if (bitmap.drawsNothing()) {
+    return {};
+  }
+  const int side = std::min(bitmap.width(), bitmap.height());
+  SkBitmap square;
+  if (!bitmap.extractSubset(
+          &square,
+          SkIRect::MakeXYWH((bitmap.width() - side) / 2,
+                            (bitmap.height() - side) / 2, side, side))) {
+    return {};
+  }
+  return skia::ImageOperations::Resize(
+      square, skia::ImageOperations::RESIZE_GOOD, 68, 68);
+}
+
+bool Accepts(const base::FilePath& path,
+             const std::vector<std::u16string>& accepted) {
+  if (accepted.empty()) {
+    return true;
+  }
+  const std::string extension =
+      base::ToLowerASCII(base::FilePath(path.Extension()).AsUTF8Unsafe());
+  std::string mime;
+  net::GetMimeTypeFromFile(path, &mime);
+  mime = base::ToLowerASCII(mime);
+  for (const std::u16string& item : accepted) {
+    const std::string type = base::ToLowerASCII(base::UTF16ToUTF8(item));
+    if (type == extension || type == mime || type == "*/*") {
+      return true;
+    }
+    if (base::EndsWith(type, "/*") &&
+        base::StartsWith(mime, type.substr(0, type.size() - 1))) {
+      return true;
+    }
+  }
+  return false;
+}
