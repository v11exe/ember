+#ifndef CHROME_BROWSER_UI_VIEWS_EMBER_EMBER_GLASS_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_EMBER_EMBER_GLASS_VIEW_H_
+
+#include "chrome/browser/ui/views/ember/ember_glass_material.h"
+#include "third_party/skia/include/core/SkBitmap.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/views/view.h"
+
+namespace ember {
+
+// Native Views surface for a cached EmberGlass panel. The panel pixels are
+// stable while child labels/icons and lightweight interaction layers repaint.
+class EmberGlassView : public views::View {
+ public:
+  static constexpr int kShadowMargin = 18;
+
+  explicit EmberGlassView(EmberGlassPreset preset);
+  EmberGlassView(const EmberGlassView&) = delete;
+  EmberGlassView& operator=(const EmberGlassView&) = delete;
+  ~EmberGlassView() override;
+
+  void SetPanel(const EmberGlassPanel& panel);
+  gfx::Rect GetPanelBounds() const;
+  bool bright_backdrop() const { return bright_backdrop_; }
+
+  SkColor PrimaryTextColor() const;
+  SkColor SecondaryTextColor() const;
+  SkColor InteractionFill(bool selected) const;
+  SkColor InteractionRim(bool selected) const;
+
+  // views::View:
+  void OnPaintBackground(gfx::Canvas* canvas) override;
+
+ private:
+  EmberGlassPreset preset_;
+  SkBitmap panel_bitmap_;
+  bool bright_backdrop_ = false;
+};
+
+}  // namespace ember
+
+#endif  // CHROME_BROWSER_UI_VIEWS_EMBER_EMBER_GLASS_VIEW_H_
