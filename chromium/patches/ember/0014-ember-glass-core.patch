+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_EMBER_EMBER_GLASS_MATERIAL_H_
+#define CHROME_BROWSER_UI_VIEWS_EMBER_EMBER_GLASS_MATERIAL_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <map>
+#include <tuple>
+#include <utility>
+
+#include "third_party/skia/include/core/SkBitmap.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/geometry/size.h"
+
+namespace ember {
+
+enum class EmberGlassPreset {
+  kCard,
+  kMenu,
+  kCtrlTab,
+  kPopover,
+  kCompactButton,
+};
+
+struct EmberGlassParams {
+  float displacement_scale = 200.0f;
+  float blur_amount = 1.0f;
+  float saturation = 140.0f;
+  float aberration = 2.0f;
+  float elasticity = 0.0f;
+  float corner_radius = 32.0f;
+};
+
+struct EmberGlassCacheKey {
+  uint64_t backdrop_generation = 0;
+  gfx::Rect source_rect;
+  EmberGlassPreset preset = EmberGlassPreset::kCard;
+
+  bool operator<(const EmberGlassCacheKey& other) const {
+    return std::tuple(backdrop_generation, source_rect.x(), source_rect.y(),
+                      source_rect.width(), source_rect.height(), preset) <
+           std::tuple(other.backdrop_generation, other.source_rect.x(),
+                      other.source_rect.y(), other.source_rect.width(),
+                      other.source_rect.height(), other.preset);
+  }
+};
+
+struct EmberGlassPanel {
+  SkBitmap bitmap;
+  bool bright_backdrop = false;
+};
+
+// Turns a one-shot compositor snapshot into reusable cached panel pixels. The
+// approved EmberGlass displacement/blur/saturation graph is evaluated only
+// when the backdrop generation, panel geometry, or preset changes.
+class EmberGlassMaterial {
+ public:
+  EmberGlassMaterial();
+  EmberGlassMaterial(const EmberGlassMaterial&) = delete;
+  EmberGlassMaterial& operator=(const EmberGlassMaterial&) = delete;
+  ~EmberGlassMaterial();
+
+  const EmberGlassPanel* RenderPanel(const SkBitmap& backdrop,
+                                     const gfx::Rect& source_rect,
+                                     uint64_t backdrop_generation,
+                                     EmberGlassPreset preset);
+  void Invalidate();
+
+  size_t RenderCountForTesting() const { return render_count_; }
+
+  static EmberGlassParams ParamsForPreset(EmberGlassPreset preset);
+
+ private:
+  bool EnsureDisplacementMap();
+  const SkBitmap* ScaledDisplacement(const gfx::Size& size);
+
+  SkBitmap displacement_map_;
+  std::map<std::pair<int, int>, SkBitmap> scaled_displacement_cache_;
+  std::map<EmberGlassCacheKey, EmberGlassPanel> panel_cache_;
+  size_t render_count_ = 0;
+};
+
+}  // namespace ember
+
+#endif  // CHROME_BROWSER_UI_VIEWS_EMBER_EMBER_GLASS_MATERIAL_H_
