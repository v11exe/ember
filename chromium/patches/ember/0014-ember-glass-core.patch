+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/ember/ember_glass_view.h"
+
+#include <algorithm>
+
+#include "cc/paint/paint_canvas.h"
+#include "cc/paint/paint_flags.h"
+#include "cc/paint/paint_image.h"
+#include "third_party/skia/include/core/SkCanvas.h"
+#include "third_party/skia/include/core/SkImage.h"
+#include "third_party/skia/include/core/SkPaint.h"
+#include "third_party/skia/include/core/SkRRect.h"
+#include "third_party/skia/include/core/SkSamplingOptions.h"
+#include "ui/compositor/layer.h"
+#include "ui/gfx/canvas.h"
+
+namespace ember {
+
+EmberGlassView::EmberGlassView(EmberGlassPreset preset) : preset_(preset) {
+  SetPaintToLayer();
+  layer()->SetFillsBoundsOpaquely(false);
+}
+
+EmberGlassView::~EmberGlassView() = default;
+
+void EmberGlassView::SetPanel(const EmberGlassPanel& panel) {
+  panel_bitmap_ = panel.bitmap;
+  bright_backdrop_ = panel.bright_backdrop;
+  SchedulePaint();
+}
+
+gfx::Rect EmberGlassView::GetPanelBounds() const {
+  gfx::Rect bounds = GetLocalBounds();
+  bounds.Inset(kShadowMargin);
+  return bounds;
+}
+
+SkColor EmberGlassView::PrimaryTextColor() const {
+  return bright_backdrop_ ? SkColorSetRGB(31, 34, 39)
+                          : SkColorSetARGB(235, 255, 255, 255);
+}
+
+SkColor EmberGlassView::SecondaryTextColor() const {
+  return bright_backdrop_ ? SkColorSetRGB(86, 91, 98)
+                          : SkColorSetARGB(170, 255, 255, 255);
+}
+
+SkColor EmberGlassView::InteractionFill(bool selected) const {
+  if (bright_backdrop_) {
+    return SkColorSetARGB(selected ? 48 : 34, 31, 34, 39);
+  }
+  return SkColorSetARGB(selected ? 38 : 30, 255, 255, 255);
+}
+
+SkColor EmberGlassView::InteractionRim(bool selected) const {
+  if (bright_backdrop_) {
+    return SkColorSetARGB(selected ? 92 : 70, 31, 34, 39);
+  }
+  return SkColorSetARGB(selected ? 78 : 55, 255, 255, 255);
+}
+
+void EmberGlassView::OnPaintBackground(gfx::Canvas* canvas) {
+  const gfx::Rect panel_bounds = GetPanelBounds();
+  const EmberGlassParams params = EmberGlassMaterial::ParamsForPreset(preset_);
+  const SkRect panel_rect = SkRect::MakeXYWH(
+      panel_bounds.x(), panel_bounds.y(), panel_bounds.width(),
+      panel_bounds.height());
+  cc::PaintCanvas* sk_canvas = canvas->sk_canvas();
+
+  constexpr int kShadowLayers = 12;
+  for (int i = kShadowLayers; i >= 1; --i) {
+    const float t = static_cast<float>(i) / kShadowLayers;
+    const float spread = 1.5f + t * 15.0f;
+    const float y_offset = 5.0f + t * 8.0f;
+    const float falloff = 1.0f - t;
+    const float alpha = (bright_backdrop_ ? 24.0f : 17.0f) *
+                        (0.35f + falloff * falloff * 0.65f);
+    cc::PaintFlags shadow;
+    shadow.setAntiAlias(true);
+    shadow.setColor(SkColorSetARGB(
+        static_cast<U8CPU>(std::clamp(alpha, 0.0f, 255.0f)), 0, 0, 0));
+    const SkRect shadow_rect =
+        panel_rect.makeOffset(0.0f, y_offset).makeOutset(spread, spread);
+    sk_canvas->drawRoundRect(shadow_rect, params.corner_radius + spread,
+                             params.corner_radius + spread, shadow);
+  }
+
+  if (!panel_bitmap_.empty()) {
+    sk_canvas->save();
+    sk_canvas->clipRRect(SkRRect::MakeRectXY(
+        panel_rect, params.corner_radius, params.corner_radius), true);
+    sk_canvas->drawImageRect(
+        cc::PaintImage::CreateFromBitmap(panel_bitmap_),
+        SkRect::MakeWH(panel_bitmap_.width(), panel_bitmap_.height()),
+        panel_rect, SkSamplingOptions(SkFilterMode::kLinear), nullptr,
+        SkCanvas::kStrict_SrcRectConstraint);
+    sk_canvas->restore();
+  } else {
+    cc::PaintFlags fallback;
+    fallback.setAntiAlias(true);
+    fallback.setColor(SkColorSetARGB(232, 65, 72, 84));
+    sk_canvas->drawRoundRect(panel_rect, params.corner_radius,
+                             params.corner_radius, fallback);
+  }
+
+  cc::PaintFlags outer_rim;
+  outer_rim.setAntiAlias(true);
+  outer_rim.setStyle(cc::PaintFlags::kStroke_Style);
+  outer_rim.setStrokeWidth(1.0f);
+  outer_rim.setColor(SkColorSetARGB(104, 255, 255, 255));
+  sk_canvas->drawRoundRect(panel_rect.makeInset(0.5f, 0.5f),
+                           params.corner_radius - 0.5f,
+                           params.corner_radius - 0.5f, outer_rim);
+
+  cc::PaintFlags inset_rim;
+  inset_rim.setAntiAlias(true);
+  inset_rim.setStyle(cc::PaintFlags::kStroke_Style);
+  inset_rim.setStrokeWidth(1.0f);
+  inset_rim.setColor(SkColorSetARGB(38, 255, 255, 255));
+  sk_canvas->drawRoundRect(panel_rect.makeInset(1.75f, 1.75f),
+                           params.corner_radius - 1.75f,
+                           params.corner_radius - 1.75f, inset_rim);
+  if (bright_backdrop_) {
+    cc::PaintFlags dark_inner_rim;
+    dark_inner_rim.setAntiAlias(true);
+    dark_inner_rim.setStyle(cc::PaintFlags::kStroke_Style);
+    dark_inner_rim.setStrokeWidth(1.0f);
+    dark_inner_rim.setColor(SkColorSetARGB(24, 0, 0, 0));
+    sk_canvas->drawRoundRect(panel_rect.makeInset(2.75f, 2.75f),
+                             params.corner_radius - 2.75f,
+                             params.corner_radius - 2.75f, dark_inner_rim);
+  }
+}
+
+}  // namespace ember
