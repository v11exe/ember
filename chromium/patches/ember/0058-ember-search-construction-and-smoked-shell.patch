+IN_PROC_BROWSER_TEST_F(BrowserViewTest, EmberShellCornersHaveOneTranslucentTint) {
+  auto* surface = browser_view()->AddChildView(std::make_unique<views::View>());
+  surface->SetBounds(0, 0, 80, 80);
+  auto background = std::make_unique<CustomCornersBackground>(
+      *surface, *browser_view(), kColorToolbar, ui::kColorFrameActive, 16);
+  CustomCornersBackground::Corners corners;
+  for (auto corner : {CornerOrientation::kTopLeading,
+                      CornerOrientation::kTopTrailing,
+                      CornerOrientation::kBottomLeading,
+                      CornerOrientation::kBottomTrailing}) {
+    corners[corner] = {CustomCornersBackground::CornerType::kRoundedWithBackground,
+                       16};
+  }
+  background->SetCorners(corners);
+  background->SetVisible(true);
+  gfx::Canvas canvas(gfx::Size(80, 80), 1.f, false);
+  background->Paint(&canvas, surface);
+  const SkBitmap bitmap = canvas.GetBitmap();
+  const SkColor centre = bitmap.getColor(40, 40);
+  EXPECT_EQ(210u, SkColorGetA(centre));
+  for (const gfx::Point& point : {gfx::Point(1, 1), gfx::Point(78, 1),
+                                 gfx::Point(1, 78), gfx::Point(78, 78),
+                                 gfx::Point(12, 12)}) {
+    EXPECT_EQ(centre, bitmap.getColor(point.x(), point.y()));
+  }
+  background.reset();
+  browser_view()->RemoveChildViewT(surface);
+}
