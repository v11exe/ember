+IN_PROC_BROWSER_TEST_F(BrowserViewTest, EmberDetachedSuggestionTextConstruction) {
+  // The real match-cell constructor sets nonempty ellipsis and separator text
+  // before AddChildViewAt attaches its row to the popup's Widget.
+  OmniboxTextView text(nullptr);
+  ASSERT_FALSE(text.GetColorProvider());
+  text.SetText(u"...");
+  ASSERT_TRUE(text.render_text_for_testing());
+  EXPECT_EQ(u"...", text.GetText());
+  text.SetTextWithStyling(u"Search", {});
+  EXPECT_EQ(u"Search", text.GetText());
+  EXPECT_TRUE(gfx::test::RenderTextTestApi(
+      const_cast<gfx::RenderText*>(text.render_text_for_testing()))
+      .colors().EqualsValueForTesting(SkColorSetRGB(235, 237, 240)));
+}
