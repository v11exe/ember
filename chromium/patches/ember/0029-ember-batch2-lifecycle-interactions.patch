+  const GURL url = contents->GetVisibleURL();
+  if (!url.SchemeIsHTTPOrHTTPS()) {
+    return;
+  }
+  std::u16string title = contents->GetTitle();
+  if (title.empty()) {
+    title = base::UTF8ToUTF16(EmberFavoriteHost(url));
