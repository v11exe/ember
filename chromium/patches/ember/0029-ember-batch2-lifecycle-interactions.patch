+    tile.addEventListener('dragleave', () => delete tile.dataset.drop);
+    tile.addEventListener('drop', event => {
+      if (!draggedFavoriteId) return;
+      event.preventDefault();
+      chrome.send('emberFavoriteMove', [draggedFavoriteId, index]);
+      draggedFavoriteId = null;
+    });
+    grid.append(tile);
+  }
+}
+
+function persistGrid() {
+  chrome.send('emberFavoritesSetGrid', [Number(columnsSelect.value), Number(rowsSelect.value)]);
+}
+columnsSelect.addEventListener('change', persistGrid);
+rowsSelect.addEventListener('change', persistGrid);
+document.getElementById('favorite-add').addEventListener('click', () => {
+  document.getElementById('favorite-form').reset();
+  dialog.showModal();
+  document.getElementById('favorite-title').focus();
+});
+document.getElementById('favorite-cancel').addEventListener('click', () => dialog.close());
+document.getElementById('favorite-url').addEventListener('input', event => {
+  event.target.setCustomValidity('');
+});
+document.getElementById('favorite-form').addEventListener('submit', event => {
+  event.preventDefault();
+  const title = document.getElementById('favorite-title').value.trim();
+  const urlField = document.getElementById('favorite-url');
+  const url = urlField.value.trim();
+  if (!title || !url) return;
