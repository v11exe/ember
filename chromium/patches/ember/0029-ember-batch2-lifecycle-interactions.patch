+
+function gridMetrics(rows) {
+  const gap = rows <= 4 ? 10 : Math.max(4, 10 - (rows - 4) * 2);
+  const tileHeight = rows <= 4 ? 43 : Math.floor((202 - gap * (rows - 1)) / rows);
+  return {gap, tileHeight, height: tileHeight * rows + gap * (rows - 1) + 2};
+}
+
+function renderFavorites(state) {
+  favoritesState = state;
+  const columns = Math.max(1, Math.min(4, state.columns));
+  const rows = Math.max(1, Math.min(7, state.rows));
+  const capacity = columns * rows;
+  const metrics = gridMetrics(rows);
+  columnsSelect.value = String(columns);
+  rowsSelect.value = String(rows);
+  grid.style.setProperty('--favorite-columns', String(columns));
+  grid.style.setProperty('--favorite-gap', `${metrics.gap}px`);
+  grid.style.setProperty('--favorite-tile-height', `${metrics.tileHeight}px`);
+  grid.style.setProperty('--favorite-grid-height', `${metrics.height}px`);
+  grid.replaceChildren();
+
+  for (let index = 0; index < capacity; index++) {
+    const favorite = state.favorites[index];
+    const tile = document.createElement('div');
+    tile.className = `favorite-tile${favorite ? '' : ' favorite-tile--empty'}`;
+    tile.dataset.index = String(index);
+    if (favorite) {
+      tile.tabIndex = 0;
+      tile.setAttribute('role', 'button');
+      tile.title = favorite.title || favorite.url;
+      tile.setAttribute('aria-label', `Open ${favorite.title || favorite.url}`);
+      tile.draggable = true;
+      const icon = document.createElement('img');
+      icon.alt = '';
+      icon.draggable = false;
+      icon.src = `chrome://favicon2/?size=32&scale_factor=1x&page_url=${encodeURIComponent(favorite.url)}`;
+      tile.append(icon);
+      const remove = document.createElement('button');
+      remove.type = 'button';
+      remove.className = 'favorite-tile__remove';
+      remove.textContent = '×';
+      remove.title = `Remove ${favorite.title || favorite.url}`;
+      remove.addEventListener('click', event => {
+        event.stopPropagation();
+        chrome.send('emberFavoriteRemove', [favorite.id]);
+      });
+      tile.append(remove);
+      tile.addEventListener('click', () => chrome.send('emberFavoriteOpen', [favorite.url]));
+      tile.addEventListener('keydown', event => {
+        if (event.key === 'Enter' || event.key === ' ') {
+          event.preventDefault();
+          chrome.send('emberFavoriteOpen', [favorite.url]);
+        }
+      });
+      tile.addEventListener('dragstart', event => {
+        draggedFavoriteId = favorite.id;
+        event.dataTransfer.effectAllowed = 'move';
+        event.dataTransfer.setData('text/x-ember-favorite', favorite.id);
+      });
+      tile.addEventListener('dragend', () => {
+        draggedFavoriteId = null;
+        grid.querySelectorAll('[data-drop="true"]').forEach(node => delete node.dataset.drop);
+      });
