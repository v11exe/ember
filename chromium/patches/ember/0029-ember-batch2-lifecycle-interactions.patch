+       ember_favorites::GetNodes(ember_bookmark_model_)) {
+    if (existing->url() == url) {
+      ember_favorites::Move(ember_bookmark_model_, existing->id(), index);
+      return;
+    }
+  }
+  ember_favorites::Add(ember_bookmark_model_, url, title, index);
+}
