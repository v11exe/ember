diff --git a/chrome/browser/ui/ember_favorites.cc b/chrome/browser/ui/ember_favorites.cc
new file mode 100644
index 0000000..b7aaa31
--- /dev/null
+++ b/chrome/browser/ui/ember_favorites.cc
@@ -0,0 +1,216 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/ember_favorites.h"
+
+#include <algorithm>
+#include <optional>
+
+#include "base/location.h"
+#include "chrome/common/pref_names.h"
+#include "components/bookmarks/browser/bookmark_model.h"
+#include "components/bookmarks/browser/bookmark_node.h"
+#include "components/bookmarks/common/bookmark_metrics.h"
+#include "components/prefs/pref_service.h"
+
+namespace ember_favorites {
+namespace {
+
+constexpr char kFolderMetaKey[] = "ember_favorites_folder";
+constexpr char kFolderMetaValue[] = "1";
+constexpr char kInitializedMetaKey[] = "ember_favorites_initialized";
+
+const bookmarks::BookmarkNode* FindMarkedFolder(
+    const bookmarks::BookmarkNode* parent) {
+  if (!parent) {
+    return nullptr;
+  }
+  for (const auto& child : parent->children()) {
+    std::string marker;
+    if (child->is_folder() && child->GetMetaInfo(kFolderMetaKey, &marker) &&
+        marker == kFolderMetaValue) {
+      return child.get();
+    }
+    if (child->is_folder()) {
+      if (const bookmarks::BookmarkNode* match =
+              FindMarkedFolder(child.get())) {
+        return match;
+      }
+    }
+  }
+  return nullptr;
+}
+
+const bookmarks::BookmarkNode* FindNodeById(
+    const bookmarks::BookmarkNode* folder,
+    int64_t node_id) {
+  if (!folder) {
+    return nullptr;
+  }
+  for (const auto& child : folder->children()) {
+    if (child->id() == node_id) {
+      return child.get();
+    }
+  }
+  return nullptr;
+}
+
+size_t ChildIndexForVisibleIndex(const bookmarks::BookmarkNode* folder,
+                                 size_t visible_index) {
+  size_t visible = 0;
+  for (size_t child_index = 0; child_index < folder->children().size();
+       ++child_index) {
+    const bookmarks::BookmarkNode* child =
+        folder->children()[child_index].get();
+    if (!child->is_url() || !child->url().SchemeIsHTTPOrHTTPS()) {
+      continue;
+    }
+    if (visible++ == visible_index) {
+      return child_index;
+    }
+  }
+  return folder->children().size();
+}
+
+}  // namespace
+
+int GetColumns(const PrefService* prefs) {
+  return std::clamp(prefs->GetInteger(prefs::kEmberFavoritesColumns),
+                    kMinColumns, kMaxColumns);
+}
+
+int GetRows(const PrefService* prefs) {
+  return std::clamp(prefs->GetInteger(prefs::kEmberFavoritesRows), kMinRows,
+                    kMaxRows);
+}
+
+size_t GetVisibleCapacity(const PrefService* prefs) {
+  return static_cast<size_t>(GetColumns(prefs) * GetRows(prefs));
+}
+
+int GetGridGap(int rows) {
+  rows = std::clamp(rows, kMinRows, kMaxRows);
+  return rows <= 4 ? kDefaultGap : std::max(4, kDefaultGap - (rows - 4) * 2);
+}
+
+int GetGridTileHeight(int rows) {
+  rows = std::clamp(rows, kMinRows, kMaxRows);
+  if (rows <= 4) {
+    return kTileHeight;
+  }
+  const int gap = GetGridGap(rows);
+  return (kFourRowInnerHeight - gap * (rows - 1)) / rows;
+}
+
+int GetGridHeight(int rows) {
+  rows = std::clamp(rows, kMinRows, kMaxRows);
+  return GetGridTileHeight(rows) * rows + GetGridGap(rows) * (rows - 1) + 2;
+}
+
+const bookmarks::BookmarkNode* FindFolder(
+    const bookmarks::BookmarkModel* model) {
+  if (!model || !model->loaded()) {
+    return nullptr;
+  }
+  return FindMarkedFolder(model->root_node());
+}
+
+const bookmarks::BookmarkNode* EnsureFolder(bookmarks::BookmarkModel* model) {
+  if (!model || !model->loaded()) {
+    return nullptr;
+  }
+  if (const bookmarks::BookmarkNode* folder = FindFolder(model)) {
+    return folder;
+  }
+
+  const bookmarks::BookmarkNode* other = model->other_node();
+  std::string initialized_marker;
+  const bool initialized =
+      other->GetMetaInfo(kInitializedMetaKey, &initialized_marker) &&
+      initialized_marker == kFolderMetaValue;
+  if (!initialized) {
+    model->SetNodeMetaInfo(other, kInitializedMetaKey, kFolderMetaValue);
+  }
+
+  bookmarks::BookmarkNode::MetaInfoMap metadata = {
+      {kFolderMetaKey, kFolderMetaValue}};
+  const bookmarks::BookmarkNode* folder = model->AddFolder(
+      other, other->children().size(), u"Ember Favorites", &metadata);
+  if (!initialized) {
+    model->AddURL(folder, folder->children().size(), u"Google",
+                  GURL("https://www.google.com/"), nullptr, std::nullopt,
+                  std::nullopt, true);
+    model->AddURL(folder, folder->children().size(), u"YouTube",
+                  GURL("https://www.youtube.com/"), nullptr, std::nullopt,
+                  std::nullopt, true);
+    model->AddURL(folder, folder->children().size(), u"Google Calendar",
+                  GURL("https://calendar.google.com/"), nullptr, std::nullopt,
+                  std::nullopt, true);
+  }
+  return folder;
+}
+
+std::vector<const bookmarks::BookmarkNode*> GetNodes(
+    const bookmarks::BookmarkModel* model) {
+  std::vector<const bookmarks::BookmarkNode*> nodes;
+  const bookmarks::BookmarkNode* folder = FindFolder(model);
+  if (!folder) {
+    return nodes;
+  }
+  for (const auto& child : folder->children()) {
+    if (child->is_url() && child->url().SchemeIsHTTPOrHTTPS()) {
+      nodes.push_back(child.get());
+    }
+  }
+  return nodes;
+}
+
+const bookmarks::BookmarkNode* Add(bookmarks::BookmarkModel* model,
+                                   const GURL& url,
+                                   const std::u16string& title,
+                                   size_t index) {
+  if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS()) {
+    return nullptr;
+  }
+  const bookmarks::BookmarkNode* folder = EnsureFolder(model);
+  if (!folder) {
+    return nullptr;
+  }
+  const size_t child_index = ChildIndexForVisibleIndex(folder, index);
+  return model->AddURL(folder, child_index, title, url, nullptr, std::nullopt,
+                       std::nullopt, true);
+}
+
+bool Remove(bookmarks::BookmarkModel* model, int64_t node_id) {
+  const bookmarks::BookmarkNode* node =
+      FindNodeById(FindFolder(model), node_id);
+  if (!node || !node->is_url()) {
+    return false;
+  }
+  model->Remove(node, bookmarks::metrics::BookmarkEditSource::kUser, FROM_HERE);
+  return true;
+}
+
+bool Move(bookmarks::BookmarkModel* model,
+          int64_t node_id,
+          size_t destination_index) {
+  const bookmarks::BookmarkNode* folder = FindFolder(model);
+  const bookmarks::BookmarkNode* node = FindNodeById(folder, node_id);
+  if (!folder || !node || !node->is_url()) {
+    return false;
+  }
+  const size_t old_child_index = folder->GetIndexOf(node).value();
+  size_t insertion_index = ChildIndexForVisibleIndex(folder, destination_index);
+  // BookmarkModel::Move() treats its index as an insertion point in the
+  // pre-removal child list, then decrements forward same-parent moves. Advance
+  // past the destination node so a Favorite dropped to the right lands in the
+  // exact requested visible slot rather than one slot early.
+  if (insertion_index > old_child_index) {
+    insertion_index = std::min(insertion_index + 1, folder->children().size());
+  }
+  model->Move(node, folder, insertion_index);
+  return true;
+}
+
+}  // namespace ember_favorites
