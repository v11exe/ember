+EmberSelectionPopup::EmberSelectionPopup(BrowserView* browser_view)
+    : browser_view_(browser_view) {
+  const base::DictValue& saved = browser_view_->browser()->profile()->GetPrefs()
+                                        ->GetDict(prefs::kEmberConversionRates);
+  if (const auto fetched = saved.FindDouble("fetched_at")) {
+    rates_fetched_at_ = base::Time::FromSecondsSinceUnixEpoch(*fetched);
+  }
+  if (const base::DictValue* rates = saved.FindDict("table")) {
+    rates_ = rates->Clone();
+  }
+}
+
+EmberSelectionPopup::~EmberSelectionPopup() {
+  Hide();
+}
+
+void EmberSelectionPopup::Update(content::RenderFrameHost* frame,
+                                 std::u16string_view selected_text) {
+  ++generation_;
+  selection_timer_.Stop();
+  if (!frame || selected_text.empty() || selected_text.size() > 120 ||
+      !frame->IsRenderFrameLive()) {
+    Hide();
+    return;
+  }
+  if (!browser_view_->browser()->profile()->GetPrefs()->GetBoolean(
+          prefs::kEmberConversionsEnabled)) {
+    Hide();
+    return;
+  }
+  source_contents_ = content::WebContents::FromRenderFrameHost(frame);
+  if (!source_contents_ || source_contents_ !=
+                               browser_view_->GetActiveWebContents() ||
+      !source_contents_->GetLastCommittedURL().SchemeIsHTTPOrHTTPS()) {
+    Hide();
+    return;
+  }
+  frame_id_ = frame->GetGlobalId();
+  selected_text_ = selected_text;
+  if (bubble_) {
+    bubble_->Close();
+    bubble_ = nullptr;
+  }
+  selection_timer_.Start(
+      FROM_HERE, base::Milliseconds(180),
+      base::BindOnce(&EmberSelectionPopup::Evaluate,
+                     weak_ptr_factory_.GetWeakPtr()));
+}
+
+void EmberSelectionPopup::Evaluate() {
+  content::RenderFrameHost* frame =
+      content::RenderFrameHost::FromID(frame_id_);
+  if (!frame || !frame->IsRenderFrameLive() ||
+      content::WebContents::FromRenderFrameHost(frame) != source_contents_) {
+    Hide();
+    return;
+  }
+  const auto selection = source_contents_->GetTextSelectionBounds(frame);
+  if (!selection || selection->IsEmpty()) {
+    Hide();
+    return;
+  }
+  selection_bounds_ = *selection;
+  const std::string text_json =
+      base::WriteJson(base::Value(base::UTF16ToUTF8(selected_text_))).value();
+  const std::string prefs_json = base::WriteJson(ConversionPrefs()).value();
+  const std::string rates_json = base::WriteJson(rates_).value();
+  const std::string rules = ui::ResourceBundle::GetSharedInstance()
+                                .LoadDataResourceString(
+                                    IDR_EMBER_CONVERSIONS_SCRIPT);
+  const std::string script =
+      "(() => { const module = {exports: {}};\n" + rules +
+      "\nconst text = " + text_json + "; const detected = module.exports.detectValue(text);"
+      "return {kind: detected?.kind || '', code: detected?.code || '', description: "
+      "module.exports.convert(detected, " + prefs_json +
+      ", {rates: " + rates_json + "})}; })()";
+  frame->ExecuteJavaScriptInIsolatedWorld(
+      base::UTF8ToUTF16(script),
+      base::BindOnce(&EmberSelectionPopup::OnConverted,
+                     weak_ptr_factory_.GetWeakPtr(), generation_),
+      ISOLATED_WORLD_ID_CHROME_INTERNAL);
+}
+
+void EmberSelectionPopup::OnConverted(uint64_t generation, base::Value value) {
+  if (generation != generation_ || !source_contents_ ||
+      source_contents_ != browser_view_->GetActiveWebContents() ||
+      !value.is_dict()) {
+    return;
+  }
+  const base::DictValue& response = value.GetDict();
+  const std::string* kind = response.FindString("kind");
+  const std::string* code = response.FindString("code");
+  if (kind && *kind == "currency" && code &&
+      *code != browser_view_->browser()->profile()->GetPrefs()->GetString(
+                   prefs::kEmberConversionsCurrency) &&
+      (rates_.empty() || base::Time::Now() - rates_fetched_at_ > kRatesMaxAge)) {
+    FetchRates();
+  }
+  const base::DictValue* description = response.FindDict("description");
+  if (!description) {
+    return;
+  }
+  const std::string* from = description->FindString("from");
+  const std::string* to = description->FindString("to");
+  if (!from || !to) {
+    return;
+  }
+  if (bubble_) {
+    views::Widget* previous = bubble_;
+    bubble_ = nullptr;
+    previous->Close();
+    ++generation_;
+  }
+  const std::string* note = description->FindString("note");
+  bubble_size_ = gfx::Size(kWidth, kHeight + (note && !note->empty() ? 18 : 0));
+  const gfx::Rect bounds =
+      PlaceBubble(source_contents_, selection_bounds_, bubble_size_);
+  if (bounds.IsEmpty()) {
+    return;
+  }
+
+  auto surface = std::make_unique<views::View>();
+  surface->SetPreferredSize(bounds.size());
+  surface->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical,
+      gfx::Insets::TLBR(10, 12, 10, 12), 4));
+  auto* source = surface->AddChildView(
+      std::make_unique<views::Label>(base::UTF8ToUTF16(*from)));
+  source->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  source->SetFontList(FontForStyle(TextStyle::kSecondary));
+  source->SetElideBehavior(gfx::ELIDE_TAIL);
+  auto* result = surface->AddChildView(
+      std::make_unique<views::Label>(u"≈ " + base::UTF8ToUTF16(*to)));
+  result->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  result->SetFontList(FontForStyle(TextStyle::kEmphasis));
+  result->SetElideBehavior(gfx::ELIDE_TAIL);
+  if (note && !note->empty()) {
+    auto* note_label = surface->AddChildView(
+        std::make_unique<views::Label>(base::UTF8ToUTF16(*note)));
+    note_label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    note_label->SetFontList(FontForStyle(TextStyle::kSecondary));
+  }
+  const std::u16string copied = base::UTF8ToUTF16(*to);
+  auto copy = std::make_unique<ConversionCopyButton>(
+      base::BindRepeating(&EmberSelectionPopup::Copy,
+                          weak_ptr_factory_.GetWeakPtr(), copied));
+  std::unique_ptr<views::View> copy_view = std::move(copy);
+  surface->AddChildView(std::move(copy_view));
+
+  auto delegate = std::make_unique<views::BubbleDialogDelegate>(
+      views::BubbleAnchor(), views::BubbleBorder::NONE,
+      views::BubbleBorder::NO_SHADOW);
+  delegate->set_parent_window(browser_view_->GetWidget()->GetNativeView());
+  delegate->SetAnchorRect(gfx::Rect(selection_bounds_.origin(),
+                                    gfx::Size(1, 1)));
+  delegate->set_margins(gfx::Insets());
+  delegate->SetButtons(static_cast<int>(ui::mojom::DialogButton::kNone));
+  delegate->set_close_on_deactivate(true);
+  delegate->RegisterWindowClosingCallback(base::BindOnce(
+      &EmberSelectionPopup::OnBubbleClosing,
+      weak_ptr_factory_.GetWeakPtr(), generation_));
+  ConfigureEmberGlassBubble(surface.get(), delegate.get());
+  views::View* glass_surface = delegate->SetContentsView(std::move(surface));
+  bubble_ = views::BubbleDialogDelegate::CreateBubbleDeprecated(
+      std::move(delegate),
+      views::Widget::InitParams::NATIVE_WIDGET_OWNS_WIDGET);
+  bubble_->ShowInactive();
+  bubble_->SetBounds(bounds);
+  CaptureEmberGlassBubbleBackdrop(browser_view_, glass_surface,
+                                  selection_bounds_.origin(), source_contents_);
+}
+
+base::DictValue EmberSelectionPopup::ConversionPrefs() const {
+  PrefService* prefs = browser_view_->browser()->profile()->GetPrefs();
+  base::DictValue result;
+  result.Set("enabled", prefs->GetBoolean(prefs::kEmberConversionsEnabled));
+  result.Set("currency", prefs->GetString(prefs::kEmberConversionsCurrency));
+  result.Set("temperature",
+             prefs->GetString(prefs::kEmberConversionsTemperature));
+  result.Set("distance", prefs->GetString(prefs::kEmberConversionsDistance));
+  result.Set("weight", prefs->GetString(prefs::kEmberConversionsWeight));
+  result.Set("volume", prefs->GetString(prefs::kEmberConversionsVolume));
+  result.Set("clock", prefs->GetString(prefs::kEmberConversionsClock));
+  result.Set("timeZone", prefs->GetString(prefs::kEmberConversionsTimeZone));
+  return result;
+}
+
+void EmberSelectionPopup::FetchRates() {
+  if (rates_loader_ || base::Time::Now() < next_rate_attempt_) {
+    return;
+  }
+  next_rate_attempt_ = base::Time::Now() + base::Minutes(1);
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = GURL("https://api.frankfurter.app/latest?from=EUR");
+  request->method = "GET";
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  rates_loader_ = network::SimpleURLLoader::Create(
+      std::move(request), kRatesTrafficAnnotation);
+  rates_loader_->SetTimeoutDuration(base::Seconds(6));
+  rates_loader_->DownloadToString(
+      browser_view_->browser()->profile()->GetDefaultStoragePartition()
+          ->GetURLLoaderFactoryForBrowserProcess().get(),
+      base::BindOnce(&EmberSelectionPopup::OnRatesFetched,
+                     weak_ptr_factory_.GetWeakPtr()),
+      kMaxRateResponseBytes);
+}
+
+void EmberSelectionPopup::OnRatesFetched(std::optional<std::string> body) {
+  rates_loader_.reset();
+  if (!body) {
+    return;
+  }
+  std::optional<base::Value> parsed = base::JSONReader::Read(*body, 0);
+  if (!parsed || !parsed->is_dict()) {
+    return;
+  }
+  const base::DictValue& table = parsed->GetDict();
+  const std::string* base = table.FindString("base");
+  if (!base || *base != "EUR" ||
+      !table.FindDict("rates") || table.FindDict("rates")->empty()) {
+    return;
+  }
+  rates_ = table.Clone();
+  rates_fetched_at_ = base::Time::Now();
+  base::DictValue saved;
+  saved.Set("table", rates_.Clone());
+  saved.Set("fetched_at", rates_fetched_at_.InSecondsFSinceUnixEpoch());
+  browser_view_->browser()->profile()->GetPrefs()->SetDict(
+      prefs::kEmberConversionRates, std::move(saved));
+  if (source_contents_ && !selected_text_.empty()) {
+    Evaluate();
+  }
+}
+
+void EmberSelectionPopup::Copy(const std::u16string& text,
+                               const ui::Event& event) {
+  ui::ScopedClipboardWriter(ui::ClipboardBuffer::kCopyPaste).WriteText(text);
+  Hide();
+}
+
+void EmberSelectionPopup::OnBubbleClosing(uint64_t generation) {
+  if (generation == generation_) {
+    bubble_ = nullptr;
+  }
+}
+
+void EmberSelectionPopup::Hide() {
+  ++generation_;
+  selection_timer_.Stop();
+  source_contents_ = nullptr;
+  selected_text_.clear();
+  if (bubble_) {
+    views::Widget* closing = bubble_;
+    bubble_ = nullptr;
+    closing->Close();
+  }
+}
+
+void EmberSelectionPopup::Relayout() {
+  if (bubble_ && source_contents_) {
+    content::RenderFrameHost* frame =
+        content::RenderFrameHost::FromID(frame_id_);
+    if (!frame || content::WebContents::FromRenderFrameHost(frame) !=
+                      source_contents_) {
+      Hide();
+      return;
+    }
+    const auto selection = source_contents_->GetTextSelectionBounds(frame);
+    if (!selection || selection->IsEmpty()) {
+      Hide();
+      return;
+    }
+    selection_bounds_ = *selection;
+    const gfx::Rect bounds =
+        PlaceBubble(source_contents_, selection_bounds_, bubble_size_);
+    if (bounds.IsEmpty()) {
+      Hide();
+    } else {
+      bubble_->SetBounds(bounds);
+    }
+  }
+}
+
+}  // namespace ember
