+class ConversionCopyButton final : public views::Button {
+ public:
+  explicit ConversionCopyButton(PressedCallback callback)
+      : views::Button(std::move(callback)), hover_animation_(this) {
+    SetPreferredSize(gfx::Size(kWidth - 24, 28));
+    SetFocusBehavior(views::View::FocusBehavior::ALWAYS);
+    GetViewAccessibility().SetName(u"Copy converted value");
+    hover_animation_.SetSlideDuration(base::Milliseconds(100));
+    auto* label = AddChildView(std::make_unique<views::Label>(u"Copy"));
+    label->SetFontList(FontForStyle(TextStyle::kSecondary));
+    label->SetCanProcessEventsWithinSubtree(false);
+    SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kHorizontal,
+        gfx::Insets(), 0))
+        ->set_main_axis_alignment(
+            views::BoxLayout::MainAxisAlignment::kCenter);
+  }
+
+  void StateChanged(ButtonState old_state) override {
+    views::Button::StateChanged(old_state);
+    const bool active = GetState() == STATE_HOVERED ||
+                        GetState() == STATE_PRESSED;
+    if (gfx::Animation::PrefersReducedMotion()) {
+      hover_animation_.Reset(active ? 1.0 : 0.0);
+    } else if (active) {
+      hover_animation_.Show();
+    } else {
+      hover_animation_.Hide();
+    }
+    SchedulePaint();
+  }
+
+  void AnimationProgressed(const gfx::Animation* animation) override {
+    views::Button::AnimationProgressed(animation);
+    SchedulePaint();
+  }
+
+  void OnPaintBackground(gfx::Canvas* canvas) override {
+    const int alpha = GetState() == STATE_PRESSED
+                          ? 62
+                          : 12 + static_cast<int>(36 * hover_animation_.GetCurrentValue());
+    cc::PaintFlags fill;
+    fill.setAntiAlias(true);
+    fill.setColor(SkColorSetARGB(alpha, 255, 255, 255));
+    canvas->DrawRoundRect(gfx::RectF(GetLocalBounds()), 8, fill);
+  }
+
+ private:
+  gfx::SlideAnimation hover_animation_;
+};
+
+constexpr net::NetworkTrafficAnnotationTag kRatesTrafficAnnotation =
+    net::DefineNetworkTrafficAnnotation("ember_selection_conversion_rates", R"(
+      semantics {
+        sender: "Ember selection conversions"
+        description: "Fetches a daily currency table after the user selects a recognized price."
+        trigger: "A selected currency amount differs from the preferred currency."
+        data: "No selected text or page URL; a fixed EUR rate-table request."
+        destination: WEBSITE
+      }
+      policy {
+        cookies_allowed: NO
+        setting: "Selection conversions can be disabled in Appearance settings."
+        policy_exception_justification: "No enterprise policy controls this request."
+      })");
+
+gfx::Rect PlaceBubble(content::WebContents* contents,
+                      const gfx::Rect& selection,
+                      const gfx::Size& size) {
+  gfx::Rect page = contents->GetViewBounds();
+  page.Inset(gfx::Insets(kGap));
+  const int width = std::min(size.width(), page.width());
+  const int height = std::min(size.height(), page.height());
+  if (width <= 0 || height <= 0) {
+    return gfx::Rect();
+  }
+  const int preferred_y = selection.y() - height - kGap;
+  const int fallback_y = selection.bottom() + kGap;
+  const int top = std::clamp(preferred_y >= page.y() ? preferred_y : fallback_y,
+                             page.y(), page.bottom() - height);
+  const int left = std::clamp(selection.x(), page.x(), page.right() - width);
+  return gfx::Rect(left, top, width, height);
+}
