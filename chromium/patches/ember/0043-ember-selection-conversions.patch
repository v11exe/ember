+  EmberSelectionPopup(const EmberSelectionPopup&) = delete;
+  EmberSelectionPopup& operator=(const EmberSelectionPopup&) = delete;
+  ~EmberSelectionPopup();
+
+  void Update(content::RenderFrameHost* frame, std::u16string_view selected_text);
+  void Hide();
+  void Relayout();
+
+ private:
+  void Evaluate();
+  void OnConverted(uint64_t generation, base::Value value);
+  void FetchRates();
+  void OnRatesFetched(std::optional<std::string> body);
+  base::DictValue ConversionPrefs() const;
+  void Copy(const std::u16string& text, const ui::Event& event);
+  void OnBubbleClosing(uint64_t generation);
+
+  raw_ptr<BrowserView> browser_view_;
+  raw_ptr<content::WebContents> source_contents_ = nullptr;
+  raw_ptr<views::Widget> bubble_ = nullptr;
+  content::GlobalRenderFrameHostId frame_id_;
+  std::u16string selected_text_;
+  gfx::Rect selection_bounds_;
+  gfx::Size bubble_size_;
+  base::OneShotTimer selection_timer_;
+  std::unique_ptr<network::SimpleURLLoader> rates_loader_;
+  base::DictValue rates_;
+  base::Time rates_fetched_at_;
+  base::Time next_rate_attempt_;
+  uint64_t generation_ = 0;
+  base::WeakPtrFactory<EmberSelectionPopup> weak_ptr_factory_{this};
+};
+
+}  // namespace ember
