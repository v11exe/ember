+views::View* EmberUtilityController::TargetForRect(views::View* root,
+                                                   const gfx::Rect& rect) {
+  if (root != this) {
+    return views::ViewTargeterDelegate::TargetForRect(root, rect);
+  }
+  // Route through the actual content, not the glass/shadow/capture wrapper.
+  // This also leaves native Slider pointer capture and Button hover dispatch
+  // with the selected descendant, rather than the full-window utility owner.
+  for (views::View* surface : {popover_body_.get(), snap_surface_.get()}) {
+    if (!surface || !surface->IsDrawn() ||
+        !surface->GetCanProcessEventsWithinSubtree()) {
+      continue;
+    }
+    gfx::RectF local(rect);
+    views::View::ConvertRectToTarget(this, surface, &local);
+    const gfx::Rect hit = gfx::ToEnclosingRect(local);
+    if (surface->HitTestRect(hit)) {
+      return surface->GetEventHandlerForRect(hit);
+    }
+  }
+  return this;
+}
