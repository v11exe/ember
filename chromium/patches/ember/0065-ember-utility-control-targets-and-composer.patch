 IN_PROC_BROWSER_TEST_F(BrowserViewTest,
+                       EmberUtilityRootRoutesToControlsAfterRepeatedLayout) {
+  using Utility = ember::EmberUtilityController::Utility;
+  auto* owner = browser_view()->ember_utilities();
+  auto* widget = browser_view()->GetWidget();
+  auto* anchor = owner->footer_for_testing()->children()[0].get();
+  gfx::Animation::SetPrefersReducedMotionForTesting(true);
+  for (int pass = 0; pass < 3; ++pass) {
+    owner->ShowVolume(active_web_contents(), anchor);
+    widget->GetRootView()->DeprecatedLayoutImmediately();
+    auto* slider = owner->volume_for_testing();
+    ASSERT_TRUE(slider);
+    gfx::Point point = slider->GetBoundsInScreen().CenterPoint();
+    views::View::ConvertPointFromScreen(widget->GetRootView(), &point);
+    EXPECT_EQ(slider, widget->GetRootView()->GetEventHandlerForPoint(point));
+    owner->Toggle(Utility::kMedia, anchor);
+    widget->GetRootView()->DeprecatedLayoutImmediately();
+    slider = owner->volume_for_testing();
+    ASSERT_TRUE(slider);
+    point = slider->GetBoundsInScreen().CenterPoint();
+    views::View::ConvertPointFromScreen(widget->GetRootView(), &point);
+    EXPECT_EQ(slider, widget->GetRootView()->GetEventHandlerForPoint(point));
+    auto* play = owner->media_action_for_testing(
+        int(media_session::mojom::MediaSessionAction::kPlay));
+    ASSERT_TRUE(play);
+    point = play->GetBoundsInScreen().CenterPoint();
+    views::View::ConvertPointFromScreen(widget->GetRootView(), &point);
+    EXPECT_EQ(play, widget->GetRootView()->GetEventHandlerForPoint(point));
+    owner->Close(false, true);
+  }
+  gfx::Animation::SetPrefersReducedMotionForTesting(false);
+}
