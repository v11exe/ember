+                       kColorExtensionsMenuText);
+  button->SetTextColor(views::Button::STATE_PRESSED,
+                       kColorExtensionsMenuText);
+  button->SetTextColor(views::Button::STATE_DISABLED,
+                       ui::kColorLabelForegroundDisabled);
+}
