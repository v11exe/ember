+void ConfigureMenuButtonIcon(HoverButton* button,
+                             const ui::ImageModel& image) {
+  button->SetImageModel(views::Button::STATE_NORMAL,
+                        RecolorMenuIcon(image, kColorExtensionsMenuSecondaryText));
+  button->SetImageModel(views::Button::STATE_HOVERED,
+                        RecolorMenuIcon(image, kColorExtensionsMenuText));
+  button->SetImageModel(views::Button::STATE_PRESSED,
+                        RecolorMenuIcon(image, kColorExtensionsMenuText));
+  button->SetImageModel(views::Button::STATE_DISABLED,
+                        RecolorMenuIcon(image, ui::kColorLabelForegroundDisabled));
+}
