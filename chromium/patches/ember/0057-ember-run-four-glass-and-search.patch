+IN_PROC_BROWSER_TEST_F(BrowserViewTest, EmberNeutralSuggestionRolesAndStates) {
+  browser_view()->ShowEmberSearch();
+  auto* controller = browser_view()->GetLocationBar()->GetOmniboxController();
+  controller->StopAutocomplete(true);
+  auto& result = const_cast<AutocompleteResult&>(
+      controller->autocomplete_controller()->result());
+  ACMatches matches;
+  for (int i = 0; i < 2; ++i) {
+    AutocompleteMatch match(nullptr, 1000 - i, false,
+                           AutocompleteMatchType::HISTORY_URL);
+    match.destination_url = GURL("https://example.test/");
+    match.contents = u"Example";
+    match.contents_class = {{0, ACMatchClassification::MATCH},
+                            {3, ACMatchClassification::NONE}};
+    // Empty description/classifications reproduces the diagnostic-red Search
+    // and domain fallback. A classified description covers URL/matched runs.
+    if (i) {
+      match.description = u"example.test";
+      match.description_class = {{0, ACMatchClassification::URL |
+                                      ACMatchClassification::MATCH}};
+    }
+    matches.push_back(match);
+  }
+  result.AppendMatches(matches);
+  auto* popup = static_cast<OmniboxPopupViewViews*>(
+      browser_view()->GetLocationBarView()->GetOmniboxPopupView());
+  popup->UpdatePopupAppearance();
+  std::vector<OmniboxMatchCellView*> cells;
+  std::vector<views::View*> pending{popup};
+  while (!pending.empty()) {
+    auto* view = pending.back();
+    pending.pop_back();
+    if (auto* cell = views::AsViewClass<OmniboxMatchCellView>(view))
+      cells.push_back(cell);
+    for (views::View* child : view->children()) pending.push_back(child);
+  }
+  ASSERT_GE(cells.size(), 2u);
+  for (size_t selected : {0u, 1u, 0u}) {
+    controller->edit_model()->SetPopupSelection(OmniboxPopupSelection(selected));
+    browser_view()->LayoutEmberSearch();
+    for (auto* cell : cells) {
+      auto* detail = cell->description();
+      if (detail->GetText().empty()) continue;
+      ASSERT_TRUE(detail->render_text_for_testing());
+      EXPECT_TRUE(gfx::test::RenderTextTestApi(
+          const_cast<gfx::RenderText*>(detail->render_text_for_testing()))
+          .colors().EqualsValueForTesting(
+          detail->GetColorProvider()->GetColor(kColorOmniboxResultsTextDimmed)));
+      EXPECT_GT(detail->y(), cell->content()->bounds().bottom());
+      const int width = detail->width();
+      auto* row = cell->parent()->parent()->parent()->parent();
+      ui::MouseEvent enter(ui::EventType::kMouseEntered, gfx::Point(),
+          gfx::Point(), base::TimeTicks::Now(), ui::EF_NONE, ui::EF_NONE);
+      row->OnMouseEntered(enter);
+      browser_view()->LayoutEmberSearch();
+      EXPECT_EQ(width, detail->width());
+    }
+  }
+  browser_view()->CloseEmberSearch();
+}
