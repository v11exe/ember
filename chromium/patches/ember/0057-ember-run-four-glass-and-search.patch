+void StartEmberGlassBackdropCapture(views::View* owner,
+                                   content::WebContents* source,
+                                   EmberBackdropUpdate update) {
+  StopEmberGlassBackdropCapture(owner);
+  auto capture = std::make_unique<EmberBackdropCapture>(
+      owner, source, std::move(update));
+  auto* raw = capture.get();
+  std::unique_ptr<views::View> capture_view = std::move(capture);
+  owner->AddChildView(std::move(capture_view));
+  owner->SetProperty(kEmberBackdropCapture, static_cast<views::View*>(raw));
+  raw->Start();
 }
 
