+// One stream targets the requesting renderer frame sink, never the browser
+// compositor (which would feed the overlay back into its own material).
+class EmberBackdropCapture final : public views::View,
+                                  public views::ViewObserver,
+                                  public views::WidgetObserver,
+                                  public content::WebContentsObserver {
+ public:
+  EmberBackdropCapture(views::View* owner, content::WebContents* source,
+                       EmberBackdropUpdate update)
+      : content::WebContentsObserver(source), owner_(owner),
+        update_(std::move(update)) {
+    SetCanProcessEventsWithinSubtree(false);
+    owner_->AddObserver(this);
+    widget_ = owner_->GetWidget();
+    if (widget_) widget_->AddObserver(this);
+  }
+  ~EmberBackdropCapture() override {
+    capturer_.reset();
+    if (owner_) owner_->RemoveObserver(this);
+    if (widget_) widget_->RemoveObserver(this);
+  }
+  void Start() {
+    if (!web_contents() || !owner_ || !owner_->IsDrawn()) return;
+    auto* frame = web_contents()->GetPrimaryMainFrame();
+    auto* view = frame ? frame->GetView() : nullptr;
+    if (!view || view->GetViewBounds().IsEmpty()) return;
+    renderer_bounds_ = view->GetViewBounds();
+    ThumbnailCaptureInfo info;
+    // One output pixel per DIP gives spatially correct sampling at every DPI.
+    info.source_size = renderer_bounds_.size();
+    info.copy_rect = gfx::Rect(info.source_size);
+    info.target_size = info.source_size;
+    capturer_ = std::make_unique<BackgroundThumbnailVideoCapturer>(
+        web_contents(), base::BindRepeating(&EmberBackdropCapture::Frame,
+            weak_factory_.GetWeakPtr()), base::Milliseconds(125));
+    capturer_->Start(info);
+  }
+ private:
+  void Frame(const SkBitmap& bitmap, uint64_t) {
+    if (!owner_ || !owner_->IsDrawn() || !web_contents()) return;
+    auto* frame = web_contents()->GetPrimaryMainFrame();
+    auto* view = frame ? frame->GetView() : nullptr;
+    if (!view) return;
+    const gfx::Rect current = view->GetViewBounds();
+    if (current.size() != renderer_bounds_.size()) {
+      // Destroy the old consumer after its callback unwinds.
+      base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, base::BindOnce(&EmberBackdropCapture::Restart,
+                                   weak_factory_.GetWeakPtr()));
+      return;
+    }
+    renderer_bounds_ = current;
+    last_frame_ = bitmap;
+    update_.Run(last_frame_, renderer_bounds_);
+  }
+  void Restart() {
+    capturer_.reset();
+    last_frame_.reset();
+    Start();
+  }
+  void PrimaryPageChanged(content::Page&) override { Restart(); }
+  void WebContentsDestroyed() override {
+    capturer_.reset();
+    last_frame_.reset();
+    Observe(nullptr);
+  }
+  void OnViewVisibilityChanged(views::View*, views::View*, bool visible) override {
+    if (!visible) {
+      capturer_.reset();
+      last_frame_.reset();
+    }
+    // Reopening binds the then-current requesting page through StartCapture.
+    // Do not resume the previous tab's source during visibility propagation.
+  }
+  void OnViewBoundsChanged(views::View*) override {
+    // Retarget from the latest renderer pixels without stretching or polling.
+    if (!last_frame_.empty() && owner_ && owner_->IsDrawn()) {
+      auto* frame = web_contents() ? web_contents()->GetPrimaryMainFrame() : nullptr;
+      auto* view = frame ? frame->GetView() : nullptr;
+      if (view && view->GetViewBounds().size() == renderer_bounds_.size())
+        update_.Run(last_frame_, view->GetViewBounds());
+    }
+  }
+  void OnViewIsDeleting(views::View*) override {
+    capturer_.reset();
+    owner_->RemoveObserver(this);
+    owner_ = nullptr;
+  }
+  void OnWidgetBoundsChanged(views::Widget*, const gfx::Rect&) override {
+    OnViewBoundsChanged(owner_);
+  }
+  void OnWidgetDestroying(views::Widget*) override {
+    capturer_.reset();
+    widget_->RemoveObserver(this);
+    widget_ = nullptr;
+  }
+  raw_ptr<views::Widget> widget_ = nullptr;
+  raw_ptr<views::View> owner_;
+  EmberBackdropUpdate update_;
+  gfx::Rect renderer_bounds_;
+  SkBitmap last_frame_;
+  std::unique_ptr<BackgroundThumbnailVideoCapturer> capturer_;
+  base::WeakPtrFactory<EmberBackdropCapture> weak_factory_{this};
+};
 
