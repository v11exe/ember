+IN_PROC_BROWSER_TEST_F(BrowserViewTest, EmberGlassReceivesContentOnlyDamage) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), GURL(
+      "data:text/html,<body style='margin:0;background:%2300ff00'>")));
+  auto* contents = browser_view()->GetActiveWebContents();
+  base::test::ScopedRunLoopTimeout timeout(FROM_HERE, base::Seconds(10));
+  SkColor expected = SK_ColorGREEN;
+  base::RunLoop first;
+  base::RunLoop second;
+  base::RepeatingClosure ready = first.QuitClosure();
+  int frames = 0;
+  ember::StartEmberGlassBackdropCapture(
+      browser_view(), contents, base::BindRepeating(
+          [](SkColor* expected, base::RepeatingClosure* ready, int* frames,
+             const SkBitmap& bitmap, const gfx::Rect& renderer_bounds) {
+            if (bitmap.width() > 20 && bitmap.height() > 20 &&
+                bitmap.getColor(20, 20) == *expected) {
+              ++*frames;
+              ready->Run();
+            }
+          }, &expected, &ready, &frames));
+  first.Run();
+  expected = SK_ColorBLUE;
+  ready = second.QuitClosure();
+  ASSERT_TRUE(content::ExecJs(contents,
+      "document.body.style.background = '#0000ff'"));
+  second.Run();
+  EXPECT_GE(frames, 2);
+  ember::StopEmberGlassBackdropCapture(browser_view());
+}
