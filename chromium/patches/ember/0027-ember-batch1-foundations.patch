+#if BUILDFLAG(IS_WIN)
+void BrowserView::UpdateEmberNativeBackdrop(WebContents* contents) {
+  views::Widget* widget = GetWidget();
+  if (!widget || !GetIsNormalType()) return;
+  HWND hwnd = views::HWNDForWidget(widget);
+  if (!hwnd) return;
+
+  // The only page allowed to expose the native material in this batch is the
+  // Ember New Tab WebUI. Future internal pages can extend this predicate.
+  if (contents != GetActiveWebContents()) contents = GetActiveWebContents();
+  const GURL url = contents ? contents->GetLastCommittedURL() : GURL();
+  const bool active = url.SchemeIs(content::kChromeUIScheme) &&
+      (url.host() == chrome::kChromeUINewTabPageThirdPartyHost ||
+       url.host() == chrome::kChromeUINewTabHost);
+  // ContentsWebView owns an opaque kColorWebContentsBackground layer behind
+  // the renderer. Clear it for Ember's transparent WebUI as well as the HWND;
+  // otherwise the native acrylic is covered by a flat #3c3c3c rectangle.
+  if (auto* view = contents_web_view()) view->SetBackgroundVisible(!active);
+
+  // BrowserView normally paints an opaque frame-theme background beneath the
+  // WebContents. Remove that backing only for the NTP so its transparent
+  // renderer can reveal DWM's material. Recreate it before attaching an
+  // ordinary page; otherwise transparent areas in a website expose the HWND.
+  SetBackground(active ? nullptr : std::make_unique<ThemedBackground>(
+                                      this, ThemedBackground::kFrameTheme));
+
+  // Use the supported Windows 11 backdrop API. The legacy AccentPolicy
+  // acrylic filters the already-composited HWND and feeds Ember's transparent
+  // renderer back into subsequent frames, producing the recursive logo/search
+  // trails. DWMSBT_TRANSIENTWINDOW paints acrylic behind the client surface.
+  constexpr int kDwmwaSystemBackdropType = 38;
+  constexpr int kDwmSystemBackdropAuto = 0;
+  constexpr int kDwmSystemBackdropTransientWindow = 3;
+  const int backdrop_type =
+      active ? kDwmSystemBackdropTransientWindow : kDwmSystemBackdropAuto;
+  // Chromium owns this ordinary HWND. Clear only its compositor background
+  // while Ember's own transparent New Tab WebUI is visible; websites retain
+  // the normal opaque browser background and their own page paints.
+  // Widget::SetBackgroundColor() accepts a ColorId, not an SkColor. Passing
+  // SK_ColorTRANSPARENT there resolves palette entry zero and leaves an opaque
+  // compositor clear behind the page. Set the native widget's real SkColor so
+  // the renderer's transparent pixels reach DWM.
+  widget->native_widget_private()->SetBackgroundColor(
+      active ? SK_ColorTRANSPARENT
+             : widget->GetColorProvider()->GetColor(kColorToolbar));
+  const SkColor compositor_color =
+      active ? SK_ColorTRANSPARENT
+             : widget->GetColorProvider()->GetColor(kColorToolbar);
+  widget->GetCompositor()->SetBackgroundColor(compositor_color);
+  if (aura::Window* native_window = widget->GetNativeWindow()) {
+    native_window->SetTransparent(active);
+    if (aura::Window* root_window = native_window->GetRootWindow())
+      root_window->SetTransparent(active);
+  }
+  ember_native_backdrop_active_ = active;
+  ember_native_backdrop_initialized_ = true;
+  MARGINS margins = active ? MARGINS{-1, -1, -1, -1}
+                           : MARGINS{0, 0, 0, 0};
+  DwmExtendFrameIntoClientArea(hwnd, &margins);
+  // Let Chromium's HWND handler retain the same DWM margin mode through
+  // subsequent frame changes, and restore normal margins on exit.
+  SetWindowPos(hwnd, nullptr, 0, 0, 0, 0,
+               SWP_NOMOVE | SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE |
+                   SWP_FRAMECHANGED);
+  // A frame-mode change can reset the system backdrop. Apply the requested
+  // type last so normal, maximized and restored NTPs converge on one state.
+  DwmSetWindowAttribute(
+      hwnd, static_cast<DWMWINDOWATTRIBUTE>(kDwmwaSystemBackdropType),
+      &backdrop_type, sizeof(backdrop_type));
+}
