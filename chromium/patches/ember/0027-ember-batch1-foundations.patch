+        ->Classify(AutocompleteInput::SanitizeString(base::UTF8ToUTF16(*text)),
+                   false, false, metrics::OmniboxEventProto::INVALID_SPEC,
+                   &match, nullptr);
+    if (!match.destination_url.is_valid() ||
+        match.destination_url.SchemeIs("javascript")) {
+      return;
+    }
+    browser->OpenGURL(match.destination_url,
+                      WindowOpenDisposition::CURRENT_TAB);
+  }
