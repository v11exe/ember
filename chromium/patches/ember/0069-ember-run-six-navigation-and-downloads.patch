+  load.initiator_process_id = opener->GetProcess()->GetDeprecatedID();
+  load.initiator_origin = opener->GetLastCommittedOrigin();
+  load.source_site_instance = opener->GetSiteInstance();
+  load.is_renderer_initiated = true;
+  load.has_user_gesture = true;
+  load.transition_type = ui::PAGE_TRANSITION_LINK;
+  load.download_policy = params.download_policy;
+  load.impression = params.impression;
+  load.was_opener_suppressed = true;
+  // Reusing an unrelated browsing context never grants the source a new
+  // WindowProxy/opener relationship. window.open returns null after routing.
+  destination->GetController().LoadURLWithParams(load);
+  return true;
+}
