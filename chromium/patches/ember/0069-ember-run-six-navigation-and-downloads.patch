+    content::RenderFrameHost* opener,
+    const content::mojom::CreateNewWindowParams& params) {
+  auto* source = content::WebContents::FromRenderFrameHost(opener);
+  auto* destination = ember::GetSplitFollower(source);
+  if (!destination || !params.started_with_transient_activation ||
+      params.is_form_submission || params.form_submission_post_data ||
+      !params.target_url.SchemeIsHTTPOrHTTPS() ||
