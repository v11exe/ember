+class EmberPageState::Toast {
+ public:
+  Toast(EmberPageState* state, BrowserView* browser) : owner_(state) {
+    auto* contents = state->web_contents();
+    const gfx::Rect page = contents->GetViewBounds();
+    const int width = std::min(400, page.width() - 16);
+    if (width < 260 || page.height() < 80) {
+      return;
+    }
+    gfx::Rect panel(page.x() + (page.width() - width) / 2, page.bottom() - 64,
+                    width, 44);
+    gfx::Rect bounds = panel;
+    bounds.Outset(EmberGlassView::kShadowMargin);
+    widget_ = std::make_unique<ReadingWidget>();
+    views::Widget::InitParams params(
+        views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+        views::Widget::InitParams::TYPE_BUBBLE);
+    params.parent = browser->GetWidget()->GetNativeView();
+    params.context = params.parent;
+    params.opacity = views::Widget::InitParams::WindowOpacity::kTranslucent;
+    params.activatable = views::Widget::InitParams::Activatable::kYes;
+    params.shadow_type = views::Widget::InitParams::ShadowType::kNone;
+    params.bounds = bounds;
+    params.name = "EmberReadingPosition";
+    widget_->Init(std::move(params));
+    auto* client = widget_->GetClientContentsView();
+    client->SetLayoutManager(std::make_unique<views::FillLayout>());
+    auto weak = state->weak_.GetWeakPtr();
+    auto dismiss = base::BindRepeating(
+        [](base::WeakPtr<EmberPageState> state) {
+          if (state) {
+            state->HideToast();
+          }
+        },
+        weak);
+    surface_ = client->AddChildView(std::make_unique<ReadingSurface>(dismiss));
+    surface_->SetBoundsRect(gfx::Rect(bounds.size()));
+    auto* body = surface_->contents();
+    const auto local = surface_->GetPanelBounds();
+    auto* label = body->AddChildView(
+        std::make_unique<views::Label>(u"Return to reading position"));
+    label->SetFontList(FontForStyle(TextStyle::kSecondary));
+    label->SetEnabledColor(SK_ColorWHITE);
+    label->SetBackgroundColor(SK_ColorTRANSPARENT);
+    label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    label->SetBounds(local.x() + 12, local.y() + 8, width - 126, 28);
+    action_ = body->AddChildView(std::make_unique<views::LabelButton>(
+        base::BindRepeating(
+            [](base::WeakPtr<EmberPageState> state) {
+              if (state) {
+                state->ReturnToReading();
+              }
+            },
+            weak),
+        u"Return"));
+    action_->SetEnabledTextColors(SK_ColorWHITE);
+    action_->SetBounds(local.right() - 108, local.y() + 6, 72, 32);
+    action_->SetFocusBehavior(views::View::FocusBehavior::ALWAYS);
+    dismiss_ =
+        body->AddChildView(std::make_unique<views::LabelButton>(dismiss, u"×"));
+    dismiss_->GetViewAccessibility().SetName(u"Dismiss reading position");
+    dismiss_->SetEnabledTextColors(SK_ColorWHITE);
+    dismiss_->SetBounds(local.right() - 36, local.y() + 6, 32, 32);
+    widget_->ShowInactive();
+    // EmberGlassView owns its panel paint and mask; update that material rather
+    // than installing a second native-bubble background underneath it.
+    auto material = std::make_shared<EmberGlassMaterial>();
+    auto generation = std::make_shared<uint64_t>(0);
+    StartEmberGlassBackdropCapture(
+        surface_, contents,
+        base::BindRepeating(
+            [](EmberGlassView* surface,
+               std::shared_ptr<EmberGlassMaterial> material,
+               std::shared_ptr<uint64_t> generation, const SkBitmap& bitmap,
+               const gfx::Rect& renderer_bounds) {
+              gfx::Rect sample = surface->GetPanelBounds();
+              sample.Offset(surface->GetBoundsInScreen().origin() -
+                            renderer_bounds.origin());
+              sample.Inset(-EmberGlassView::kBackdropMargin);
+              const auto* panel = material->RenderPanel(
+                  bitmap, sample, ++*generation, EmberGlassPreset::kPopover);
+              if (panel) {
+                surface->SetPanel(*panel);
+              }
+            },
+            base::Unretained(surface_.get()), material, generation));
+    surface_->OpenFrom(
+        gfx::Point(width / 2 + EmberGlassView::kShadowMargin, local.bottom()));
+    surface_->GetViewAccessibility().AnnounceText(
+        u"Return to reading position. Return action available.");
+    last_tick_ = base::TimeTicks::Now();
+    timer_.Start(FROM_HERE, base::Milliseconds(100),
+                 base::BindRepeating(&Toast::Tick, base::Unretained(this)));
+  }
+  ~Toast() {
+    timer_.Stop();
+    widget_.reset();
+  }
+  views::Widget* widget() const { return widget_.get(); }
+
+ private:
+  void Tick() {
+    if (!widget_ || widget_->IsClosed()) {
+      timer_.Stop();
+      base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, base::BindOnce(
+                         [](base::WeakPtr<Toast> toast) {
+                           if (toast) {
+                             toast->owner_->HideToast();
+                           }
+                         },
+                         weak_.GetWeakPtr()));
+      return;
+    }
+    auto now = base::TimeTicks::Now();
+    auto* focused = widget_->GetFocusManager()->GetFocusedView();
+    const bool paused =
+        surface_->IsMouseHovered() || action_->IsMouseHovered() ||
+        dismiss_->IsMouseHovered() || (focused && surface_->Contains(focused));
+    if (!paused) {
+      remaining_ -= now - last_tick_;
+    }
+    last_tick_ = now;
+    // Follow the owning pane on resize, without retargeting another tab.
+    const auto page = owner_->web_contents()->GetViewBounds();
+    if (owner_->web_contents()->GetVisibility() !=
+            content::Visibility::VISIBLE ||
+        remaining_ <= base::TimeDelta() || page.width() < 276) {
+      timer_.Stop();
+      surface_->CloseAnimated(base::BindOnce(
+          [](base::WeakPtr<Toast> toast) {
+            if (toast) {
+              toast->owner_->HideToast();
+            }
+          },
+          weak_.GetWeakPtr()));
+      return;
+    }
+    gfx::Rect bounds = widget_->GetWindowBoundsInScreen();
+    bounds.set_x(page.x() + (page.width() - bounds.width()) / 2);
+    bounds.set_y(page.bottom() - 64 - EmberGlassView::kShadowMargin);
+    widget_->SetBounds(bounds);
+  }
+  raw_ptr<EmberPageState> owner_;
+  std::unique_ptr<views::Widget> widget_;
+  raw_ptr<ReadingSurface> surface_ = nullptr;
+  raw_ptr<views::LabelButton> action_ = nullptr, dismiss_ = nullptr;
+  base::RepeatingTimer timer_;
+  base::TimeDelta remaining_ = base::Seconds(5);
+  base::TimeTicks last_tick_;
+  base::WeakPtrFactory<Toast> weak_{this};
+};
