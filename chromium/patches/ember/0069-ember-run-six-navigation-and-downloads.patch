+  EXPECT_EQ(menu.GetLabelForCommandId(100), u"Stop top pane following");
+  data->ClearEmberFollower();
+  data->SetEmberFollower(follower);
+  EXPECT_GT(data->ember_follower_generation(), epoch);
+  model->RemoveSplit(id);
+  EXPECT_FALSE(ember::GetSplitFollower(source));
+  EXPECT_FALSE(menu.IsCommandIdEnabled(101));
+  menu.ExecuteCommand(101, 0);
