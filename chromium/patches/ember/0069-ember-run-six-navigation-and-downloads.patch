+void EmberPageState::Execute(const std::string& operation,
+                             base::Value argument,
+                             base::OnceCallback<void(base::Value)> callback) {
+  auto* frame = web_contents()->GetPrimaryMainFrame();
+  if (!web_contents()->GetLastCommittedURL().SchemeIsHTTPOrHTTPS() || !frame ||
+      !frame->IsRenderFrameLive()) {
+    std::move(callback).Run(base::Value());
+    return;
+  }
+  std::string script =
+      ui::ResourceBundle::GetSharedInstance().LoadDataResourceString(
+          IDR_EMBER_PAGE_STATE);
+  script += "\n;globalThis.__emberPageState." + operation + "(" +
+            base::WriteJson(argument).value_or("null") + ");";
+  frame->ExecuteJavaScriptInIsolatedWorld(base::UTF8ToUTF16(script),
+                                          std::move(callback),
+                                          ISOLATED_WORLD_ID_CHROME_INTERNAL);
+}
+void EmberPageState::SetText(std::u16string text) {
+  text_ = text.substr(0, 65536);
+  auto& owners = CacheOwners();
+  std::erase_if(owners, [this](const auto& owner) {
+    return !owner || owner.get() == this;
+  });
+  if (text_.empty()) {
+    return;
+  }
+  // At most 64 x 64K UTF-16 characters (8 MiB), process-local, including OTR.
+  while (owners.size() >= 64) {
+    if (owners.front()) {
+      owners.front()->text_.clear();
+    }
+    owners.pop_front();
+  }
+  owners.push_back(weak_.GetWeakPtr());
+}
+void EmberPageState::UpdateIndex() {
+  if (index_pending_ || web_contents()->IsLoading() ||
+      !web_contents()->GetLastCommittedURL().SchemeIsHTTPOrHTTPS()) {
+    return;
+  }
+  auto* frame = web_contents()->GetPrimaryMainFrame();
+  if (!frame || !frame->IsRenderFrameLive()) {
+    return;  // Never wake a discarded renderer.
+  }
+  index_pending_ = true;
+  const auto document = frame->GetWeakDocumentPtr();
+  const auto generation = generation_;
+  Execute(
+      "index", base::Value(),
+      base::BindOnce(
+          [](base::WeakPtr<EmberPageState> state,
+             content::WeakDocumentPtr document, uint64_t generation,
+             base::Value result) {
+            if (!state || generation != state->generation_) {
+              return;
+            }
+            state->index_pending_ = false;
+            if (!document.AsRenderFrameHostIfValid() || !result.is_dict()) {
+              return;
+            }
+            const auto* url = result.GetDict().FindString("url");
+            const auto* text = result.GetDict().FindString("text");
+            if (!url ||
+                GURL(*url) != state->web_contents()->GetLastCommittedURL() ||
+                !text) {
+              return;
+            }
+            state->cache_url_ = GURL(*url);
+            state->SetText(base::UTF8ToUTF16(*text));
+          },
+          weak_.GetWeakPtr(), document, generation));
+}
+void EmberPageState::SnapshotReload(int64_t navigation_id,
+                                    base::OnceClosure resume) {
+  reload_id_ = navigation_id;
+  const auto generation = generation_;
+  const auto url = web_contents()->GetLastCommittedURL();
+  auto* frame = web_contents()->GetPrimaryMainFrame();
+  const auto document = frame->GetWeakDocumentPtr();
+  Execute("snapshot", base::Value(),
+          base::BindOnce(
+              [](base::WeakPtr<EmberPageState> state, uint64_t generation,
+                 int64_t id, GURL url, content::WeakDocumentPtr document,
+                 base::OnceClosure resume, base::Value value) {
+                if (state && generation == state->generation_ &&
+                    state->reload_id_ == id &&
+                    state->web_contents()->GetLastCommittedURL() == url &&
+                    document.AsRenderFrameHostIfValid() && value.is_dict()) {
+                  const auto* saved_url = value.GetDict().FindString("url");
+                  const auto y = value.GetDict().FindDouble("y");
+                  const auto integer_y = value.GetDict().FindInt("y");
+                  if (saved_url && GURL(*saved_url) == url &&
+                      ((y && *y >= 32) || (integer_y && *integer_y >= 32))) {
+                    state->reading_snapshot_ = std::move(value);
+                  }
+                }
+                std::move(resume).Run();
+              },
+              weak_.GetWeakPtr(), generation, navigation_id, url, document,
+              std::move(resume)));
+}
+void EmberPageState::DidStartNavigation(content::NavigationHandle* handle) {
+  if (!handle->IsInPrimaryMainFrame()) {
+    return;
+  }
+  ++generation_;
+  index_pending_ = false;
+  HideToast();
+  reading_snapshot_ = base::Value();
+  reload_succeeded_ = false;
+  reload_id_ = -1;
+  SetText(std::u16string());
+  if (!pending_find_.empty() && (handle->GetURL() != pending_find_url_ ||
+                                 !web_contents()->WasDiscarded())) {
+    pending_find_.clear();
+  }
+}
+void EmberPageState::DidFinishNavigation(content::NavigationHandle* handle) {
+  if (!handle->IsInPrimaryMainFrame() || !handle->HasCommitted()) {
+    return;
+  }
+  reload_succeeded_ =
+      handle->GetNavigationId() == reload_id_ && !handle->IsErrorPage() &&
+      handle->GetReloadType() != content::ReloadType::NONE &&
+      reading_snapshot_.is_dict() &&
+      reading_snapshot_.GetDict().FindString("url") &&
+      GURL(*reading_snapshot_.GetDict().FindString("url")) == handle->GetURL();
+  if (reload_succeeded_) {
+    reading_deadline_ = base::TimeTicks::Now() + base::Seconds(5);
+  }
+  if (!pending_find_.empty() && handle->GetURL() != pending_find_url_) {
+    pending_find_.clear();
+  }
+}
+void EmberPageState::DidStopLoading() {
+  UpdateIndex();
+  if (reload_succeeded_) {
+    ShowReadingToast();
+  }
+  FindPassage();
+}
+void EmberPageState::OnVisibilityChanged(content::Visibility visibility) {
+  index_timer_.Start(FROM_HERE,
+                     visibility == content::Visibility::VISIBLE
+                         ? base::Seconds(3)
+                         : base::Seconds(30),
+                     this, &EmberPageState::UpdateIndex);
+  if (visibility == content::Visibility::VISIBLE) {
+    UpdateIndex();
+    if (reload_succeeded_ && base::TimeTicks::Now() < reading_deadline_) {
+      ShowReadingToast();
+    }
+  } else {
+    HideToast();
+  }
+}
+void EmberPageState::ShowReadingToast() {
+  if (toast_ ||
+      web_contents()->GetVisibility() != content::Visibility::VISIBLE) {
+    return;
+  }
+  auto* tab = tabs::TabInterface::MaybeGetFromContents(web_contents());
+  auto* browser = tab ? tab->GetBrowserWindowInterface() : nullptr;
+  auto* view =
+      browser ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr;
+  if (!view || !view->GetWidget()) {
+    return;
+  }
+  toast_ = std::make_unique<Toast>(this, view);
+  reload_succeeded_ = false;
+}
+void EmberPageState::ReturnToReading() {
+  if (reading_snapshot_.is_dict()) {
+    Execute("restore", reading_snapshot_.Clone(), base::DoNothing());
+  }
+  web_contents()->Focus();
+  HideToast();
+}
+views::Widget* EmberPageState::reading_toast_for_testing() const {
+  return toast_ ? toast_->widget() : nullptr;
+}
+void EmberPageState::HideToast() {
+  const bool focused =
+      toast_ && toast_->widget() && toast_->widget()->IsActive();
+  toast_.reset();
+  if (!focused || !web_contents()) {
+    return;
+  }
+  auto* tab = tabs::TabInterface::MaybeGetFromContents(web_contents());
+  auto* browser = tab ? tab->GetBrowserWindowInterface() : nullptr;
+  if (browser &&
+      browser->GetTabStripModel()->GetActiveWebContents() == web_contents() &&
+      web_contents()->GetVisibility() == content::Visibility::VISIBLE) {
+    web_contents()->Focus();
+  }
+}
+void EmberPageState::FindPassage() {
+  if (pending_find_.empty() || web_contents()->IsLoading()) {
+    return;
+  }
+  if (pending_find_url_ != web_contents()->GetLastCommittedURL()) {
+    pending_find_.clear();
+    return;
+  }
+  auto query = std::exchange(pending_find_, std::u16string());
+  Execute("find", base::Value(base::UTF16ToUTF8(query)), base::DoNothing());
+}
+bool EmberPageState::ActivateContentMatch(Profile* profile,
+                                          uint64_t identity,
+                                          uint64_t generation,
+                                          const GURL& url,
+                                          const std::u16string& query) {
+  for (auto* browser : GetAllBrowserWindowInterfaces()) {
+    if (browser->GetProfile() != profile) {
+      continue;
+    }
+    auto* model = browser->GetTabStripModel();
+    for (int index = 0; index < model->count(); ++index) {
+      auto* contents = model->GetWebContentsAt(index);
+      auto* state = FromWebContents(contents);
+      if (!state || state->identity_ != identity ||
+          state->generation_ != generation ||
+          contents->GetLastCommittedURL() != url) {
+        continue;
+      }
+      state->pending_find_ = query;
+      state->pending_find_url_ = url;
+      auto weak_state = state->weak_.GetWeakPtr();
+      auto weak_contents = contents->GetWeakPtr();
+      model->ActivateTabAt(index);
+      browser->GetWindow()->Activate();
+      if (weak_contents) {
+        weak_contents->Focus();
+      }
+      if (weak_state) {
+        weak_state->FindPassage();
+      }
+      return true;
+    }
+  }
+  return false;  // Stale acceptance never falls through to opening a duplicate.
+}
+void EmberPageState::CarryDiscardCache(content::WebContents* old_contents,
+                                       content::WebContents* new_contents) {
+  auto* old = FromWebContents(old_contents);
+  auto* replacement = FromWebContents(new_contents);
+  if (!old || !replacement || !new_contents->WasDiscarded()) {
+    return;
+  }
+  replacement->cache_url_ = old->cache_url_;
+  replacement->SetText(old->text_);
+}
