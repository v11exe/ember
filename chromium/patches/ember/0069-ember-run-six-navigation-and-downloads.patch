+uint64_t FollowerGeneration(content::WebContents* source) {
+  auto* tab = tabs::TabInterface::MaybeGetFromContents(source);
+  auto* browser = tab ? tab->GetBrowserWindowInterface() : nullptr;
+  if (!browser || !tab->GetSplit() ||
+      !browser->GetTabStripModel()->ContainsSplit(*tab->GetSplit())) {
+    return 0;
+  }
+  return browser->GetTabStripModel()
+      ->GetSplitData(*tab->GetSplit())
+      ->ember_follower_generation();
+}
