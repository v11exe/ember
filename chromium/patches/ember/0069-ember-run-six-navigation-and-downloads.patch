+
+void SplitTabData::ClearEmberFollower() {
+  ++ember_follower_generation_;
+  ember_source_.reset();
+  ember_follower_.reset();
+  ember_membership_subscriptions_.clear();
+}
+
+void SplitTabData::SetEmberFollower(content::WebContents* destination) {
+  ClearEmberFollower();
+  const auto tabs = ListTabs();
+  if (tabs.size() != 2 || !destination) {
+    return;
+  }
+  for (auto* tab : tabs) {
+    if (tab->GetContents() == destination) {
+      ember_follower_ = destination->GetWeakPtr();
+    } else {
+      ember_source_ = tab->GetContents()->GetWeakPtr();
+    }
+  }
+  if (!GetEmberFollower()) {
+    ClearEmberFollower();
+    return;
+  }
+  for (auto* tab : tabs) {
+    ember_membership_subscriptions_.push_back(
+        tab->RegisterWillDetach(base::BindRepeating(
+            [](SplitTabData* data, tabs::TabInterface*,
+               tabs::TabInterface::DetachReason) {
+              data->ClearEmberFollower();
+            },
+            base::Unretained(this))));
+    ember_membership_subscriptions_.push_back(
+        tab->RegisterWillDiscardContents(base::BindRepeating(
+            [](SplitTabData* data, tabs::TabInterface*, content::WebContents*,
+               content::WebContents*) { data->ClearEmberFollower(); },
+            base::Unretained(this))));
+  }
+}
+
+content::WebContents* SplitTabData::GetEmberFollower() const {
+  if (!ember_source_ || !ember_follower_) {
+    return nullptr;
+  }
+  const auto tabs = ListTabs();
+  if (tabs.size() != 2) {
+    return nullptr;
+  }
+  bool source = false, follower = false;
+  for (auto* tab : tabs) {
+    source |= tab->GetContents() == ember_source_.get();
+    follower |= tab->GetContents() == ember_follower_.get();
+  }
+  return source && follower ? ember_follower_.get() : nullptr;
+}
+
+content::WebContents* SplitTabData::GetEmberFollowerFor(
+    content::WebContents* source) const {
+  return source == ember_source_.get() ? GetEmberFollower() : nullptr;
 }
 
