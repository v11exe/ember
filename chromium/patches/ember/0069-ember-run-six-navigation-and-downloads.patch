+bool DownloadCommands::CanCopyDownloadAddress() const {
+  return model_ && model_->GetURL().is_valid() &&
+         model_->GetURL().SchemeIsHTTPOrHTTPS();
+}
+void DownloadCommands::CopyDownloadAddress() {
+  if (!CanCopyDownloadAddress()) {
+    return;
+  }
+  // DownloadItem's GetURL is the final file URL after redirects, not the
+  // referring webpage, original page link or local filesystem path.
+  ui::ScopedClipboardWriter writer(ui::ClipboardBuffer::kCopyPaste);
+  writer.WriteText(base::UTF8ToUTF16(model_->GetURL().spec()));
+}
