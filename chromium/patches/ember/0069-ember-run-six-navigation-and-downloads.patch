+class EmberNavigationThrottle : public content::NavigationThrottle {
+ public:
+  explicit EmberNavigationThrottle(
+      content::NavigationThrottleRegistry& registry)
+      : NavigationThrottle(registry) {}
+  const char* GetNameForLogging() override { return "EmberPairAndReading"; }
+  ThrottleCheckResult WillStartRequest() override {
+    auto* handle = navigation_handle();
+    auto* source = handle->GetWebContents();
+    if (!handle->IsInPrimaryMainFrame() || handle->IsSameDocument() ||
+        handle->IsPageActivation()) {
+      return PROCEED;
+    }
+    if (handle->GetReloadType() != content::ReloadType::NONE &&
+        handle->GetURL() == source->GetLastCommittedURL() &&
+        handle->GetURL().SchemeIsHTTPOrHTTPS()) {
+      auto* state = EmberPageState::FromWebContents(source);
+      if (!state || !source->GetPrimaryMainFrame() ||
+          !source->GetPrimaryMainFrame()->IsRenderFrameLive()) {
+        return PROCEED;
+      }
+      state->SnapshotReload(
+          handle->GetNavigationId(),
+          base::BindOnce(&EmberNavigationThrottle::ContinueReload,
+                         weak_.GetWeakPtr()));
+      // A hung renderer must never block ordinary reload indefinitely.
+      timeout_.Start(FROM_HERE, base::Milliseconds(400), this,
+                     &EmberNavigationThrottle::ContinueReload);
+      return DEFER;
+    }
+    auto* destination = GetSplitFollower(source);
+    if (!destination || !handle->WasInitiatedByLinkClick() ||
+        !handle->HasUserGesture() || handle->IsFormSubmission() ||
+        handle->IsPost() || !handle->GetURL().SchemeIsHTTPOrHTTPS() ||
+        handle->GetURL().GetWithoutRef() ==
+            source->GetLastCommittedURL().GetWithoutRef()) {
+      return PROCEED;
+    }
+    content::NavigationController::LoadURLParams load(handle->GetURL());
+    load.referrer = content::Referrer(handle->GetReferrer());
+    load.initiator_frame_token = handle->GetInitiatorFrameToken();
+    load.initiator_process_id = handle->GetInitiatorProcessId();
+    load.initiator_origin = handle->GetInitiatorOrigin();
+    load.initiator_base_url = handle->GetInitiatorBaseUrl();
+    load.initiator_navigation_state = handle->GetInitiatorNavigationState();
+    load.source_site_instance = handle->GetSourceSiteInstance();
+    load.is_renderer_initiated = handle->IsRendererInitiated();
+    load.has_user_gesture = handle->HasUserGesture();
+    load.transition_type = handle->GetPageTransition();
+    // Cancel before any network request. Revalidate pair ownership at dispatch,
+    // preserving the destination's native controller/security/redirect path.
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(
+            [](base::WeakPtr<content::WebContents> source,
+               base::WeakPtr<content::WebContents> destination,
+               split_tabs::SplitTabId pair_id, uint64_t pair_generation,
+               content::WeakDocumentPtr document,
+               content::NavigationController::LoadURLParams load) {
+              auto* tab =
+                  source
+                      ? tabs::TabInterface::MaybeGetFromContents(source.get())
+                      : nullptr;
+              if (source && destination && tab && tab->GetSplit() == pair_id &&
+                  document.AsRenderFrameHostIfValid() &&
+                  FollowerGeneration(source.get()) == pair_generation &&
+                  GetSplitFollower(source.get()) == destination.get()) {
+                destination->GetController().LoadURLWithParams(load);
+              }
+            },
+            source->GetWeakPtr(), destination->GetWeakPtr(),
+            tabs::TabInterface::MaybeGetFromContents(source)
+                ->GetSplit()
+                .value(),
+            FollowerGeneration(source),
+            source->GetPrimaryMainFrame()->GetWeakDocumentPtr(),
+            std::move(load)));
+    return CANCEL_AND_IGNORE;
+  }
+
+ private:
+  void ContinueReload() {
+    if (resumed_) {
+      return;
+    }
+    resumed_ = true;
+    timeout_.Stop();
+    Resume();
+  }
+  bool resumed_ = false;
+  base::OneShotTimer timeout_;
+  base::WeakPtrFactory<EmberNavigationThrottle> weak_{this};
+};
+}  // namespace
+
+content::WebContents* GetSplitFollower(content::WebContents* source) {
+  if (!source || source->IsBeingDestroyed()) {
+    return nullptr;
+  }
+  auto* tab = tabs::TabInterface::MaybeGetFromContents(source);
+  auto* browser = tab ? tab->GetBrowserWindowInterface() : nullptr;
+  if (!browser || !tab->GetSplit()) {
+    return nullptr;
+  }
+  auto* model = browser->GetTabStripModel();
+  if (!model->ContainsSplit(*tab->GetSplit())) {
+    return nullptr;
+  }
+  auto* destination =
+      model->GetSplitData(*tab->GetSplit())->GetEmberFollowerFor(source);
+  return destination && !destination->IsBeingDestroyed() &&
+                 destination->GetBrowserContext() == source->GetBrowserContext()
+             ? destination
+             : nullptr;
+}
+void AddEmberNavigationThrottle(content::NavigationThrottleRegistry& registry) {
+  if (registry.GetNavigationHandle().IsInPrimaryMainFrame()) {
+    registry.AddThrottle(std::make_unique<EmberNavigationThrottle>(registry));
+  }
+}
