 IN_PROC_BROWSER_TEST_F(BrowserViewTest,
+                       EmberMediaArtworkNormalizesDecodedPixels) {
+  // MediaSessionImpl converts downloaded artwork to RGBA. On Windows, passing
+  // that directly to ImageSkia used to hit a release CHECK asynchronously, even
+  // when the Media panel was closed and a background page supplied the image.
+  SkBitmap rgba;
+  ASSERT_TRUE(rgba.tryAllocPixels(
+      SkImageInfo::Make(2, 1, kRGBA_8888_SkColorType, kPremul_SkAlphaType)));
+  rgba.eraseColor(SkColorSetARGB(128, 220, 30, 10));
+  const auto artwork = ember::ConvertMediaArtwork(rgba);
+  ASSERT_FALSE(artwork.isNull());
+  const SkBitmap& native = artwork.GetRepresentation(1.f).GetBitmap();
+  EXPECT_EQ(kN32_SkColorType, native.colorType());
+  EXPECT_EQ(rgba.getColor(0, 0), native.getColor(0, 0));
+  EXPECT_EQ(gfx::Size(2, 1), artwork.size());
+  EXPECT_TRUE(native.isImmutable());
+  EXPECT_EQ(kRGBA_8888_SkColorType, rgba.colorType());
+
+  SkBitmap already_native;
+  already_native.allocN32Pixels(1, 1);
+  already_native.eraseColor(SK_ColorBLUE);
+  const auto retained = ember::ConvertMediaArtwork(already_native);
+  ASSERT_FALSE(retained.isNull());
+  EXPECT_EQ(SK_ColorBLUE,
+            retained.GetRepresentation(1.f).GetBitmap().getColor(0, 0));
+  EXPECT_TRUE(ember::ConvertMediaArtwork(SkBitmap()).isNull());
+  SkBitmap without_pixels;
+  ASSERT_TRUE(without_pixels.setInfo(
+      SkImageInfo::Make(2, 2, kRGBA_8888_SkColorType, kPremul_SkAlphaType)));
+  EXPECT_TRUE(ember::ConvertMediaArtwork(without_pixels).isNull());
+}
