+gfx::ImageSkia ConvertMediaArtwork(const SkBitmap& image) {
+  if (image.drawsNothing())
+    return {};
+  // MediaSession delivers RGBA pixels. ImageSkiaRep requires native N32
+  // (BGRA on Windows), even in release builds. Never reinterpret those bytes.
+  SkBitmap native;
+  const SkImageInfo info = image.info().makeColorType(kN32_SkColorType);
+  if (!native.tryAllocPixels(info) ||
+      !image.readPixels(info, native.getPixels(), native.rowBytes(), 0, 0))
+    return {};
+  native.setImmutable();
+  return gfx::ImageSkia::CreateFrom1xBitmap(native);
+}
