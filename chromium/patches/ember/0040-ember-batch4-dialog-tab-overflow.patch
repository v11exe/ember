 constexpr int kEmberTopChromeHeight = 32;
 
+}  // namespace
+
+// The strip stays as direct content. Layer scrolling and preferred-size layout
+// keep its bounds wider than the viewport when tabs overflow.
+class TabStripScrollContainer : public views::ScrollView {
+  METADATA_HEADER(TabStripScrollContainer, views::ScrollView)
+ public:
+  explicit TabStripScrollContainer(std::unique_ptr<TabStrip> strip)
+      : views::ScrollView(ScrollWithLayers::kEnabled) {
+    SetHorizontalScrollBarMode(ScrollBarMode::kHiddenButEnabled);
+    SetVerticalScrollBarMode(ScrollBarMode::kDisabled);
+    SetBackgroundColor(std::nullopt);
+    SetDrawOverflowIndicator(false);
+    SetUseContentsPreferredSize(true);
+    SetContents(std::move(strip));
+    contents()->layer()->SetFillsBoundsOpaquely(false);
+  }
+
+  gfx::Size GetMinimumSize() const override {
+    return gfx::Size(0, kEmberTopChromeHeight);
+  }
+
+  int AvailableTabWidth() const {
+    const auto* strip = static_cast<const TabStrip*>(contents());
+    return std::max({1, contents()->width(), GetVisibleRect().width(),
+                     strip->GetMinimumSize().width()});
+  }
+
+  bool OnMouseWheel(const ui::MouseWheelEvent& event) override {
+    const int delta = event.y_offset() ? event.y_offset() : event.x_offset();
+    const int maximum =
+        contents() ? std::max(0, contents()->width() - GetVisibleRect().width())
+                   : 0;
+    if (!delta || !maximum) {
+      return false;
+    }
+    const int step = std::clamp(std::abs(delta), 80, 360);
+    const int next = std::clamp(
+        static_cast<int>(CurrentOffset().x()) + (delta > 0 ? -step : step), 0,
+        maximum);
+    ScrollToOffset(gfx::PointF(next, 0));
+    return true;
+  }
+};
+
+BEGIN_METADATA(TabStripScrollContainer)
+END_METADATA
