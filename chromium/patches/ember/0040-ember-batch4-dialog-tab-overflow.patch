+void CenterDialogOnPage(views::Widget* widget, content::WebContents* contents) {
+  BrowserWindowInterface* browser =
+      GlobalBrowserCollection::GetInstance()->FindBrowserWithTab(contents);
+  BrowserView* browser_view =
+      browser ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr;
+  if (!browser_view || !browser_view->contents_container()) {
+    return;
+  }
+  const gfx::Rect page =
+      browser_view->contents_container()->GetBoundsInScreen();
+  if (page.IsEmpty()) {
+    return;
+  }
+  gfx::Rect bounds = widget->GetWindowBoundsInScreen();
+  bounds.set_origin(gfx::Point(page.CenterPoint().x() - bounds.width() / 2,
+                               page.CenterPoint().y() - bounds.height() / 2));
+  bounds.AdjustToFit(page);
+  widget->SetBounds(bounds);
+}
