-// Native Slider handles keyboard/accessibility and pointer capture; only paint
-// differs. Values remain continuous, and no page script is involved in audio.
+// A native owned widget gives utility controls their own input/focus root.
+// Retain EmberGlassView material and motion, including interrupted closes.
+class UtilityPopupSurface : public EmberGlassView {
+ public:
+  explicit UtilityPopupSurface(base::RepeatingClosure close)
+      : EmberGlassView(EmberGlassPreset::kPopover), close_(std::move(close)) {}
+  void AddedToWidget() override {
+    GetWidget()->GetNativeWindow()->AddPreTargetHandler(this);
+  }
+  void RemovedFromWidget() override {
+    if (GetWidget()) {
+      GetWidget()->GetNativeWindow()->RemovePreTargetHandler(this);
+    }
+  }
+  void OnKeyEvent(ui::KeyEvent* event) override {
+    if (event->type() == ui::EventType::kKeyPressed &&
+        event->key_code() == ui::VKEY_ESCAPE) {
+      event->SetHandled();
+      close_.Run();
+    } else {
+      EmberGlassView::OnKeyEvent(event);
+    }
+  }
+
+ private:
+  base::RepeatingClosure close_;
+};
