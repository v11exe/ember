+// A real, reusable WebContents in the current Profile. Website permissions are
+// still handled by Chromium; the embedding delegate grants none of its own.
+class EmberUtilityController::SnapPage : public views::WebView {
+ public:
+  METADATA_HEADER(SnapPage, views::WebView)
+ public:
+  SnapPage(Profile* profile, EmberUtilityController* owner)
+      : WebView(profile), owner_(owner) {
+    SetOwnedWebContents(content::WebContents::Create(
+        content::WebContents::CreateParams(profile)));
+    PrefsTabHelper::CreateForWebContents(web_contents());
+    permissions::PermissionRequestManager::CreateForWebContents(web_contents());
+    web_contents()->GetController().LoadURL(
+        GURL("https://chatgpt.com/"), content::Referrer(),
+        ui::PAGE_TRANSITION_AUTO_TOPLEVEL, std::string());
+  }
+  content::WebContents* OpenURLFromTab(
+      content::WebContents* source,
+      const content::OpenURLParams& params,
+      base::OnceCallback<void(content::NavigationHandle&)> callback) override {
+    if (params.disposition == WindowOpenDisposition::CURRENT_TAB) {
+      source->GetController().LoadURLWithParams(
+          content::NavigationController::LoadURLParams(params));
+      return source;
+    }
+    return handler_.OpenURLFromTab(web_contents()->GetBrowserContext(), source,
+                                   params, std::move(callback));
+  }
+  content::WebContents* AddNewContents(
+      content::WebContents* source,
+      std::unique_ptr<content::WebContents> contents,
+      const GURL& target,
+      WindowOpenDisposition disposition,
+      const blink::mojom::WindowFeatures& features,
+      bool gesture,
+      bool* blocked) override {
+    handler_.AddNewContents(web_contents()->GetBrowserContext(), source,
+                            std::move(contents), target, disposition, features,
+                            gesture);
+    return nullptr;
+  }
+  void RunFileChooser(content::RenderFrameHost* frame,
+                      scoped_refptr<content::FileSelectListener> listener,
+                      const blink::mojom::FileChooserParams& params) override {
+    handler_.RunFileChooser(frame, std::move(listener), params);
+  }
+  void CloseContents(content::WebContents*) override { owner_->Close(); }
+  bool HandleKeyboardEvent(content::WebContents*,
+                           const input::NativeWebKeyboardEvent&) override {
+    return false;
+  }
+
+ private:
+  ChromeWebContentsHandler handler_;
+  const raw_ptr<EmberUtilityController> owner_;
+};
