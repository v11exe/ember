+  EXPECT_EQ(1.0, factory.GetVolume());
+  factory.SetVolume(1.75);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_FALSE(stream_factory_.IsConnected());
+  base::UnguessableToken first_group;
+  for (auto broker : {first, second}) {
+    auto* frame = broker.get() == first.get() ? main_rfh() : other_rfh();
+    EXPECT_CALL(*broker, CreateStream(NotNull()));
+    mojo::PendingRemote<media::mojom::AudioOutputStreamProviderClient> client;
+    std::ignore = client.InitWithNewPipeAndPassReceiver();
+    factory.core()->CreateOutputStream(
+        frame->GetProcess()->GetDeprecatedID(), frame->GetRoutingID(),
+        frame->GetGlobalFrameToken(), kOutputDeviceId, kParams,
+        std::move(client));
+    base::RunLoop().RunUntilIdle();
+    EXPECT_DOUBLE_EQ(1.75, stream_factory_.volume_gain);
+    if (first_group.is_empty())
+      first_group = stream_factory_.volume_group;
+    EXPECT_EQ(first_group, stream_factory_.volume_group);
+    testing::Mock::VerifyAndClear(&*broker);
+    std::move(broker->deleter).Run(&*broker);
+    base::RunLoop().RunUntilIdle();
+    EXPECT_FALSE(stream_factory_.IsConnected());
+    EXPECT_DOUBLE_EQ(1.75, factory.GetVolume());
+  }
