+IN_PROC_BROWSER_TEST_F(BrowserViewTest,
+                       EmberUtilitiesKeepFiveFooterTargetsAndExclusiveState) {
+  using Utility = ember::EmberUtilityController::Utility;
+  auto* owner = browser_view()->ember_utilities();
+  ASSERT_TRUE(owner);
+  auto* footer = owner->footer_for_testing();
+  ASSERT_EQ(5u, footer->children().size());
+  auto* media = static_cast<ember::EmberUtilityButton*>(footer->children()[0]);
+  auto* workspace =
+      static_cast<ember::EmberUtilityButton*>(footer->children()[1]);
+  auto* snap = static_cast<ember::EmberUtilityButton*>(footer->children()[2]);
+  EXPECT_EQ(u"Media", media->GetTooltipText());
+  EXPECT_EQ(u"Workspaces", workspace->GetTooltipText());
+  EXPECT_EQ(u"ChatGPT Snap", snap->GetTooltipText());
+  EXPECT_EQ(u"Settings", footer->children()[4]->GetTooltipText());
+  for (const bool wide : {false, true}) {
+    browser()->profile()->GetPrefs()->SetBoolean(prefs::kEmberSidebarWide,
+                                                 wide);
+    browser_view()->GetWidget()->SetSize(gfx::Size(640, 360));
+    browser_view()->GetWidget()->GetRootView()->DeprecatedLayoutImmediately();
+    for (const auto& child : footer->children()) {
+      EXPECT_EQ(gfx::Size(36, 36), child->size());
+      EXPECT_TRUE(footer->GetLocalBounds().Contains(child->bounds()));
+      EXPECT_EQ(media->bounds().right(), child->bounds().right());
+    }
+    for (size_t i = 1; i < footer->children().size(); ++i)
+      EXPECT_EQ(4, footer->children()[i]->y() -
+                       footer->children()[i - 1]->bounds().bottom());
+  }
+  gfx::Animation::SetPrefersReducedMotionForTesting(true);
+  owner->Toggle(Utility::kWorkspaces, workspace);
+  EXPECT_EQ(Utility::kWorkspaces, owner->active());
+  ASSERT_TRUE(owner->layer());
+  EXPECT_FALSE(owner->layer()->fills_bounds_opaquely());
+  ASSERT_EQ(1u, owner->popover_content_for_testing()->children().size());
+  gfx::Point rail_edge = workspace->GetBoundsInScreen().right_center();
+  rail_edge.Offset(-1, 0);
+  views::View::ConvertPointFromScreen(owner, &rail_edge);
+  EXPECT_FALSE(
+      owner->DoesIntersectRect(owner, gfx::Rect(rail_edge, gfx::Size(1, 1))));
+  owner->Toggle(Utility::kMedia, media);
+  EXPECT_EQ(Utility::kMedia, owner->active());
+  EXPECT_FALSE(owner->volume_for_testing()->GetEnabled());
+  EXPECT_FALSE(owner->seek_for_testing()->GetEnabled());
+  owner->Toggle(Utility::kMedia, media);
+  EXPECT_EQ(Utility::kNone, owner->active());
+  owner->Toggle(Utility::kWorkspaces, workspace);
+  owner->BeforeExtensions();
+  EXPECT_EQ(Utility::kExtensions, owner->active());
+  browser_view()->ShowEmberSearch();
+  EXPECT_EQ(Utility::kNone, owner->active());
+  owner->Toggle(Utility::kWorkspaces, workspace);
+  EXPECT_FALSE(browser_view()->IsEmberSearchOpen());
+  ui::KeyEvent escape(ui::EventType::kKeyPressed, ui::VKEY_ESCAPE, ui::EF_NONE);
+  owner->OnKeyEvent(&escape);
+  EXPECT_EQ(Utility::kNone, owner->active());
+  EXPECT_TRUE(escape.handled());
+  gfx::Animation::SetPrefersReducedMotionForTesting(false);
+}
