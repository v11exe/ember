+EmberSquareFeedback::EmberSquareFeedback(views::View* owner) : owner_(owner) {
+  animation_.SetSlideDuration(base::Milliseconds(120));
+}
+void EmberSquareFeedback::Set(bool hovered, bool pressed, bool open) {
+  pressed_ = pressed;
+  open_ = open;
+  if (gfx::Animation::PrefersReducedMotion())
+    animation_.Reset(hovered ? 1 : 0);
+  else if (hovered)
+    animation_.Show();
+  else
+    animation_.Hide();
+  owner_->SchedulePaint();
+}
+void EmberSquareFeedback::AnimationProgressed(const gfx::Animation*) {
+  owner_->SchedulePaint();
+}
+void EmberSquareFeedback::Paint(gfx::Canvas* canvas) const {
+  const float amount = std::max(float(animation_.GetCurrentValue()),
+                                open_ || pressed_ ? 1.f : 0.f);
+  if (!amount)
+    return;
+  const int side = std::min({28, owner_->width(), owner_->height()});
+  const gfx::RectF rect((owner_->width() - side) / 2.f,
+                        (owner_->height() - side) / 2.f, side, side);
+  canvas->Save();
+  canvas->ClipRect(owner_->GetLocalBounds());
+  cc::PaintFlags fill;
+  fill.setAntiAlias(true);
+  fill.setColor(SkColorSetARGB((pressed_ ? 38
+                                : open_  ? 30
+                                         : 22) *
+                                   amount,
+                               255, 255, 255));
+  canvas->DrawRoundRect(rect, 6, fill);
+  fill.setStyle(cc::PaintFlags::kStroke_Style);
+  fill.setStrokeWidth(1);
+  fill.setColor(SkColorSetARGB(24 * amount, 255, 255, 255));
+  canvas->DrawRoundRect(rect, 6, fill);
+  canvas->Restore();
+}
+EmberUtilityButton::EmberUtilityButton(PressedCallback callback,
+                                       std::u16string name,
+                                       Glyph glyph)
+    : LabelButton(std::move(callback)), glyph_(glyph) {
+  SetPreferredSize(gfx::Size(36, 36));
+  SetHorizontalAlignment(gfx::ALIGN_CENTER);
+  SetAccessibleName(name);
+  SetTooltipText(name);
+  SetFocusBehavior(FocusBehavior::ALWAYS);
+  views::InkDrop::Get(this)->SetMode(views::InkDropHost::InkDropMode::OFF);
+  views::FocusRing::Install(this);
+  views::InstallRoundRectHighlightPathGenerator(this, gfx::Insets(4), 6);
+}
+void EmberUtilityButton::SetOpen(bool open) {
+  open_ = open;
+  feedback_.Set(GetState() == STATE_HOVERED, GetState() == STATE_PRESSED,
+                open_);
+}
+void EmberUtilityButton::StateChanged(ButtonState old_state) {
+  LabelButton::StateChanged(old_state);
+  feedback_.Set(GetState() == STATE_HOVERED, GetState() == STATE_PRESSED,
+                open_);
+}
+void EmberUtilityButton::OnThemeChanged() {
+  LabelButton::OnThemeChanged();
+  SetBackground(nullptr);
+}
+void EmberUtilityButton::OnPaintBackground(gfx::Canvas* canvas) {
+  feedback_.Paint(canvas);
+  if (glyph_ == Glyph::kNative)
+    return;
+  const float x = width() / 2.f, y = height() / 2.f;
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setColor(SkColorSetRGB(235, 237, 240));
+  flags.setStyle(cc::PaintFlags::kStroke_Style);
+  flags.setStrokeWidth(1.35);
+  if (glyph_ == Glyph::kWorkspace) {
+    for (int row = 0; row < 2; ++row)
+      for (int col = 0; col < 2; ++col)
+        canvas->DrawRoundRect(
+            gfx::RectF(x - 8 + col * 9, y - 8 + row * 9, 7, 7), 1.3, flags);
+    return;
+  }
+  // Capture frame plus the real knot as vector paths, legible at rail scale.
+  const std::string svg =
+      ui::ResourceBundle::GetSharedInstance().LoadDataResourceString(
+          IDR_EMBER_SNAP_MARK);
+  const size_t begin = svg.find("d=\"");
+  SkPath mark;
+  if (begin != std::string::npos) {
+    const size_t end = svg.find('"', begin + 3);
+    SkParsePath::FromSVGString(svg.substr(begin + 3, end - begin - 3).c_str(),
+                               &mark);
+  }
+  canvas->Save();
+  canvas->Translate(gfx::Vector2d(x - 6, y - 6));
+  canvas->Scale(.5f, .5f);
+  flags.setStyle(cc::PaintFlags::kFill_Style);
+  canvas->DrawPath(mark, flags);
+  canvas->Restore();
+  flags.setStyle(cc::PaintFlags::kStroke_Style);
+  for (int corner = 0; corner < 4; ++corner) {
+    const float dx = corner & 1 ? 1 : -1, dy = corner & 2 ? 1 : -1;
+    SkPathBuilder frame;
+    frame.moveTo(x + dx * 5, y + dy * 10);
+    frame.lineTo(x + dx * 9, y + dy * 10);
+    frame.quadTo(x + dx * 10, y + dy * 10, x + dx * 10, y + dy * 9);
+    frame.lineTo(x + dx * 10, y + dy * 5);
+    canvas->DrawPath(frame.detach(), flags);
+  }
+}
+BEGIN_METADATA(EmberUtilityButton)
+END_METADATA
+}  // namespace ember
