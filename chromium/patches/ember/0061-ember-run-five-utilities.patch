+
+bool WebContentsImpl::PasteImage(const SkBitmap& image,
+                                 RenderFrameHost* destination,
+                                 std::string* png_digest) {
+  if (IsBeingDestroyed() || !destination ||
+      destination != GetPrimaryMainFrame() ||
+      destination != GetFocusedFrame() ||
+      !GetContentClient()->browser()->IsClipboardPasteAllowed(destination) ||
+      image.drawsNothing() || image.computeByteSize() > 64 * 1024 * 1024)
+    return false;
+  auto* input_handler = GetFocusedFrameWidgetInputHandler();
+  if (!input_handler)
+    return false;
+  auto png = gfx::PNGCodec::EncodeBGRASkBitmap(image, false);
+  if (!png || png->empty() || png->size() > 64 * 1024 * 1024)
+    return false;
+  last_interaction_time_ = ui::EventTimeForNow();
+  // The same native API used by Chromium's IME insertion dispatches a genuine
+  // image-file paste event. It leaves the OS clipboard and page text untouched.
+  if (png_digest)
+    *png_digest = base::HexEncodeLower(crypto::hash::Sha256(*png));
+  input_handler->PasteFromImageBytes(mojo_base::BigBuffer(std::move(*png)),
+                                     "png");
+  observers_.NotifyObservers(&WebContentsObserver::OnPaste);
+  return true;  // Dispatch only: the destination must confirm its attachment.
 }
 
