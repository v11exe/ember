+  chrome::AddTabAt(browser(), GURL(url::kAboutBlankURL), -1, true);
+  auto* second = active_web_contents();
+  EXPECT_DOUBLE_EQ(1.0, second->GetAudioVolume());
+  auto* anchor = owner->footer_for_testing()->children()[0].get();
+  owner->ShowVolume(first, anchor);
+  auto* slider = owner->volume_for_testing();
+  ASSERT_TRUE(slider);
+  EXPECT_NE(first, active_web_contents());
+  owner->SliderValueChanged(slider, .25f, .875f,
+                            views::SliderChangeReason::kByUser);
+  EXPECT_DOUBLE_EQ(.5, first->GetAudioVolume());
+  EXPECT_DOUBLE_EQ(1.0, second->GetAudioVolume());
+  owner->SliderValueChanged(slider, 1.f, .25f,
+                            views::SliderChangeReason::kByUser);
+  EXPECT_DOUBLE_EQ(2.0, first->GetAudioVolume());
+  // Opening Media never normalizes a boosted background tab.
+  owner->Toggle(Utility::kMedia, anchor);
+  EXPECT_DOUBLE_EQ(2.0, first->GetAudioVolume());
+  owner->ShowVolume(first, anchor);
+  browser()->tab_strip_model()->CloseWebContentsAt(0,
+                                                   TabCloseTypes::CLOSE_NONE);
+  EXPECT_EQ(Utility::kNone, owner->active());
+  chrome::AddTabAt(browser(), GURL(url::kAboutBlankURL), -1, true);
+  EXPECT_DOUBLE_EQ(1.0, active_web_contents()->GetAudioVolume());
+}
