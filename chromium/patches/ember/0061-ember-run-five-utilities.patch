+class WhiteSlider : public views::Slider {
+ public:
+  METADATA_HEADER(WhiteSlider, views::Slider)
+ public:
+  explicit WhiteSlider(views::SliderListener* listener) : Slider(listener) {}
+  void OnPaint(gfx::Canvas* canvas) override {
+    const float left = 5, right = std::max(5, width() - 5), y = height() / 2.f;
+    const float point = left + (right - left) * GetValue();
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setColor(SkColorSetARGB(GetEnabled() ? 60 : 25, 255, 255, 255));
+    canvas->DrawRoundRect(gfx::RectF(left, y - 1.5, right - left, 3), 1.5,
