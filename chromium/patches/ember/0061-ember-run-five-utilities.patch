+IN_PROC_BROWSER_TEST_F(BrowserViewTest,
+                       EmberSnapCapturesFocusedSplitAndCancelsBeforeResize) {
+  using Utility = ember::EmberUtilityController::Utility;
+  ASSERT_TRUE(embedded_test_server()->Start());
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), embedded_test_server()->GetURL("/title1.html")));
+  auto* first = active_web_contents();
+  chrome::AddTabAt(browser(), embedded_test_server()->GetURL("/title2.html"),
+                   -1, true);
+  auto* second = active_web_contents();
+  ASSERT_TRUE(content::WaitForLoadStop(second));
+  browser()->tab_strip_model()->AddToNewSplit(
+      {0}, split_tabs::SplitTabVisualData(),
+      split_tabs::SplitTabCreatedSource::kToolbarButton);
+  auto* focused = browser_view()->GetActiveWebContents();
+  ASSERT_TRUE(focused == first || focused == second);
+  const auto original = focused->GetRenderWidgetHostView()->GetViewBounds();
+  auto* owner = browser_view()->ember_utilities();
+  auto* anchor = owner->footer_for_testing()->children()[2].get();
+  owner->Toggle(Utility::kSnap, anchor);
+  EXPECT_EQ(focused, owner->capture_source_for_testing());
+  EXPECT_EQ(original, focused->GetRenderWidgetHostView()->GetViewBounds());
+  EXPECT_EQ(0, browser_view()->GetEmberSnapWidth(640));
+  // Source clicks do not dismiss Snap, unlike transient popovers.
+  ui::MouseEvent click(ui::EventType::kMousePressed, gfx::Point(), gfx::Point(),
+                       base::TimeTicks::Now(), ui::EF_LEFT_MOUSE_BUTTON,
+                       ui::EF_LEFT_MOUSE_BUTTON);
+  owner->OnMouseEvent(&click);
+  EXPECT_TRUE(owner->snap_requested_for_testing());
+  // Cancellation invalidates the native capture callback before it can create
+  // another page, resize the source or paste into a future destination.
+  owner->Close(false, true);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(nullptr, owner->capture_source_for_testing());
+  EXPECT_EQ(nullptr, owner->snap_contents_for_testing());
+  EXPECT_EQ(0, browser_view()->GetEmberSnapWidth(640));
+}
