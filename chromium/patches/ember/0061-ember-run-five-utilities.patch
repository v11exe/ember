+IN_PROC_BROWSER_TEST_F(BrowserViewTest,
+                       EmberFooterFeedbackStaysBoundedAfterInterruptions) {
+  auto* owner = browser_view()->ember_utilities();
+  auto* button = static_cast<ember::EmberUtilityButton*>(
+      owner->footer_for_testing()->children()[1]);
+  gfx::Animation::SetPrefersReducedMotionForTesting(true);
+  for (int i = 0; i < 20; ++i) {
+    button->SetState(views::Button::STATE_HOVERED);
+    button->SetState(views::Button::STATE_PRESSED);
+    button->SetOpen(true);
+    button->SetOpen(false);
+    button->SetState(views::Button::STATE_NORMAL);
+  }
+  ember::EmberSquareFeedback feedback(button);
+  feedback.Set(true, false, false);
+  gfx::Canvas canvas(gfx::Size(48, 48), 1.f, false);
+  canvas.Save();
+  canvas.Translate(gfx::Vector2d(6, 6));
+  feedback.Paint(&canvas);
+  canvas.Restore();
+  const SkBitmap bitmap = canvas.GetBitmap();
+  EXPECT_EQ(SK_ColorTRANSPARENT, bitmap.getColor(0, 0));
+  EXPECT_EQ(SK_ColorTRANSPARENT, bitmap.getColor(47, 47));
+  EXPECT_GT(SkColorGetA(bitmap.getColor(24, 24)), 0);
+  feedback.Set(false, false, false);
+  gfx::Canvas quiet(gfx::Size(36, 36), 1.f, false);
+  feedback.Paint(&quiet);
+  EXPECT_EQ(SK_ColorTRANSPARENT, quiet.GetBitmap().getColor(18, 18));
+  EXPECT_EQ(views::View::FocusBehavior::ALWAYS, button->GetFocusBehavior());
+  gfx::Animation::SetPrefersReducedMotionForTesting(false);
+  feedback.Set(true, false, false);
+  feedback.Set(false, false, false);
+  feedback.Set(true, true, false);
+  feedback.Set(false, false, false);
+}
