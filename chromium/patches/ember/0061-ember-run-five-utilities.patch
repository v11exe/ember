+IN_PROC_BROWSER_TEST_F(BrowserViewTest,
+                       EmberMediaActionsKeepSourceAcrossFocus) {
+  using Action = media_session::mojom::MediaSessionAction;
+  using Utility = ember::EmberUtilityController::Utility;
+  const char script[] = R"JS(
+    (async () => {
+      const rate = 8000, samples = rate * 2;
+      const bytes = new Uint8Array(44 + samples * 2), data = new DataView(bytes.buffer);
+      const text = (at, word) => [...word].forEach((c, i) => bytes[at+i] = c.charCodeAt(0));
+      text(0,'RIFF'); data.setUint32(4,36+samples*2,true); text(8,'WAVE'); text(12,'fmt ');
+      data.setUint32(16,16,true); data.setUint16(20,1,true); data.setUint16(22,1,true);
+      data.setUint32(24,rate,true); data.setUint32(28,rate*2,true);
+      data.setUint16(32,2,true); data.setUint16(34,16,true); text(36,'data');
+      data.setUint32(40,samples*2,true);
+      for(let i=0;i<samples;i++) data.setInt16(44+i*2,1000*Math.sin(i*.2),true);
+      window.audio = new Audio(URL.createObjectURL(new Blob([bytes], {type:'audio/wav'})));
+      audio.loop = true; await audio.play(); window.previous = 0; window.next = 0;
+      navigator.mediaSession.metadata = new MediaMetadata({title:'Native source test'});
+      navigator.mediaSession.setActionHandler('previoustrack', () => ++window.previous);
+      navigator.mediaSession.setActionHandler('nexttrack', () => ++window.next);
+      navigator.mediaSession.setActionHandler('pause', () => audio.pause());
+      navigator.mediaSession.setActionHandler('play', () => audio.play());
+      navigator.mediaSession.setActionHandler('seekto', e => audio.currentTime = e.seekTime);
+      navigator.mediaSession.setPositionState({duration:2, position:0, playbackRate:1});
+      return true;
+    })()
+  )JS";
+  auto* first = active_web_contents();
+  ASSERT_EQ(true, content::EvalJs(first, script));
+  auto* owner = browser_view()->ember_utilities();
+  auto* anchor = owner->footer_for_testing()->children()[0].get();
+  owner->Toggle(Utility::kMedia, anchor);
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return owner->media_contents_for_testing() == first; }));
+  auto* previous = owner->media_action_for_testing(int(Action::kPreviousTrack));
+  ASSERT_TRUE(previous);
+  ASSERT_TRUE(base::test::RunUntil([&] { return previous->GetEnabled(); }));
+  views::test::ButtonTestApi(previous).NotifyDefaultMouseClick();
+  ASSERT_EQ(1, content::EvalJs(first, "window.previous"));
+  first->SetAudioVolume(1.8);
+  chrome::AddTabAt(browser(), GURL(url::kAboutBlankURL), -1, true);
+  auto* second = active_web_contents();
+  EXPECT_EQ(first, owner->media_contents_for_testing());
+  EXPECT_DOUBLE_EQ(1.8, first->GetAudioVolume());
+  ASSERT_EQ(true, content::EvalJs(second, script));
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return owner->sources_for_testing()->GetEnabled(); }));
+  views::test::ComboboxTestApi(owner->sources_for_testing()).PerformActionAt(1);
+  EXPECT_EQ(second, owner->media_contents_for_testing());
+  views::test::ButtonTestApi(
+      owner->media_action_for_testing(int(Action::kNextTrack)))
+      .NotifyDefaultMouseClick();
+  EXPECT_EQ(1, content::EvalJs(second, "window.next"));
+  EXPECT_EQ(0, content::EvalJs(first, "window.next"));
+  owner->Close(false);
+}
