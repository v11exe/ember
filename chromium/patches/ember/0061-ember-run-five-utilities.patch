+class EmberUtilityController::Source
+    : public content::WebContentsObserver,
+      public media_session::mojom::MediaSessionObserver {
+ public:
+  Source(EmberUtilityController* owner, content::WebContents* contents)
+      : WebContentsObserver(contents), owner_(owner) {
+    Bind(content::MediaSession::GetIfExists(contents));
+  }
+  void Bind(content::MediaSession* session) {
+    if (!session || receiver_.is_bound())
+      return;
+    session->AddObserver(receiver_.BindNewPipeAndPassRemote());
+  }
+  void MediaSessionCreated(content::MediaSession* session) override {
+    Bind(session);
+  }
+  void MediaSessionInfoChanged(
+      media_session::mojom::MediaSessionInfoPtr value) override {
+    info = std::move(value);
+    Changed();
+  }
+  void MediaSessionMetadataChanged(
+      const std::optional<media_session::MediaMetadata>& value) override {
+    metadata = value;
+    Changed();
+  }
+  void MediaSessionActionsChanged(const std::vector<Action>& value) override {
+    actions = value;
+    Changed();
+  }
+  void MediaSessionPositionChanged(
+      const std::optional<media_session::MediaPosition>& value) override {
+    position = value;
+    Changed();
+  }
+  void MediaSessionImagesChanged(
+      const base::flat_map<media_session::mojom::MediaSessionImageType,
+                           std::vector<media_session::MediaImage>>& images)
+      override {
+    artwork = gfx::ImageSkia();
+    const uint64_t generation = ++art_generation_;
+    auto it =
+        images.find(media_session::mojom::MediaSessionImageType::kArtwork);
+    auto* session = content::MediaSession::GetIfExists(web_contents());
+    if (session && it != images.end() && !it->second.empty()) {
+      session->GetMediaImageBitmap(
+          it->second.front(), 32, 96,
+          base::BindOnce(
+              [](base::WeakPtr<Source> source, uint64_t generation,
+                 const SkBitmap& image) {
+                if (!source || generation != source->art_generation_)
+                  return;
+                if (!image.drawsNothing())
+                  source->artwork = gfx::ImageSkia::CreateFrom1xBitmap(image);
+                source->Changed();
+              },
+              weak_.GetWeakPtr(), generation));
+    }
+    Changed();
+  }
+  void DidUpdateAudioMutingState(bool) override { Changed(); }
+  void DidUpdateAudioVolume(double) override { Changed(); }
+  void PrimaryPageChanged(content::Page&) override {
+    ++art_generation_;
+    info.reset();
+    metadata.reset();
+    actions.clear();
+    position.reset();
+    artwork = gfx::ImageSkia();
+    Changed();
+  }
+  void WebContentsDestroyed() override {
+    info.reset();
+    receiver_.reset();
+    owner_->ScheduleSourceRefresh();
+    owner_->SourceChanged(web_contents());
+  }
+  bool Available() const {
+    return web_contents() && !web_contents()->IsBeingDestroyed() && info &&
+           info->state !=
+               media_session::mojom::MediaSessionInfo::SessionState::kInactive;
+  }
+  bool Has(Action action) const {
+    return std::ranges::find(actions, action) != actions.end();
+  }
+  media_session::mojom::MediaSessionInfoPtr info;
+  std::optional<media_session::MediaMetadata> metadata;
+  std::optional<media_session::MediaPosition> position;
+  std::vector<Action> actions;
+  gfx::ImageSkia artwork;
+
+ private:
+  void Changed() { owner_->SourceChanged(web_contents()); }
+  const raw_ptr<EmberUtilityController> owner_;
+  uint64_t art_generation_ = 0;
+  mojo::Receiver<media_session::mojom::MediaSessionObserver> receiver_{this};
+  base::WeakPtrFactory<Source> weak_{this};
+};
