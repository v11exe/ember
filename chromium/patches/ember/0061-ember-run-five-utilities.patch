+EmberUtilityController::EmberUtilityController(BrowserView* browser_view)
+    : browser_view_(browser_view),
+      snap_transition_(
+          base::BindRepeating(&EmberUtilityController::ApplySnapFrame,
+                              base::Unretained(this))),
+      capture_transition_(base::BindRepeating(
+          [](EmberUtilityController* owner,
+             const EmberGlassTransition::Frame&) { owner->SchedulePaint(); },
+          base::Unretained(this))) {
+  // WebContents uses its own native compositor surface. Ordinary parent paint
+  // would sit behind it; this transparent layer owns only utility/feedback
+  // pixels.
+  SetPaintToLayer();
+  layer()->SetFillsBoundsOpaquely(false);
+  SetEventTargeter(std::make_unique<views::ViewTargeter>(this));
+  browser_view_->browser()->tab_strip_model()->AddObserver(this);
+  SyncSources();
+}
+EmberUtilityController::~EmberUtilityController() {
+  CancelPendingSnap();
+  browser_view_->browser()->tab_strip_model()->RemoveObserver(this);
+  if (GetWidget())
+    RemovedFromWidget();
+}
+void EmberUtilityController::AddedToWidget() {
+  if (!listening_) {
+    GetWidget()->AddObserver(this);
+    GetWidget()->GetNativeWindow()->AddPreTargetHandler(this);
+    listening_ = true;
+  }
+}
+void EmberUtilityController::RemovedFromWidget() {
+  if (listening_ && GetWidget()) {
+    GetWidget()->RemoveObserver(this);
+    GetWidget()->GetNativeWindow()->RemovePreTargetHandler(this);
+  }
+  listening_ = false;
+}
+void EmberUtilityController::OnWidgetActivationChanged(views::Widget*,
+                                                       bool active) {
+  if (active || active_ == Utility::kNone || active_ == Utility::kSnap)
+    return;
+  // Activation may be moving to an owned source-selector/extension widget.
+  // Inspect after that move; only leaving the whole browser tree dismisses.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::WeakPtr<EmberUtilityController> owner) {
+            if (!owner || !owner->GetWidget() ||
+                owner->GetWidget()->IsActive() ||
+                owner->active_ == Utility::kSnap)
+              return;
+            for (const auto& child : views::Widget::GetAllOwnedWidgets(
+                     owner->GetWidget()->GetNativeView()))
+              if (child->IsActive())
+                return;
+            owner->Close(false);
+          },
+          weak_factory_.GetWeakPtr()));
+}
+void EmberUtilityController::CreateFooter(views::View* footer) {
+  footer_ = footer;
+  const auto add = [&](Utility utility, std::u16string name,
+                       EmberUtilityButton::Glyph glyph,
+                       const gfx::VectorIcon* icon) {
+    auto button = std::make_unique<EmberUtilityButton>(
+        base::BindRepeating(
+            [](EmberUtilityController* owner, Utility utility) {
+              owner->Toggle(utility, owner->buttons_[utility]);
+            },
+            base::Unretained(this), utility),
+        name, glyph);
+    if (icon)
+      button->SetImageModel(
+          views::Button::STATE_NORMAL,
+          ui::ImageModel::FromVectorIcon(*icon, kForeground, 19));
+    buttons_[utility] = footer->AddChildView(std::move(button));
+  };
+  add(Utility::kMedia, u"Media", EmberUtilityButton::Glyph::kNative,
+      &vector_icons::kPlayArrowIcon);
+  add(Utility::kWorkspaces, u"Workspaces",
+      EmberUtilityButton::Glyph::kWorkspace, nullptr);
+  add(Utility::kSnap, u"ChatGPT Snap", EmberUtilityButton::Glyph::kSnap,
+      nullptr);
+  // Native Extensions is inserted here by ToolbarView, preserving its menu.
+  auto settings = std::make_unique<EmberUtilityButton>(
+      base::BindRepeating(
+          [](EmberUtilityController* owner) {
+            owner->Close(false, true);
+            owner->browser_view_->CloseEmberSearch(false);
+            chrome::ShowSettings(owner->browser_view_->browser());
+          },
+          base::Unretained(this)),
+      u"Settings");
+  settings->SetImageModel(views::Button::STATE_NORMAL,
+                          ui::ImageModel::FromVectorIcon(
+                              vector_icons::kSettingsIcon, kForeground, 19));
+  footer->AddChildView(std::move(settings));
+}
+void EmberUtilityController::UpdateButtons() {
+  for (auto& [utility, button] : buttons_)
+    button->SetOpen(active_ == utility);
+}
+void EmberUtilityController::BeforeExtensions() {
+  Close(false, true);
+  browser_view_->CloseEmberSearch(false);
+  active_ = Utility::kExtensions;
+  anchor_ =
+      browser_view_->toolbar()->extensions_container()->GetExtensionsButton();
+  UpdateButtons();
+}
+void EmberUtilityController::ExtensionsClosed() {
+  if (active_ == Utility::kExtensions) {
+    active_ = Utility::kNone;
+    anchor_ = nullptr;
+    UpdateButtons();
+  }
+}
+void EmberUtilityController::Toggle(Utility utility, views::View* anchor) {
+  if (active_ == utility) {
+    Close();
+    return;
+  }
+  if (utility == Utility::kSnap) {
+    if (snap_requested_) {
+      CancelPendingSnap();
+      return;
+    }
+    // Renderer capture excludes existing browser-owned popups. Request it
+    // while the focused source and its actual viewport still match the click.
+    CancelPendingSnap();
+    CaptureSnap();
+    return;
+  }
+  Close(false, true);
+  browser_view_->CloseEmberSearch(false);
+  if (auto* ext = browser_view_->toolbar()->extensions_container()) {
+    ext->HideEmberUtilitySurface();
+  }
+  ExtensionsMenuView::Hide();
+  active_ = utility;
+  anchor_ = anchor;
+  UpdateButtons();
+  ShowPopover(anchor, utility == Utility::kMedia ? 300 : 56);
+  if (utility == Utility::kWorkspaces) {
+    auto label = std::make_unique<views::Label>(u"Work in progress");
+    label->SetEnabledColor(kForeground);
+    label->SetBackgroundColor(SK_ColorTRANSPARENT);
+    popover_body_->AddChildView(std::move(label))->SetBounds(16, 14, 208, 28);
+  } else {
+    RefreshMedia();
+    position_timer_.Start(
+        FROM_HERE, base::Milliseconds(250),
+        base::BindRepeating(&EmberUtilityController::UpdatePosition,
+                            weak_factory_.GetWeakPtr()));
+  }
+}
+void EmberUtilityController::Close(bool restore_focus,
+                                   bool immediate,
+                                   bool keep_capture) {
+  const bool was_open = active_ != Utility::kNone;
+  if (immediate)
+    for (const auto& surface : closing_popovers_)
+      surface->SetVisible(false);
+  active_ = Utility::kNone;
+  position_timer_.Stop();
+  seeking_ = false;
+  if (auto* ext = browser_view_->toolbar()
+                      ? browser_view_->toolbar()->extensions_container()
+                      : nullptr) {
+    ext->HideEmberUtilitySurface();
+  }
+  ExtensionsMenuView::Hide();
+  if (popover_) {
+    auto* old = popover_.get();
+    popover_ = nullptr;
+    closing_popovers_.push_back(old);
+    old->SetCanProcessEventsWithinSubtree(false);
+    if (immediate)
+      old->SetVisible(false);
+    old->CloseAnimated(base::BindOnce(
+        [](base::WeakPtr<EmberUtilityController> owner,
+           EmberGlassView* surface) {
+          if (owner && surface->parent() == owner.get()) {
+            std::erase(owner->closing_popovers_, surface);
+            owner->RemoveChildViewT(surface);
+          }
+        },
+        weak_factory_.GetWeakPtr(), old));
+  }
+  popover_body_ = nullptr;
+  volume_slider_ = nullptr;
+  seek_slider_ = nullptr;
+  artwork_ = nullptr;
+  media_scroll_ = nullptr;
+  media_body_ = nullptr;
+  media_title_ = nullptr;
+  media_time_ = nullptr;
+  source_button_ = nullptr;
+  media_buttons_.clear();
+  volume_owner_.reset();
+  source_model_owners_.clear();
+  source_model_labels_.clear();
+  if (snap_visible_ ||
+      (immediate && snap_surface_ && snap_surface_->GetVisible())) {
+    snap_visible_ = false;
+    browser_view_->SetEmberSnapSidebarMode(false);
+    snap_surface_->SetCanProcessEventsWithinSubtree(false);
+    if (immediate) {
+      snap_transition_.Reset();
+      snap_surface_->SetVisible(false);
+      snap_reveal_width_ = 0;
+      browser_view_->InvalidateLayout();
+      if (browser_view_->GetWidget())
+        browser_view_->GetWidget()
+            ->GetRootView()
+            ->DeprecatedLayoutImmediately();
+    } else
+      snap_transition_.Close(base::BindOnce(
+          [](base::WeakPtr<EmberUtilityController> owner) {
+            if (!owner)
+              return;
+            owner->snap_surface_->SetVisible(false);
+            owner->snap_reveal_width_ = 0;
+            owner->browser_view_->InvalidateLayout();
+          },
+          weak_factory_.GetWeakPtr()));
+  }
+  if (!keep_capture)
+    CancelPendingSnap();
+  UpdateButtons();
+  if (restore_focus && was_open) {
+    if (anchor_ && anchor_->GetVisible())
+      anchor_->RequestFocus();
+    else if (auto* contents = browser_view_->GetActiveWebContents())
+      contents->Focus();
+  }
+  anchor_ = nullptr;
+}
+void EmberUtilityController::ShowPopover(views::View* anchor,
+                                         int height,
+                                         bool volume) {
+  Relayout();
+  popover_height_ = height;
+  const int panel_width =
+      std::max(1, std::min(volume                            ? 216
+                           : active_ == Utility::kWorkspaces ? 240
+                                                             : 300,
+                           width() - 12));
+  gfx::Rect at = anchor->GetBoundsInScreen();
+  gfx::Point origin = at.right_center();
+  views::View::ConvertPointFromScreen(this, &origin);
+  const gfx::Rect panel(
+      std::clamp(origin.x() + 8, 4, std::max(4, width() - panel_width - 4)),
+      std::clamp(origin.y() - height, 4,
+                 std::max(4, this->height() - height - 4)),
+      panel_width, std::min(height, this->height() - 8));
+  popover_ =
+      static_cast<EmberGlassView*>(AddChildView(std::unique_ptr<views::View>(
+          std::make_unique<EmberGlassView>(EmberGlassPreset::kPopover))));
+  // EmberGlassView has a shadow/capture gutter; contents occupy its panel box.
+  gfx::Rect bounds = panel;
+  bounds.Outset(EmberGlassView::kShadowMargin);
+  popover_->SetBoundsRect(bounds);
+  popover_body_ =
+      popover_->contents()->AddChildView(std::make_unique<views::View>());
+  popover_body_->SetBoundsRect(popover_->GetPanelBounds());
+  // Use EmberGlassView's existing material/mask, not the separate-widget bubble
+  // background helper. A second paint owner would lose the sampled pixels.
+  auto material = std::make_shared<EmberGlassMaterial>();
+  auto generation = std::make_shared<uint64_t>(0);
+  auto* surface = popover_.get();
+  auto* source = browser_view_->GetActiveWebContents();
+  StartEmberGlassBackdropCapture(
+      surface, source,
+      base::BindRepeating(
+          [](EmberGlassView* surface,
+             std::shared_ptr<EmberGlassMaterial> material,
+             std::shared_ptr<uint64_t> generation, const SkBitmap& bitmap,
+             const gfx::Rect& renderer_bounds) {
+            gfx::Rect sample = surface->GetPanelBounds();
+            sample.Offset(surface->GetBoundsInScreen().origin() -
+                          renderer_bounds.origin());
+            sample.Inset(-EmberGlassView::kBackdropMargin);
+            const auto* panel = material->RenderPanel(
+                bitmap, sample, ++*generation, EmberGlassPreset::kPopover);
+            if (panel)
+              surface->SetPanel(*panel);
+          },
+          base::Unretained(surface), material, generation));
+  popover_->OpenFrom(
+      gfx::Point(origin.x() - bounds.x(), origin.y() - bounds.y()));
+}
+void EmberUtilityController::ShowVolume(content::WebContents* contents,
+                                        views::View* anchor) {
+  if (!contents || contents->IsBeingDestroyed())
+    return;
+  Close(false, true);
+  browser_view_->CloseEmberSearch(false);
+  active_ = Utility::kVolume;
+  anchor_ = anchor;
+  volume_owner_ = contents->GetWeakPtr();
+  ShowPopover(anchor, 44, true);
+  auto icon = std::make_unique<views::ImageView>();
+  icon->SetImage(ui::ImageModel::FromVectorIcon(vector_icons::kVolumeUpIcon,
+                                                kForeground, 19));
+  popover_body_->AddChildView(std::move(icon))->SetBounds(12, 12, 20, 20);
+  volume_slider_ =
+      popover_body_->AddChildView(std::make_unique<WhiteSlider>(this));
+  volume_slider_->SetBounds(42, 7, 160, 30);
+  volume_slider_->SetValue(contents->GetAudioVolume() / 2.f);
+  volume_slider_->GetViewAccessibility().SetName(
+      u"Tab volume, 0 to 200 percent");
+  volume_slider_->GetViewAccessibility().SetValue(
+      base::NumberToString16(std::lround(contents->GetAudioVolume() * 100)) +
+      u" percent");
+  volume_slider_->SetTooltipText(
+      base::NumberToString16(std::lround(contents->GetAudioVolume() * 100)) +
+      u"%");
+  volume_slider_->RequestFocus();
+}
+void EmberUtilityController::SyncSources() {
+  auto* model = browser_view_->browser()->tab_strip_model();
+  std::set<content::WebContents*> retained;
+  for (int i = 0; i < model->count(); ++i) {
+    auto* contents = model->GetWebContentsAt(i);
+    if (contents->IsBeingDestroyed())
+      continue;
+    retained.insert(contents);
+    if (!sources_.contains(contents))
+      sources_[contents] = std::make_unique<Source>(this, contents);
+  }
+  std::erase_if(sources_, [&](const auto& entry) {
+    return !retained.contains(entry.first);
+  });
+  if (active_ == Utility::kVolume &&
+      (!volume_owner_ || !retained.contains(volume_owner_.get())))
+    Close(false);
+  if (paste_phase_ != PastePhase::kIdle &&
+      (!capture_source_ || !retained.contains(capture_source_.get()))) {
+    CancelPendingSnap();
+    SnapStatus(u"Source closed. Close Snap and capture again.");
+  }
+  if (media_ && !retained.contains(media_.get()))
+    media_.reset();
+}
+void EmberUtilityController::OnTabStripModelChanged(
+    TabStripModel*,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange&) {
+  if (change.type() == TabStripModelChange::kReplaced) {
+    const auto* replacement = change.GetReplace();
+    if (media_.get() == replacement->old_contents)
+      media_ = replacement->new_contents->GetWeakPtr();
+  }
+  SyncSources();
+  SourceChanged(nullptr);
+}
+void EmberUtilityController::ScheduleSourceRefresh() {
+  if (refresh_pending_)
+    return;
+  refresh_pending_ = true;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](base::WeakPtr<EmberUtilityController> owner) {
+                       if (!owner)
+                         return;
+                       owner->refresh_pending_ = false;
+                       owner->SyncSources();
+                       if (owner->active_ == Utility::kMedia)
+                         owner->RefreshMedia();
+                     },
+                     weak_factory_.GetWeakPtr()));
+}
+void EmberUtilityController::SourceChanged(content::WebContents* contents) {
+  if (capture_source_.get() == contents && !SourceStillValid() &&
+      paste_phase_ != PastePhase::kIdle) {
+    CancelPendingSnap();
+    SnapStatus(u"Source changed. Close and capture again.");
+  }
+  if (volume_owner_.get() == contents && volume_slider_ && !updating_) {
+    if (!contents || contents->IsBeingDestroyed()) {
+      Close(false);
+      return;
+    }
+    updating_ = true;
+    volume_slider_->SetValue(contents->GetAudioVolume() / 2.f);
+    updating_ = false;
+  }
+  if (active_ == Utility::kMedia)
+    ScheduleSourceRefresh();
+}
+void EmberUtilityController::RefreshMedia() {
+  if (active_ != Utility::kMedia || !popover_)
+    return;
+  available_sources_.clear();
+  auto* model = browser_view_->browser()->tab_strip_model();
+  for (int i = 0; i < model->count(); ++i) {
+    auto* contents = model->GetWebContentsAt(i);
+    auto it = sources_.find(contents);
+    if (it != sources_.end() &&
+        (it->second->Available() || contents == media_.get()))
+      available_sources_.push_back(contents->GetWeakPtr());
+  }
+  if (!std::ranges::any_of(available_sources_, [&](const auto& item) {
+        return item.get() == media_.get();
+      })) {
+    auto* focused = browser_view_->GetActiveWebContents();
+    auto candidate = std::ranges::find_if(
+        available_sources_,
+        [&](const auto& item) { return item.get() == focused; });
+    media_ = candidate != available_sources_.end() ? *candidate
+             : available_sources_.empty()
+                 ? base::WeakPtr<content::WebContents>()
+                 : available_sources_.front();
+  }
+  // Keep controls during dragging. Updates never rebuild a pressed slider.
+  if (!media_scroll_) {
+    auto scroll = std::make_unique<views::ScrollView>();
+    scroll->SetHorizontalScrollBarMode(
+        views::ScrollView::ScrollBarMode::kDisabled);
+    scroll->SetDrawOverflowIndicator(false);
+    scroll->SetBackground(nullptr);
+    media_body_ = scroll->SetContents(std::make_unique<views::View>());
+    media_body_->SetPreferredSize(gfx::Size(300, 300));
+    media_scroll_ = popover_body_->AddChildView(std::move(scroll));
+    media_scroll_->SetBoundsRect(popover_body_->GetLocalBounds());
+  }
+  auto* area = media_body_.get();
+  if (!media_title_) {
+    auto label = std::make_unique<views::Label>(u"Media");
+    label->SetEnabledColor(kForeground);
+    label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    area->AddChildView(std::move(label))->SetBounds(16, 12, 260, 24);
+    artwork_ = area->AddChildView(std::make_unique<views::ImageView>());
+    artwork_->SetBounds(16, 48, 72, 72);
+    artwork_->SetImageSize(gfx::Size(72, 72));
+    media_title_ = area->AddChildView(std::make_unique<views::Label>());
+    media_title_->SetEnabledColor(kForeground);
+    media_title_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    media_title_->SetBounds(104, 48, 176, 36);
+    media_title_->SetMultiLine(true);
+    source_button_ = area->AddChildView(std::make_unique<views::Combobox>());
+    source_button_->SetBounds(104, 88, 176, 28);
+    source_button_->SetTooltipTextAndAccessibleName(u"Media source");
+    source_button_->SetCallback(base::BindRepeating(
+        [](EmberUtilityController* owner) {
+          if (owner->updating_ || !owner->source_button_)
+            return;
+          const auto selected = owner->source_button_->GetSelectedIndex();
+          if (selected && *selected < owner->available_sources_.size()) {
+            owner->media_ = owner->available_sources_[*selected];
+            owner->RefreshMedia();
+          }
+        },
+        base::Unretained(this)));
+    const auto button = [&](int action, const gfx::VectorIcon& icon,
+                            std::u16string name, int x, int y) {
+      auto control = std::make_unique<EmberUtilityButton>(
+          base::BindRepeating(&EmberUtilityController::MediaAction,
+                              weak_factory_.GetWeakPtr(), action),
+          name);
+      control->SetImageModel(
+          views::Button::STATE_NORMAL,
+          ui::ImageModel::FromVectorIcon(icon, kForeground, 19));
+      media_buttons_[action] = area->AddChildView(std::move(control));
+      media_buttons_[action]->SetBounds(x, y, 36, 36);
+    };
+    button(int(Action::kPreviousTrack), vector_icons::kSkipPreviousIcon,
+           u"Previous track", 66, 128);
+    button(int(Action::kPlay), vector_icons::kPlayArrowIcon, u"Play or pause",
+           132, 128);
+    button(int(Action::kNextTrack), vector_icons::kSkipNextIcon, u"Next track",
+           198, 128);
+    seek_slider_ = area->AddChildView(std::make_unique<WhiteSlider>(this));
+    seek_slider_->SetBounds(16, 174, 268, 26);
+    seek_slider_->GetViewAccessibility().SetName(u"Seek");
+    media_time_ = area->AddChildView(std::make_unique<views::Label>());
+    media_time_->SetEnabledColor(kForeground);
+    media_time_->SetBounds(16, 200, 268, 20);
+    button(kMute, vector_icons::kVolumeUpIcon, u"Mute or unmute source tab", 12,
+           225);
+    volume_slider_ = area->AddChildView(std::make_unique<WhiteSlider>(this));
+    volume_slider_->SetBounds(54, 228, 230, 28);
+    volume_slider_->GetViewAccessibility().SetName(
+        u"Media volume, 0 to 100 percent");
+    button(int(Action::kEnterPictureInPicture),
+           vector_icons::kPictureInPictureIcon, u"Picture in picture", 48, 263);
+    button(kGoToTab, kOpenInNewIcon, u"Go to tab", 214, 263);
+  }
+  auto it = sources_.find(media_.get());
+  Source* source = it == sources_.end() ? nullptr : it->second.get();
+  const bool available = source && source->Available();
+  media_title_->SetText(available ? source->metadata &&
+                                            !source->metadata->title.empty()
+                                        ? source->metadata->title
+                                        : media_->GetTitle()
+                                  : u"No media available");
+  if (available && !source->artwork.isNull())
+    artwork_->SetImage(ui::ImageModel::FromImageSkia(source->artwork));
+  else
+    artwork_->SetImage(ui::ImageModel::FromVectorIcon(
+        vector_icons::kPlayArrowIcon, SkColorSetARGB(90, 255, 255, 255), 48));
+  std::vector<ui::SimpleComboboxModel::Item> choices;
+  std::vector<std::u16string> labels;
+  size_t selected = 0;
+  for (size_t i = 0; i < available_sources_.size(); ++i) {
+    auto* contents = available_sources_[i].get();
+    if (!contents)
+      continue;
+    if (contents == media_.get())
+      selected = i;
+    labels.push_back(base::UTF8ToUTF16(contents->GetLastCommittedURL().host()) +
+                     u"\n" + contents->GetTitle());
+    choices.emplace_back(
+        base::UTF8ToUTF16(contents->GetLastCommittedURL().host()),
+        contents->GetTitle(), ui::ImageModel());
+  }
+  if (choices.empty()) {
+    choices.emplace_back(u"No media available");
+    labels.push_back(u"No media available");
+  }
+  updating_ = true;
+  // Position/volume notifications must not tear down an open source menu.
+  const bool owners_changed =
+      source_model_owners_.size() != available_sources_.size() ||
+      !std::equal(source_model_owners_.begin(), source_model_owners_.end(),
+                  available_sources_.begin(),
+                  [](const auto& left, const auto& right) {
+                    return left.get() == right.get();
+                  });
+  if (owners_changed || labels != source_model_labels_ ||
+      !source_button_->GetModel()) {
+    source_button_->SetOwnedModel(
+        std::make_unique<ui::SimpleComboboxModel>(std::move(choices)));
+    source_model_owners_ = available_sources_;
+    source_model_labels_ = std::move(labels);
+  }
+  source_button_->SetSelectedIndex(selected);
+  updating_ = false;
+  source_button_->SetEnabled(available_sources_.size() > 1);
+  for (const auto& [action, button] : media_buttons_) {
+    bool enabled = available;
+    if (action >= 0)
+      enabled = available && source->Has(Action(action));
+    if (action == int(Action::kPlay)) {
+      const bool playing =
+          available && source->info->playback_state ==
+                           media_session::mojom::MediaPlaybackState::kPlaying;
+      enabled =
+          available && source->Has(playing ? Action::kPause : Action::kPlay);
+      button->SetImageModel(
+          views::Button::STATE_NORMAL,
+          ui::ImageModel::FromVectorIcon(
+              playing ? vector_icons::kPauseIcon : vector_icons::kPlayArrowIcon,
+              kForeground, 19));
+      button->SetAccessibleName(playing ? u"Pause" : u"Play");
+    }
+    if (action == kMute && available)
+      button->SetImageModel(
+          views::Button::STATE_NORMAL,
+          ui::ImageModel::FromVectorIcon(media_->IsAudioMuted()
+                                             ? vector_icons::kVolumeOffIcon
+                                             : vector_icons::kVolumeUpIcon,
+                                         kForeground, 19));
+    button->SetEnabled(enabled);
+  }
+  volume_slider_->SetEnabled(available);
+  updating_ = true;
+  volume_slider_->SetValue(available ? std::min(1.0, media_->GetAudioVolume())
+                                     : 1.0);
+  volume_slider_->GetViewAccessibility().SetValue(
+      available ? base::NumberToString16(std::lround(
+                      std::min(1.0, media_->GetAudioVolume()) * 100)) +
+                      u" percent"
+                : u"No media");
+  volume_slider_->SetTooltipText(
+      available ? base::NumberToString16(
+                      std::lround(media_->GetAudioVolume() * 100)) +
+                      u"%" + (media_->IsAudioMuted() ? u" (muted)" : u"")
+                : u"No media");
+  updating_ = false;
+  UpdatePosition();
+}
+void EmberUtilityController::SelectNextSource() {
+  if (available_sources_.size() < 2)
+    return;
+  auto it = std::ranges::find_if(available_sources_, [&](const auto& source) {
+    return source.get() == media_.get();
+  });
+  const size_t index =
+      it == available_sources_.end()
+          ? 0
+          : (it - available_sources_.begin() + 1) % available_sources_.size();
+  media_ = available_sources_[index];
+  RefreshMedia();
+}
+void EmberUtilityController::UpdatePosition() {
+  if (!seek_slider_ || !media_time_ || seeking_)
+    return;
+  auto it = sources_.find(media_.get());
+  Source* source = it == sources_.end() ? nullptr : it->second.get();
+  const bool seek = source && source->Available() &&
+                    source->Has(Action::kSeekTo) && source->position &&
+                    !source->position->duration().is_max() &&
+                    source->position->duration().is_positive();
+  seek_slider_->SetEnabled(seek);
+  updating_ = true;
+  if (seek) {
+    const auto position = source->position->GetPosition();
+    seek_slider_->SetValue(position / source->position->duration());
+    media_time_->SetText(TimeText(position) + u" / " +
+                         TimeText(source->position->duration()));
+    seek_slider_->GetViewAccessibility().SetValue(TimeText(position));
+  } else {
+    seek_slider_->SetValue(0);
+    media_time_->SetText(u"--:-- / --:--");
+  }
+  updating_ = false;
+}
+void EmberUtilityController::MediaAction(int action) {
+  auto* contents = media_.get();
+  auto it = sources_.find(contents);
+  if (!contents || contents->IsBeingDestroyed() || it == sources_.end() ||
+      !it->second->Available())
+    return;
+  if (action == kMute) {
+    contents->SetAudioMuted(!contents->IsAudioMuted());
+    RefreshMedia();
+    return;
+  }
+  if (action == kGoToTab) {
+    auto* model = browser_view_->browser()->tab_strip_model();
+    const auto target = contents->GetWeakPtr();
+    Close(false);
+    if (!target)
+      return;
+    const int index = model->GetIndexOfWebContents(target.get());
+    if (index != TabStripModel::kNoTab) {
+      model->ActivateTabAt(index);
+      target->Focus();
+    }
+    return;
+  }
+  auto* session = content::MediaSession::GetIfExists(contents);
+  Action actual = Action(action);
+  if (actual == Action::kPlay &&
+      it->second->info->playback_state ==
+          media_session::mojom::MediaPlaybackState::kPlaying)
+    actual = Action::kPause;
+  if (session && it->second->Has(actual))
+    session->DidReceiveAction(actual);
+}
+void EmberUtilityController::SliderDragStarted(views::Slider* slider) {
+  if (slider == seek_slider_)
+    seeking_ = true;
+}
+void EmberUtilityController::SliderDragEnded(views::Slider* slider) {
+  if (slider == seek_slider_) {
+    seeking_ = false;
+    UpdatePosition();
+  }
+}
+void EmberUtilityController::SliderValueChanged(
+    views::Slider* slider,
+    float value,
+    float old_value,
+    views::SliderChangeReason reason) {
+  if (updating_ || reason != views::SliderChangeReason::kByUser)
+    return;
+  auto* contents =
+      active_ == Utility::kVolume ? volume_owner_.get() : media_.get();
+  if (!contents || contents->IsBeingDestroyed() ||
+      browser_view_->browser()->tab_strip_model()->GetIndexOfWebContents(
+          contents) == TabStripModel::kNoTab)
+    return;
+  if (slider == volume_slider_) {
+    const double gain = value * (active_ == Utility::kVolume ? 2.0 : 1.0);
+    contents->SetAudioVolume(gain);
+    slider->SetTooltipText(base::NumberToString16(std::lround(gain * 100)) +
+                           u"%");
+    slider->GetViewAccessibility().SetValue(
+        base::NumberToString16(std::lround(gain * 100)) + u" percent");
+  } else if (slider == seek_slider_) {
+    auto it = sources_.find(contents);
+    auto* session = content::MediaSession::GetIfExists(contents);
+    if (session && it != sources_.end() && it->second->Has(Action::kSeekTo) &&
+        it->second->position)
+      session->SeekTo(it->second->position->duration() * double(value));
+  }
+}
+
+bool EmberUtilityController::SourceStillValid() const {
+  return capture_source_ && !capture_source_->IsBeingDestroyed() &&
+         capture_document_.AsRenderFrameHostIfValid() ==
+             capture_source_->GetPrimaryMainFrame() &&
+         capture_source_->GetLastCommittedURL() == capture_url_;
+}
+void EmberUtilityController::CaptureSnap() {
+  paste_dispatched_ = false;
+  buttons_[Utility::kSnap]->SetTooltipText(u"ChatGPT Snap");
+  snap_requested_ = true;
+  const uint64_t generation = ++snap_generation_;
+  // Stop a closing side page at its currently displayed width until this
+  // renderer snapshot completes. Close's immediate path will settle it later.
+  if (snap_surface_ && snap_surface_->GetVisible() && !snap_visible_)
+    snap_transition_.Reset();
+  auto* source = browser_view_->GetActiveWebContents();
+  auto failure = [&](std::u16string message) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&EmberUtilityController::FinishSnapCapture,
+                                  weak_factory_.GetWeakPtr(), generation,
+                                  SkBitmap(), std::move(message)));
+  };
+  if (!source || source->IsBeingDestroyed() ||
+      !(source->GetLastCommittedURL().SchemeIsHTTPOrHTTPS() ||
+        source->GetLastCommittedURL().SchemeIsFile()) ||
+      !source->GetRenderWidgetHostView()) {
+    failure(u"Capture unavailable. Retry from a webpage.");
+    return;
+  }
+  capture_source_ = source->GetWeakPtr();
+  capture_document_ = source->GetPrimaryMainFrame()->GetWeakDocumentPtr();
+  capture_url_ = source->GetLastCommittedURL();
+  auto* view = source->GetRenderWidgetHostView();
+  capture_bounds_ = view->GetViewBounds();
+  const gfx::Size size = capture_bounds_.size();
+  if (size.IsEmpty() ||
+      int64_t(size.width()) * size.height() > 16 * 1024 * 1024) {
+    failure(u"Capture surface too large. Resize and Retry.");
+    return;
+  }
+  paste_phase_ = PastePhase::kWaiting;
+  snap_started_ = base::TimeTicks::Now();
+  view->CopyFromSurface(
+      gfx::Rect(size), size, base::Seconds(3),
+      base::BindPostTaskToCurrentDefault(base::BindOnce(
+          [](base::WeakPtr<EmberUtilityController> owner, uint64_t generation,
+             const content::CopyFromSurfaceResult& result) {
+            if (!owner || generation != owner->snap_generation_ ||
+                !owner->snap_requested_)
+              return;
+            if (!owner->SourceStillValid() || !result.has_value() ||
+                result->bitmap.drawsNothing() ||
+                result->bitmap.computeByteSize() > 64 * 1024 * 1024) {
+              owner->FinishSnapCapture(
+                  generation, SkBitmap(),
+                  u"Capture failed. Retry from your webpage.");
+              return;
+            }
+            owner->FinishSnapCapture(generation, result->bitmap,
+                                     std::u16string());
+          },
+          weak_factory_.GetWeakPtr(), generation)));
+}
+void EmberUtilityController::FinishSnapCapture(uint64_t generation,
+                                               SkBitmap image,
+                                               std::u16string error) {
+  if (generation != snap_generation_ || !snap_requested_)
+    return;
+  // The image is now frozen. Dismiss every older surface before introducing
+  // feedback or resizing; keep the just-captured source/document ownership.
+  Close(false, true, true);
+  browser_view_->CloseEmberSearch(false);
+  if (generation != snap_generation_)
+    return;
+  snap_requested_ = false;
+  active_ = Utility::kSnap;
+  anchor_ = buttons_[Utility::kSnap];
+  UpdateButtons();
+  if (!error.empty() || !SourceStillValid()) {
+    CancelPendingSnap();
+    EnsureSnapPage();
+    SnapStatus(error.empty() ? u"Source changed. Retry from your webpage."
+                             : std::move(error));
+    return;
+  }
+  pending_capture_ = image;
+  if (auto* view = capture_source_->GetRenderWidgetHostView())
+    capture_bounds_ = view->GetViewBounds();
+  capture_transition_.Open(gfx::RectF(0, 0, 1, 1), gfx::PointF(), 0);
+  feedback_timer_.Start(
+      FROM_HERE,
+      gfx::Animation::PrefersReducedMotion() ? base::TimeDelta()
+                                             : base::Milliseconds(120),
+      base::BindOnce(
+          [](base::WeakPtr<EmberUtilityController> owner, uint64_t generation) {
+            if (!owner || generation != owner->snap_generation_)
+              return;
+            owner->capture_transition_.Close(base::BindOnce(
+                [](base::WeakPtr<EmberUtilityController> owner,
+                   uint64_t generation) {
+                  if (!owner || generation != owner->snap_generation_)
+                    return;
+                  owner->capture_bounds_ = gfx::Rect();
+                  owner->SchedulePaint();
+                  owner->EnsureSnapPage();
+                  owner->SnapStatus(
+                      u"Preparing image. Log in to ChatGPT if needed.");
+                  owner->PollSnap();
+                  owner->snap_timer_.Start(
+                      FROM_HERE, base::Milliseconds(250),
+                      base::BindRepeating(&EmberUtilityController::PollSnap,
+                                          owner));
+                },
+                owner, generation));
+          },
+          weak_factory_.GetWeakPtr(), generation));
+}
+void EmberUtilityController::EnsureSnapPage() {
+  if (!snap_surface_) {
+    snap_surface_ = AddChildView(std::make_unique<views::View>());
+    snap_surface_->SetPaintToLayer();
+    snap_surface_->layer()->SetFillsBoundsOpaquely(false);
+    auto close = std::make_unique<EmberUtilityButton>(
+        base::BindRepeating(&EmberUtilityController::Close,
+                            weak_factory_.GetWeakPtr(), true, false, false),
+        u"Close Snap");
+    close->SetImageModel(views::Button::STATE_NORMAL,
+                         ui::ImageModel::FromVectorIcon(
+                             vector_icons::kCloseIcon, kForeground, 19));
+    snap_surface_->AddChildView(std::move(close));
+    snap_status_ =
+        snap_surface_->AddChildView(std::make_unique<views::Label>());
+    snap_status_->SetEnabledColor(kForeground);
+    snap_status_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    snap_page_ = snap_surface_->AddChildView(
+        std::make_unique<SnapPage>(browser_view_->GetProfile(), this));
+    auto retry = std::make_unique<views::LabelButton>(
+        base::BindRepeating(
+            [](EmberUtilityController* owner) {
+              if (owner->paste_phase_ == PastePhase::kWaiting &&
+                  owner->SourceStillValid() &&
+                  !owner->pending_capture_.drawsNothing()) {
+                owner->feedback_timer_.Stop();
+                owner->snap_started_ = base::TimeTicks::Now();
+                owner->snap_timer_.Start(
+                    FROM_HERE, base::Milliseconds(250),
+                    base::BindRepeating(&EmberUtilityController::PollSnap,
+                                        owner->weak_factory_.GetWeakPtr()));
+                owner->PollSnap();
+              } else if (owner->paste_phase_ == PastePhase::kIdle &&
+                         !owner->paste_dispatched_) {
+                owner->CancelPendingSnap();
+                owner->CaptureSnap();
+              } else {
+                owner->SnapStatus(u"Check your draft before capturing again.");
+              }
+            },
+            base::Unretained(this)),
+        u"Retry");
+    retry->SetEnabledTextColors(kForeground);
+    snap_surface_->AddChildView(std::move(retry));
+    snap_surface_->AddChildView(std::make_unique<views::ResizeArea>(this));
+  }
+  snap_visible_ = true;
+  browser_view_->SetEmberSnapSidebarMode(true);
+  snap_surface_->SetVisible(true);
+  snap_surface_->SetCanProcessEventsWithinSubtree(true);
+  snap_transition_.Open(gfx::RectF(0, 0, snap_width_, 1), gfx::PointF(0, 0),
+                        10);
+  browser_view_->InvalidateLayout();
+  Relayout();
+  capture_bounds_ = gfx::Rect();
+  SchedulePaint();
+}
+void EmberUtilityController::ApplySnapFrame(
+    const EmberGlassTransition::Frame& frame) {
+  snap_reveal_width_ =
+      std::max(0, int(std::lround(frame.bounds.width() * frame.opacity)));
+  browser_view_->InvalidateLayout();
+  if (browser_view_->GetWidget())
+    browser_view_->GetWidget()->GetRootView()->DeprecatedLayoutImmediately();
+}
+int EmberUtilityController::SnapWidth(int available_width) const {
+  return std::clamp(snap_reveal_width_, 0, std::max(0, available_width - 160));
+}
+void EmberUtilityController::OnResize(int amount, bool done) {
+  if (!resize_start_width_)
+    resize_start_width_ = snap_width_;
+  snap_width_ = std::clamp(resize_start_width_ + amount, 260, 560);
+  snap_transition_.Open(gfx::RectF(0, 0, snap_width_, 1), gfx::PointF(0, 0),
+                        10);
+  if (done)
+    resize_start_width_ = 0;
+}
+void EmberUtilityController::Relayout() {
+  SetBoundsRect(browser_view_->GetLocalBounds());
+  if (popover_ && anchor_) {
+    gfx::Point origin = anchor_->GetBoundsInScreen().right_center();
+    views::View::ConvertPointFromScreen(this, &origin);
+    const int w = std::max(1, std::min(active_ == Utility::kVolume       ? 216
+                                       : active_ == Utility::kWorkspaces ? 240
+                                                                         : 300,
+                                       width() - 12));
+    const int h = std::max(1, std::min(popover_height_, height() - 8));
+    gfx::Rect panel(
+        std::clamp(origin.x() + 8, 4, std::max(4, width() - w - 4)),
+        std::clamp(origin.y() - h, 4, std::max(4, height() - h - 4)), w, h);
+    panel.Outset(EmberGlassView::kShadowMargin);
+    popover_->SetBoundsRect(panel);
+    popover_body_->SetBoundsRect(popover_->GetPanelBounds());
+    if (media_scroll_)
+      media_scroll_->SetBoundsRect(popover_body_->GetLocalBounds());
+  }
+  if (snap_surface_ && snap_surface_->GetVisible()) {
+    gfx::Rect bounds = browser_view_->contents_container()->bounds();
+    const int width =
+        SnapWidth(browser_view_->width() - bounds.x() + snap_reveal_width_);
+    bounds.set_x(bounds.x() - width);
+    bounds.set_width(width);
+    snap_surface_->SetBoundsRect(bounds);
+    snap_surface_->children()[0]->SetBounds(std::max(0, width - 38), 0, 36, 32);
+    snap_status_->SetBounds(8, 0, std::max(0, width - 48), 32);
+    snap_status_->SetTooltipText(std::u16string(snap_status_->GetText()));
+    snap_page_->SetBounds(4, 32, std::max(0, width - 12),
+                          std::max(0, bounds.height() - 58));
+    snap_surface_->children()[3]->SetBounds(
+        8, std::max(0, bounds.height() - 26), 58, 24);
+    snap_surface_->children()[4]->SetBounds(std::max(0, width - 7), 32, 7,
+                                            std::max(0, bounds.height() - 32));
+  }
+}
+void EmberUtilityController::SnapStatus(std::u16string message) {
+  if (!snap_status_ && buttons_.contains(Utility::kSnap))
+    buttons_[Utility::kSnap]->SetTooltipText(message);
+  if (snap_status_) {
+    snap_status_->SetText(message);
+    snap_status_->SetTooltipText(message);
+  }
+}
+void EmberUtilityController::CancelPendingSnap() {
+  ++snap_generation_;
+  snap_requested_ = false;
+  snap_timer_.Stop();
+  script_pending_ = false;
+  feedback_timer_.Stop();
+  capture_transition_.Reset();
+  capture_bounds_ = gfx::Rect();
+  SchedulePaint();
+  pending_capture_.reset();
+  paste_digest_.clear();
+  paste_phase_ = PastePhase::kIdle;
+  capture_source_.reset();
+  capture_document_ = content::WeakDocumentPtr();
+  if (snap_page_ && snap_page_->web_contents() &&
+      snap_page_->web_contents()
+              ->GetLastCommittedURL()
+              .DeprecatedGetOriginAsURL() == GURL("https://chatgpt.com/")) {
+    const std::string js =
+        ui::ResourceBundle::GetSharedInstance().LoadDataResourceString(
+            IDR_EMBER_SNAP_COMPOSER);
+    snap_page_->web_contents()
+        ->GetPrimaryMainFrame()
+        ->ExecuteJavaScriptInIsolatedWorld(
+            base::UTF8ToUTF16(js + "({phase:'cancel'})"), base::NullCallback(),
+            ISOLATED_WORLD_ID_CHROME_INTERNAL);
+  }
+}
+void EmberUtilityController::PollSnap() {
+  if (paste_phase_ == PastePhase::kIdle || script_pending_ || !snap_visible_)
+    return;
+  if (!SourceStillValid()) {
+    CancelPendingSnap();
+    SnapStatus(u"Source closed or changed. Capture again.");
+    return;
+  }
+  if (base::TimeTicks::Now() - snap_started_ > base::Seconds(120)) {
+    snap_timer_.Stop();
+    if (paste_phase_ == PastePhase::kWaiting)
+      SnapStatus(u"Log in, then Retry. Image kept temporarily.");
+    else {
+      CancelPendingSnap();
+      SnapStatus(
+          u"Attachment unconfirmed. Check draft before capturing again.");
+    }
+    // Waiting capture has an absolute, bounded lifetime even without a retry.
+    feedback_timer_.Start(
+        FROM_HERE, base::Seconds(60),
+        base::BindOnce(&EmberUtilityController::CancelPendingSnap,
+                       weak_factory_.GetWeakPtr()));
+    return;
+  }
+  auto* contents = snap_page_->web_contents();
+  if (contents->GetBrowserContext() != browser_view_->GetProfile() ||
+      contents->GetLastCommittedURL().DeprecatedGetOriginAsURL() !=
+          GURL("https://chatgpt.com/")) {
+    SnapStatus(u"Log in to ChatGPT. Paste waits for its composer.");
+    return;
+  }
+  auto* frame = contents->GetPrimaryMainFrame();
+  if (paste_phase_ != PastePhase::kWaiting &&
+      (paste_document_.AsRenderFrameHostIfValid() != frame ||
+       paste_url_ != contents->GetLastCommittedURL())) {
+    CancelPendingSnap();
+    SnapStatus(u"Chat changed. Check draft before capturing again.");
+    return;
+  }
+  base::DictValue request;
+  request.Set("id", base::NumberToString(snap_generation_));
+  request.Set("digest", paste_digest_);
+  request.Set("phase", paste_phase_ == PastePhase::kWaiting    ? "prepare"
+                       : paste_phase_ == PastePhase::kPrepared ? "validate"
+                                                               : "check");
+  const auto json = base::WriteJson(request);
+  const std::string js =
+      ui::ResourceBundle::GetSharedInstance().LoadDataResourceString(
+          IDR_EMBER_SNAP_COMPOSER);
+  script_pending_ = true;
+  frame->ExecuteJavaScriptInIsolatedWorld(
+      base::UTF8ToUTF16(js + "(" + *json + ")"),
+      base::BindOnce(&EmberUtilityController::OnSnapScript,
+                     weak_factory_.GetWeakPtr(), snap_generation_,
+                     frame->GetWeakDocumentPtr(),
+                     contents->GetLastCommittedURL()),
+      ISOLATED_WORLD_ID_CHROME_INTERNAL);
+}
+void EmberUtilityController::OnSnapScript(uint64_t generation,
+                                          content::WeakDocumentPtr document,
+                                          GURL url,
+                                          base::Value result) {
+  if (generation != snap_generation_ || !snap_visible_ || !SourceStillValid())
+    return;
+  script_pending_ = false;
+  auto* dict = result.GetIfDict();
+  const std::string* state = dict ? dict->FindString("state") : nullptr;
+  if (!state) {
+    CancelPendingSnap();
+    SnapStatus(u"Composer unavailable. Close and try again.");
+    return;
+  }
+  auto* contents = snap_page_->web_contents();
+  if (document.AsRenderFrameHostIfValid() != contents->GetPrimaryMainFrame() ||
+      url != contents->GetLastCommittedURL()) {
+    CancelPendingSnap();
+    SnapStatus(u"Chat changed. Check draft before capturing again.");
+    return;
+  }
+  if (contents->GetBrowserContext() != browser_view_->GetProfile() ||
+      contents->GetLastCommittedURL().DeprecatedGetOriginAsURL() !=
+          GURL("https://chatgpt.com/")) {
+    CancelPendingSnap();
+    SnapStatus(u"Destination changed. Capture again.");
+    return;
+  }
+  if (*state == "prepared" && paste_phase_ == PastePhase::kWaiting) {
+    paste_phase_ = PastePhase::kPrepared;
+    paste_url_ = contents->GetLastCommittedURL();
+    paste_document_ = contents->GetPrimaryMainFrame()->GetWeakDocumentPtr();
+    contents->Focus();
+    PollSnap();
+    return;
+  }
+  if (*state == "prepared" && paste_phase_ == PastePhase::kPrepared) {
+    if (!paste_document_.AsRenderFrameHostIfValid() ||
+        contents->GetLastCommittedURL() != paste_url_)
+      return;
+    paste_phase_ =
+        PastePhase::kPasted;  // Commit before native asynchronous dispatch.
+    if (!contents->PasteImage(pending_capture_,
+                              paste_document_.AsRenderFrameHostIfValid(),
+                              &paste_digest_)) {
+      CancelPendingSnap();
+      SnapStatus(u"Image paste unavailable. Close and try again.");
+      return;
+    }
+    paste_dispatched_ = true;
+    pending_capture_.reset();
+    SnapStatus(u"Waiting for image attachment…");
+    return;
+  }
+  if (*state == "attached" && paste_phase_ == PastePhase::kPasted) {
+    CancelPendingSnap();
+    SnapStatus(u"Image attached. Type your message.");
+    contents->Focus();
+    return;
+  }
+  if (*state == "changed" || *state == "rejected") {
+    CancelPendingSnap();
+    SnapStatus(*state == "rejected"
+                   ? u"Attachment rejected. Check your draft."
+                   : u"Composer changed. Check your draft before retrying.");
+  } else if (*state == "login")
+    SnapStatus(u"Log in to ChatGPT; image will wait briefly.");
+}
+content::WebContents* EmberUtilityController::snap_contents_for_testing()
+    const {
+  return snap_page_ ? snap_page_->web_contents() : nullptr;
+}
+void EmberUtilityController::OnPaint(gfx::Canvas* canvas) {
+  if (capture_bounds_.IsEmpty() || pending_capture_.drawsNothing())
+    return;
+  gfx::Rect feedback = capture_bounds_;
+  feedback.Offset(-GetBoundsInScreen().x(), -GetBoundsInScreen().y());
+  cc::PaintFlags flags;
+  flags.setColor(
+      SkColorSetARGB(35 * capture_transition_.frame().opacity, 0, 0, 0));
+  canvas->DrawRect(feedback, flags);
+}
+bool EmberUtilityController::DoesIntersectRect(const views::View*,
+                                               const gfx::Rect& rect) const {
+  gfx::Rect panel;
+  if (popover_ && popover_body_) {
+    panel = popover_body_->bounds();
+    panel.Offset(popover_->bounds().origin().OffsetFromOrigin());
+  }
+  return panel.Intersects(rect) || (snap_surface_ && snap_visible_ &&
+                                    snap_surface_->bounds().Intersects(rect));
+}
+void EmberUtilityController::OnMouseEvent(ui::MouseEvent* event) {
+  if (event->type() != ui::EventType::kMousePressed ||
+      active_ == Utility::kNone || active_ == Utility::kSnap)
+    return;
+  gfx::Point point = event->root_location();
+  auto* target = static_cast<aura::Window*>(event->target());
+  if (!target)
+    return;
+  aura::Window::ConvertPointToTarget(target->GetRootWindow(),
+                                     GetWidget()->GetNativeWindow(), &point);
+  views::View::ConvertPointFromWidget(this, &point);
+  const gfx::Point screen =
+      GetBoundsInScreen().origin() + point.OffsetFromOrigin();
+  if (popover_body_ && popover_body_->GetBoundsInScreen().Contains(screen))
+    return;
+  if (footer_)
+    for (const auto& child : footer_->children())
+      if (child->GetVisible() && child->GetBoundsInScreen().Contains(screen))
+        return;
+  Close(false);
+}
+void EmberUtilityController::OnKeyEvent(ui::KeyEvent* event) {
+  if (event->type() == ui::EventType::kKeyPressed &&
+      event->key_code() == ui::VKEY_ESCAPE && active_ != Utility::kNone) {
+    Close();
+    event->SetHandled();
+  }
+}
