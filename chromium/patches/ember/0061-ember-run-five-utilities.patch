+std::u16string TimeText(base::TimeDelta time) {
+  if (time.is_max() || time.is_negative())
+    return u"--:--";
+  const int64_t seconds = time.InSeconds();
+  const int64_t remainder = seconds % 60;
+  return base::NumberToString16(seconds / 60) + u":" +
+         (remainder < 10 ? u"0" : u"") + base::NumberToString16(remainder);
+}
