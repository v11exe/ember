+    flags.setColor(SkColorSetARGB(GetEnabled() ? 240 : 65, 255, 255, 255));
+    canvas->DrawRoundRect(gfx::RectF(left, y - 1.5, point - left, 3), 1.5,
+                          flags);
+    canvas->DrawCircle(gfx::PointF(point, y), HasFocus() ? 5 : 4, flags);
+  }
+};
