+std::u16string InternalPageName(const GURL& url) {
+  if (!url.SchemeIs("chrome") && !url.SchemeIs("ember")) {
+    return {};
+  }
+  const std::string_view host = url.host();
+  if (host == "newtab" || host == "new-tab-page") {
+    return u"New Tab";
+  }
+  if (host == "settings") {
+    return u"Settings";
+  }
+  if (host == "history") {
+    return u"History";
+  }
+  if (host == "downloads") {
+    return u"Downloads";
+  }
+  if (host == "bookmarks") {
+    return u"Bookmarks";
+  }
+  if (host == "extensions") {
+    return u"Extensions";
+  }
+  return {};
+}
+
+}  // namespace
+
+GURL ResolveInternalPageName(const std::u16string& text) {
+  const std::u16string name =
+      base::ToLowerASCII(base::TrimWhitespace(text, base::TRIM_ALL));
+  if (name == u"new tab" || name == u"newtab") {
+    return GURL(chrome::kChromeUINewTabURL);
+  }
+  if (name == u"settings" || name == u"preferences") {
+    return GURL(chrome::kChromeUISettingsURL);
+  }
+  if (name == u"history") {
+    return GURL(chrome::kChromeUIHistoryURL);
+  }
+  if (name == u"downloads") {
+    return GURL(chrome::kChromeUIDownloadsURL);
+  }
+  if (name == u"bookmarks") {
+    return GURL(chrome::kChromeUIBookmarksURL);
+  }
+  if (name == u"extensions" || name == u"addons") {
+    return GURL(chrome::kChromeUIExtensionsURL);
+  }
+  return GURL();
+}
