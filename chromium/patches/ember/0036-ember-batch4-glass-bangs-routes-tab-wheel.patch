+    const base::TimeTicks now = base::TimeTicks::Now();
+    const double elapsed =
+        std::clamp((now - last_tick_).InMillisecondsF(), 0.0, 64.0);
+    last_tick_ = now;
+    const double fraction = 1.0 - std::pow(0.78, elapsed / 16.667);
+    const double current = CurrentOffset().x();
