+  const TemplateURL* FindBang(std::string alias) {
+    const bool explicit_bang = !alias.empty() && alias.front() == '!';
+    if (explicit_bang) {
+      alias.erase(0, 1);
+    }
+    if (alias.empty() || alias.size() > 24 ||
+        (alias == "localhost" && !explicit_bang)) {
+      return nullptr;
+    }
+    for (char c : alias) {
+      if (!(c >= 'a' && c <= 'z') && !(c >= '0' && c <= '9') && c != '_' &&
+          c != '+' && c != '-') {
+        return nullptr;
+      }
+    }
+    if (!explicit_bang &&
+        (alias == "settings" || alias == "preferences" || alias == "history" ||
+         alias == "downloads" || alias == "bookmarks" ||
+         alias == "extensions" || alias == "addons" || alias == "newtab")) {
+      return nullptr;
+    }
+    TemplateURLService* service =
