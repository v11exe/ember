+void AddBang(TemplateURLService* service, const Bang& bang) {
+  TemplateURLData data;
+  data.SetShortName(bang.name);
+  data.SetKeyword(bang.alias);
+  data.SetURL(bang.url);
+  data.favicon_url = GURL(bang.favicon);
+  data.safe_for_autoreplace = false;
+  data.is_active = TemplateURLData::ActiveStatus::kTrue;
+  service->Add(std::make_unique<TemplateURL>(data));
+}
+
+}  // namespace
+
+void SeedDefaultBangs(TemplateURLService* service, PrefService* prefs) {
+  if (!service || !service->loaded() || !prefs ||
+      prefs->GetBoolean(prefs::kEmberBangsSeeded)) {
+    return;
+  }
+  for (const Bang& bang : kDefaults) {
+    if (!service->GetTemplateURLForKeyword(bang.alias)) {
+      AddBang(service, bang);
+    }
+  }
+  prefs->SetBoolean(prefs::kEmberBangsSeeded, true);
+}
+
+void RestoreDefaultBangs(TemplateURLService* service) {
+  if (!service || !service->loaded()) {
+    return;
+  }
+  for (const Bang& bang : kDefaults) {
+    if (const TemplateURL* existing =
+            service->GetTemplateURLForKeyword(bang.alias)) {
+      service->Remove(existing);
+    }
+    AddBang(service, bang);
+  }
+}
+
+GURL ResolveBangInput(TemplateURLService* service,
+                      const std::u16string& input) {
+  if (!service || !service->loaded()) {
+    return GURL();
+  }
+  const std::vector<std::u16string> words = base::SplitString(
+      input, u" \t\r\n", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+  if (words.empty()) {
+    return GURL();
+  }
+  const bool trailing = words.size() > 1 && words.back().starts_with(u"!");
+  std::u16string alias =
+      base::ToLowerASCII(trailing ? words.back() : words.front());
+  const bool explicit_bang = alias.starts_with(u"!");
+  if (explicit_bang) {
+    alias.erase(0, 1);
+  }
+  if (alias.empty() || alias.size() > 24 ||
+      (!explicit_bang && alias == u"localhost")) {
+    return GURL();
+  }
+  for (char16_t c : alias) {
+    if (!((c >= u'a' && c <= u'z') || (c >= u'0' && c <= u'9') || c == u'_' ||
+          c == u'+' || c == u'-')) {
+      return GURL();
+    }
+  }
+  const TemplateURL* bang = service->GetTemplateURLForKeyword(alias);
+  if (!bang) {
+    return GURL();
+  }
+  std::u16string query;
+  for (size_t i = trailing ? 0 : 1; i < words.size() - (trailing ? 1 : 0);
+       ++i) {
+    if (!query.empty()) {
+      query += u' ';
+    }
+    query += words[i];
+  }
+  const GURL expanded(bang->url_ref().ReplaceSearchTerms(
+      TemplateURLRef::SearchTermsArgs(query), service->search_terms_data()));
+  const GURL target = query.empty() ? expanded.GetWithEmptyPath() : expanded;
+  return target.is_valid() && target.SchemeIsHTTPOrHTTPS() ? target : GURL();
+}
