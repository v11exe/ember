+  bool OnMouseWheel(const ui::MouseWheelEvent& event) override {
+    const int delta = event.y_offset() ? event.y_offset() : event.x_offset();
+    if (!delta || !contents()) {
+      return false;
+    }
+    const float maximum = MaximumOffset();
+    if (maximum <= 1) {
+      return false;
+    }
+
+    const base::TimeTicks now = base::TimeTicks::Now();
+    const double gap =
+        last_wheel_.is_null() ? 1000.0 : (now - last_wheel_).InMillisecondsF();
+    last_wheel_ = now;
+    const double urgency = gap >= 0 && gap < 230
+                               ? std::min(2.8, 1.0 + (230.0 - gap) / 150.0)
+                               : 1.0;
+    const double stride = std::min(430.0, 132.0 * urgency) *
+                          std::clamp(std::abs(delta) / 120.0, 0.5, 3.0);
+    target_ = std::clamp(target_, 0.0, static_cast<double>(maximum));
+    const double next = target_ - std::copysign(stride, delta);
+    if (next < 0 && target_ < 0.5) {
+      overscroll_ = std::min(44.0, overscroll_ + 17.0);
+    } else if (next > maximum && target_ > maximum - 0.5) {
+      overscroll_ = std::max(-44.0, overscroll_ - 17.0);
+    } else {
+      target_ = std::clamp(next, 0.0, static_cast<double>(maximum));
+    }
+    if (!timer_.IsRunning()) {
+      last_tick_ = now;
+      timer_.Start(FROM_HERE, base::Milliseconds(16), this,
+                   &TabStripScrollContainer::Animate);
+    }
+    return true;
+  }
+
+  void Layout(PassKey) override {
+    LayoutSuperclass<views::ScrollView>(this);
+    target_ = std::clamp(target_, 0.0, static_cast<double>(MaximumOffset()));
+    if (CurrentOffset().x() > MaximumOffset()) {
+      ScrollToOffset(gfx::PointF(MaximumOffset(), 0));
+    }
+  }
