+IN_PROC_BROWSER_TEST_F(BrowserViewTest, EmberSplitBackdropLayerLifecycle) {
+  // Construction precedes theme attachment and must leave solid-layer opacity
+  // under SetColor() ownership. Textured glass needs transparent paint holes.
+  auto background = std::make_unique<MultiContentsBackgroundView>(browser_view());
+  ASSERT_EQ(ui::LAYER_SOLID_COLOR, background->layer()->type());
+  auto* attached = browser_view()->AddChildView(std::move(background));
+  ASSERT_EQ(ui::LAYER_TEXTURED, attached->layer()->type());
+  EXPECT_FALSE(attached->layer()->fills_bounds_opaquely());
+  browser_view()->RemoveChildViewT(attached);
+}
+
+#if BUILDFLAG(IS_WIN)
+IN_PROC_BROWSER_TEST_F(BrowserViewTest, EmberBackdropLeavesEmptySplitSlotsEmpty) {
+  auto* prefs = browser()->profile()->GetPrefs();
+  auto containers = browser_view()->GetContentsContainerViews();
+  std::vector<ContentsWebView*> empty_slots;
+  for (auto* container : containers) {
+    if (!container->contents_view()->web_contents()) {
+      empty_slots.push_back(container->contents_view());
+    }
+  }
+  ASSERT_FALSE(empty_slots.empty());
+  const int tab_count = browser()->tab_strip_model()->count();
+  // These preference changes execute the actual native backdrop update, which
+  // must inspect spare split views without implicitly creating WebContents.
+  prefs->SetBoolean(prefs::kEmberUnsplashEnabled, true);
+  prefs->SetBoolean(prefs::kEmberUnsplashEnabled, false);
+  EXPECT_EQ(tab_count, browser()->tab_strip_model()->count());
+  for (auto* slot : empty_slots) {
+    EXPECT_EQ(nullptr, slot->web_contents());
+  }
+}
+#endif
+
+IN_PROC_BROWSER_TEST_F(BrowserViewTest, EmberNewTabBackdropIgnoresPaneFocus) {
+  auto* prefs = browser()->profile()->GetPrefs();
+  prefs->SetBoolean(prefs::kEmberUnsplashEnabled, false);
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), GURL(chrome::kChromeUINewTabURL)));
+  auto* ntp = active_web_contents();
+  chrome::AddTabAt(browser(), GURL(url::kAboutBlankURL), -1, true);
+  auto* website = active_web_contents();
+  ASSERT_NE(ntp, website);
+  // A background/focus-independent NTP still reveals the native backdrop, but
+  // an ordinary page never loses its own opaque backing beside that NTP.
+  EXPECT_TRUE(browser_view()->IsEmberTranslucentNewTab(ntp));
+  EXPECT_FALSE(browser_view()->IsEmberTranslucentNewTab(website));
+  prefs->SetBoolean(prefs::kEmberUnsplashEnabled, true);
+  EXPECT_FALSE(browser_view()->IsEmberTranslucentNewTab(ntp));
+  prefs->SetBoolean(prefs::kEmberUnsplashEnabled, false);
+}
+
+IN_PROC_BROWSER_TEST_F(BrowserViewTest, EmberRailKeepsOneColumnInBothWidths) {
+  auto* prefs = browser()->profile()->GetPrefs();
+  prefs->SetInteger(prefs::kEmberFavoritesColumns, 4);
+  prefs->SetInteger(prefs::kEmberFavoritesRows, 7);
+  for (const bool wide : {false, true}) {
+    prefs->SetBoolean(prefs::kEmberSidebarWide, wide);
+    EXPECT_EQ(1, ember_favorites::GetColumns(prefs));
+    EXPECT_EQ(7u, ember_favorites::GetVisibleCapacity(prefs));
+    EXPECT_EQ(36, ember_favorites::GetGridTileHeight(7));
+    EXPECT_EQ(6, ember_favorites::GetGridGap(7));
+  }
+}
