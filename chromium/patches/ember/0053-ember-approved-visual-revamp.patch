+bool BrowserView::IsEmberTranslucentNewTab(
+    const content::WebContents* contents) const {
+  if (!GetIsNormalType() || !contents ||
+      GetProfile()->GetPrefs()->GetBoolean(prefs::kEmberUnsplashEnabled)) {
+    return false;
+  }
+  const GURL url = contents->GetLastCommittedURL();
+  return url.SchemeIs(content::kChromeUIScheme) &&
+      (url.host() == chrome::kChromeUINewTabPageThirdPartyHost ||
+       url.host() == chrome::kChromeUINewTabHost);
+}
+
+void BrowserView::ShowEmberSearch() {
+  auto* location = GetLocationBarView();
+  if (!location || !GetWidget()) {
+    return;
+  }
+  const bool already_open = ember_search_panel_ && ember_search_panel_->GetVisible();
+  if (!ember_search_panel_) {
+    std::unique_ptr<views::View> host = std::make_unique<EmberFloatingSearchHost>(
+        base::BindRepeating(&BrowserView::HandleEmberSearchKey,
+                            weak_ptr_factory_.GetWeakPtr()));
+    ember_search_panel_ = AddChildView(std::move(host));
+    location->ClearProperty(views::kFlexBehaviorKey);
+    location->ClearProperty(views::kMarginsKey);
+    ember_search_panel_->AddChildView(location->parent()->RemoveChildViewT(location));
+    static_cast<views::BoxLayout*>(ember_search_panel_->GetLayoutManager())
+        ->SetFlexForView(location, 1);
+    // Retain the existing Copy Link action in the floating address surface.
+    ember_search_panel_->AddChildView(ember_sidebar_address_row_->RemoveChildViewT(
+        ember_sidebar_copy_link_.get()));
+    auto close = std::make_unique<views::LabelButton>(
+        base::BindRepeating(&BrowserView::CloseEmberSearch,
+                            weak_ptr_factory_.GetWeakPtr()), u"×");
+    close->SetPreferredSize(gfx::Size(28, 36));
+    close->SetAccessibleName(u"Close search (Escape)");
+    ember_search_panel_->AddChildView(std::move(close));
+  }
+  ReorderChildView(ember_search_panel_, children().size() - 1);
+  ember_search_panel_->SetVisible(true);
+  location->SetVisible(true);
+  LayoutEmberSearch();
+  if (!already_open) {
+    ember_search_bang_alias_.clear();
+    GetLocationBar()->GetOmniboxView()->RevertAll();
+  }
+  location->FocusLocation(true, false);
+  GetLocationBar()->GetOmniboxView()->SelectAll(false);
+}
+
+void BrowserView::ScheduleEmberSearchBang() {
+  if (ember_search_panel_ && ember_search_panel_->GetVisible()) {
+    // Complete the current native autocomplete notification before changing
+    // its edit model; weak ownership also covers browser/panel destruction.
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&BrowserView::SyncEmberSearchBang,
+                                 weak_ptr_factory_.GetWeakPtr()));
+  }
+}
+
+void BrowserView::SyncEmberSearchBang() {
+  if (!ember_search_panel_ || !ember_search_panel_->GetVisible()) {
+    return;
+  }
+  auto* model = GetLocationBar()->GetOmniboxController()->edit_model();
+  if (!model->user_input_in_progress() || model->is_keyword_selected()) {
+    return;
+  }
+  const auto raw = model->user_text();
+  if (raw.find_first_of(u" \t\r\n") == std::u16string::npos ||
+      ember::ResolveInternalPageName(raw).is_valid()) {
+    return;
+  }
+  auto* service = TemplateURLServiceFactory::GetForProfile(GetProfile());
+  std::u16string alias, query;
+  if (!ember::ResolveBangInput(service, raw, &alias, &query).is_valid()) {
+    return;
+  }
+  auto keyword = base::ToLowerASCII(alias);
+  if (keyword.starts_with(u"!")) {
+    keyword.erase(0, 1);
+  }
+  if (const auto* engine = service->GetTemplateURLForKeyword(keyword)) {
+    ember_search_bang_alias_ = alias;
+    GetLocationBar()->GetOmniboxView()->SetUserText(query, false);
+    model->EnterKeywordMode(metrics::OmniboxEventProto::SPACE_AT_END,
+                            engine, u"Search " + engine->short_name());
+  }
+}
+
+void BrowserView::HandleEmberSearchKey(ui::KeyEvent* event) {
+  if (event->type() != ui::EventType::kKeyPressed) {
+    return;
+  }
+  auto* omnibox = GetLocationBar()->GetOmniboxView();
+  auto* model = GetLocationBar()->GetOmniboxController()->edit_model();
+  auto* service = TemplateURLServiceFactory::GetForProfile(GetProfile());
+  const auto handled = [&] {
+    event->SetHandled();
+    event->StopPropagation();
+  };
+  if (event->key_code() == ui::VKEY_ESCAPE) {
+    CloseEmberSearch();
+    handled();
+    return;
+  }
+  if (event->key_code() == ui::VKEY_BACK && model->is_keyword_selected() &&
+      omnibox->GetText().empty() && !ember_search_bang_alias_.empty()) {
+    const std::u16string alias = ember_search_bang_alias_;
+    model->ClearKeyword();
+    omnibox->SetUserText(alias, true);
+    ember_search_bang_alias_.clear();
+    handled();
+    return;
+  }
+  if ((event->key_code() == ui::VKEY_SPACE || event->key_code() == ui::VKEY_TAB) &&
+      !event->IsControlDown() && !event->IsAltDown() && !event->IsShiftDown() &&
+      !model->is_keyword_selected()) {
+    const std::u16string raw = model->user_input_in_progress()
+                                   ? model->user_text() : omnibox->GetText();
+    // Use the same resolver and internal-command precedence as the existing
+    // sidebar and NTP. Native keyword mode supplies the chip, favicon, query
+    // editing and suggestions; a Bang remains a normal Quick Search.
+    if (!ember::ResolveInternalPageName(raw).is_valid() &&
+        ember::ResolveBangInput(service, raw).is_valid()) {
+      std::u16string alias = base::ToLowerASCII(raw);
+      if (alias.starts_with(u"!")) {
+        alias.erase(0, 1);
+      }
+      if (const auto* engine = service->GetTemplateURLForKeyword(alias)) {
+        ember_search_bang_alias_ = raw;
+        omnibox->SetUserText(u"", false);
+        model->EnterKeywordMode(metrics::OmniboxEventProto::SPACE_AT_END,
+                                engine, u"Search " + engine->short_name());
+        handled();
+        return;
+      }
+    }
+  }
+  if (event->key_code() == ui::VKEY_RETURN) {
+    const auto selection = model->GetPopupSelection();
+    if ((selection.line != 0 && selection.line != OmniboxPopupSelection::kNoMatch) ||
+        selection.state != OmniboxPopupSelection::NORMAL) {
+      // Native ranked suggestions and their keyboard actions own acceptance.
+      return;
+    }
+    std::u16string text = omnibox->GetText();
+    if (model->is_keyword_selected()) {
+      text = (ember_search_bang_alias_.empty() ? model->keyword()
+                                              : ember_search_bang_alias_) +
+             u" " + text;
+    }
+    if (ember::ResolveBangInput(service, text).is_valid() ||
+        ember::ResolveInternalPageName(text).is_valid()) {
+      CloseEmberSearch();
+      SubmitEmberSidebarAddress(std::move(text));
+      handled();
+    }
+  }
+}
+
+void BrowserView::CloseEmberSearch() {
+  if (!ember_search_panel_ || !ember_search_panel_->GetVisible()) {
+    return;
+  }
+  ember_search_bang_alias_.clear();
+  GetLocationBar()->GetOmniboxView()->RevertAll();
+  ember_search_panel_->SetVisible(false);
+  if (auto* contents = GetActiveWebContents()) {
+    contents->Focus();
+  }
+}
+
+void BrowserView::LayoutEmberSearch() {
+  if (!ember_search_panel_ || !ember_search_panel_->GetVisible()) {
+    return;
+  }
+  auto* active_pane = GetActiveContentsContainerView();
+  if (!active_pane) {
+    return;
+  }
+  gfx::Rect pane = active_pane->GetBoundsInScreen();
+  gfx::Point origin = pane.origin();
+  views::View::ConvertPointFromScreen(this, &origin);
+  const int panel_width = std::min(680, std::max(0, pane.width() - 24));
+  ember_search_panel_->SetBounds(origin.x() + (pane.width() - panel_width) / 2,
+                                origin.y() + 24, panel_width, 48);
+  ember_search_panel_->DeprecatedLayoutImmediately();
+}
