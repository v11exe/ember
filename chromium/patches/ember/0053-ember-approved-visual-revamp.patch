+    EXPECT_FALSE(model->is_keyword_selected());
+    browser_view()->CloseEmberSearch();
+  }
+  browser_view()->ShowEmberSearch();
+  omnibox->SetUserText(u"localhost", false);
+  ui::KeyEvent space(ui::EventType::kKeyPressed, ui::VKEY_SPACE, ui::EF_NONE);
+  browser_view()->HandleEmberSearchKey(&space);
+  EXPECT_FALSE(space.handled());
+  EXPECT_FALSE(model->is_keyword_selected());
+  browser_view()->CloseEmberSearch();
+}
