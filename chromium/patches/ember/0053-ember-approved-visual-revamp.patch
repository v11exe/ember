+IN_PROC_BROWSER_TEST_F(BrowserViewTest, EmberFloatingSearchSharesPastedBangParser) {
+  auto* service = TemplateURLServiceFactory::GetForProfile(browser()->profile());
+  search_test_utils::WaitForTemplateURLServiceToLoad(service);
+  ember::SeedDefaultBangs(service, browser()->profile()->GetPrefs());
+  auto* omnibox = browser_view()->GetLocationBar()->GetOmniboxView();
+  auto* model = browser_view()->GetLocationBar()->GetOmniboxController()->edit_model();
+  for (const auto* input : {u"!gpt snow & ice", u"snow & ice !gpt"}) {
+    browser_view()->ShowEmberSearch();
+    omnibox->SetUserText(input, false);
+    browser_view()->SyncEmberSearchBang();
+    EXPECT_TRUE(model->is_keyword_selected());
+    EXPECT_EQ(u"gpt", model->keyword());
+    EXPECT_EQ(u"snow & ice", omnibox->GetText());
+    EXPECT_EQ(ember::ResolveBangInput(service, input),
+              ember::ResolveBangInput(service, u"!gpt " + omnibox->GetText()));
+    // Ctrl+L while already open selects the existing query rather than losing it.
+    browser_view()->SetFocusToLocationBar(true);
+    EXPECT_EQ(u"snow & ice", omnibox->GetText());
+    EXPECT_TRUE(omnibox->IsSelectAll());
+    browser_view()->CloseEmberSearch();
+  }
+}
