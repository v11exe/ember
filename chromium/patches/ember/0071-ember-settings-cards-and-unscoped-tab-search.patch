+gfx::Image ChromeOmniboxClient::GetFaviconForOpenTabMatch(
+    const AutocompleteMatch& match) const {
+  auto identity_info = match.additional_info.find("ember_content_tab");
+  auto generation_info = match.additional_info.find("ember_content_generation");
+  uint64_t identity = 0, generation = 0;
+  if (identity_info == match.additional_info.end() ||
+      generation_info == match.additional_info.end() ||
+      !base::StringToUint64(identity_info->second, &identity) ||
+      !base::StringToUint64(generation_info->second, &generation)) {
+    return gfx::Image();
+  }
+  for (auto* browser : GetAllBrowserWindowInterfaces()) {
+    if (browser->GetProfile() != profile_) {
+      continue;
+    }
+    auto* model = browser->GetTabStripModel();
+    for (int index = 0; index < model->count(); ++index) {
+      auto* contents = model->GetWebContentsAt(index);
+      auto* state = ember::EmberPageState::FromWebContents(contents);
+      if (state && state->identity() == identity &&
+          state->generation() == generation &&
+          contents->GetLastCommittedURL() == match.destination_url) {
+        const gfx::Image icon = favicon::TabFaviconFromWebContents(contents);
+        return icon.IsEmpty() ? favicon::GetDefaultFavicon() : icon;
+      }
+    }
+  }
+  return gfx::Image();
+}
