+IN_PROC_BROWSER_TEST_F(BrowserViewTest,
+                       EmberUnscopedContentSearchUsesRealControllerAndInput) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  const auto url = embedded_test_server()->GetURL("/empty.html");
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), url));
+  auto* model = browser()->tab_strip_model();
+  auto* first = model->GetWebContentsAt(0);
+  ASSERT_TRUE(content::ExecJs(first, R"(
+    document.title = 'Lunar manual';
+    document.body.innerHTML = '<div style="height:4000px"></div><p id="passage">ember lunar needle readable passage</p><div style="height:3000px"></div>';
+  )"));
+  auto* state = ember::EmberPageState::FromWebContents(first);
+  ASSERT_TRUE(state);
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return state->text().find(u"ember lunar needle") != std::u16string::npos;
+  }));
+  chrome::AddTabAt(browser(), url, -1, true);
+  auto* duplicate = model->GetWebContentsAt(1);
+  ASSERT_TRUE(content::WaitForLoadStop(duplicate));
+  ASSERT_TRUE(content::ExecJs(
+      duplicate,
+      "document.title='Duplicate manual'; document.body.textContent='ember "
+      "lunar needle duplicate passage'"));
+  auto* duplicate_state = ember::EmberPageState::FromWebContents(duplicate);
+  ASSERT_TRUE(duplicate_state);
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return duplicate_state->text().find(u"ember lunar needle") !=
+           std::u16string::npos;
+  }));
+  chrome::AddTabAt(browser(), embedded_test_server()->GetURL("/title2.html"),
+                   -1, true);
+  ASSERT_TRUE(content::WaitForLoadStop(model->GetActiveWebContents()));
+  const int count = model->count();
+  browser_view()->ShowEmberSearch();
+  auto* title_controller =
+      browser_view()->GetLocationBar()->GetOmniboxController();
+  browser_view()->GetLocationBar()->GetOmniboxView()->SetUserText(
+      u"Lunar manual", true);
+  bool title_found = false;
+  for (const auto& match :
+       title_controller->autocomplete_controller()->result()) {
+    auto identity = match.additional_info.find("ember_content_tab");
+    if (identity != match.additional_info.end() &&
+        identity->second == base::NumberToString(state->identity())) {
+      title_found = true;
+      EXPECT_EQ(u"Open in Different Tab", match.contents);
+      EXPECT_EQ(u"Lunar manual", match.description);
+      EXPECT_TRUE(match.additional_info.at("ember_content_query").empty());
+    }
+  }
+  EXPECT_TRUE(title_found);
+  browser_view()->CloseEmberSearch();
+  for (bool keyboard : {false, true}) {
+    ASSERT_TRUE(content::ExecJs(first, "window.scrollTo(0,0)"));
+    model->ActivateTabAt(2);
+    browser_view()->ShowEmberSearch();
+    auto* controller = browser_view()->GetLocationBar()->GetOmniboxController();
+    browser_view()->GetLocationBar()->GetOmniboxView()->SetUserText(
+        u"ember lunar needle", true);
+    size_t selected_line = OmniboxPopupSelection::kNoMatch;
+    size_t identities = 0;
+    const auto& result = controller->autocomplete_controller()->result();
+    for (size_t line = 0; line < result.size(); ++line) {
+      const auto& match = result.match_at(line);
+      auto identity = match.additional_info.find("ember_content_tab");
+      if (identity == match.additional_info.end()) {
+        continue;
+      }
+      ++identities;
+      if (identity->second == base::NumberToString(state->identity())) {
+        selected_line = line;
+        EXPECT_EQ(u"Open in Different Tab", match.contents);
+        EXPECT_NE(std::u16string::npos,
+                  match.description.find(u"ember lunar needle"));
+        EXPECT_FALSE(
+            controller->client()->GetFaviconForOpenTabMatch(match).IsEmpty());
+      }
+    }
+    EXPECT_EQ(2u, identities);
+    ASSERT_NE(OmniboxPopupSelection::kNoMatch, selected_line);
+    auto* widget = browser_view()->GetWidget();
+#if BUILDFLAG(IS_WIN)
+    auto* native = widget->GetNativeWindow();
+    auto* dispatcher = native->GetHost()->dispatcher();
+#endif
+    if (keyboard) {
+      for (size_t step = 0;
+           controller->edit_model()->GetPopupSelection().line !=
+               selected_line &&
+           step < result.size();
+           ++step) {
+        ui::KeyEvent tab(ui::EventType::kKeyPressed, ui::VKEY_TAB, ui::EF_NONE);
+#if BUILDFLAG(IS_WIN)
+        dispatcher->OnEventFromSource(&tab);
+#else
+        widget->OnKeyEvent(&tab);
+#endif
+      }
+      ASSERT_EQ(selected_line,
+                controller->edit_model()->GetPopupSelection().line);
+      EXPECT_EQ(OmniboxPopupSelection::NORMAL,
+                controller->edit_model()->GetPopupSelection().state);
+      ui::KeyEvent enter(ui::EventType::kKeyPressed, ui::VKEY_RETURN,
+                         ui::EF_NONE);
+#if BUILDFLAG(IS_WIN)
+      dispatcher->OnEventFromSource(&enter);
+#else
+      widget->OnKeyEvent(&enter);
+#endif
+    } else {
+      auto* popup = static_cast<OmniboxPopupViewViews*>(
+          browser_view()->GetLocationBarView()->GetOmniboxPopupView());
+      OmniboxResultView* row = nullptr;
+      std::vector<views::View*> pending = {popup};
+      while (!pending.empty()) {
+        auto* view = pending.back();
+        pending.pop_back();
+        if (auto* candidate = views::AsViewClass<OmniboxRowView>(view);
+            candidate && candidate->line() == selected_line) {
+          row = candidate->result_view();
+          break;
+        }
+        for (const auto& child : view->children()) {
+          pending.push_back(child.get());
+        }
+      }
+      ASSERT_TRUE(row);
+      gfx::Point point = row->GetBoundsInScreen().CenterPoint();
+      views::View::ConvertPointFromScreen(widget->GetRootView(), &point);
+#if BUILDFLAG(IS_WIN)
+      aura::Window::ConvertPointToTarget(native, native->GetRootWindow(),
+                                         &point);
+#endif
+      ui::MouseEvent press(ui::EventType::kMousePressed, point, point,
+                           base::TimeTicks::Now(), ui::EF_LEFT_MOUSE_BUTTON,
+                           ui::EF_LEFT_MOUSE_BUTTON);
+      ui::MouseEvent release(ui::EventType::kMouseReleased, point, point,
+                             base::TimeTicks::Now(), ui::EF_NONE,
+                             ui::EF_LEFT_MOUSE_BUTTON);
+#if BUILDFLAG(IS_WIN)
+      dispatcher->OnEventFromSource(&press);
+      dispatcher->OnEventFromSource(&release);
+#else
+      widget->OnMouseEvent(&press);
+      widget->OnMouseEvent(&release);
+#endif
+    }
+    EXPECT_EQ(0, model->active_index());
+    EXPECT_EQ(count, model->count());
+    ASSERT_TRUE(base::test::RunUntil([&] {
+      return content::EvalJs(first, "window.scrollY > 2000").ExtractBool();
+    }));
+    EXPECT_TRUE(base::test::RunUntil(
+        [&] { return !browser_view()->IsEmberSearchOpen(); }));
+  }
+}
