+IN_PROC_BROWSER_TEST_F(BrowserViewTest, EmberSearchMotionRetargetAndReduce) {
+  gfx::Animation::SetPrefersReducedMotionForTesting(true);
+  ember::EmberGlassTransition::Frame last;
+  ember::EmberGlassTransition motion(base::BindRepeating(
+      [](ember::EmberGlassTransition::Frame* last,
+         const ember::EmberGlassTransition::Frame& frame) { *last = frame; }, &last));
+  motion.Open(gfx::RectF(0, 0, 680, 62), gfx::PointF(0, 25), 10);
+  EXPECT_EQ(gfx::RectF(0, 0, 680, 62), last.bounds);
+  motion.Open(gfx::RectF(0, 0, 680, 222), gfx::PointF(0, 25), 10);
+  EXPECT_EQ(222.f, last.bounds.height());
+  bool closed = false;
+  motion.Close(base::BindOnce([](bool* value) { *value = true; }, &closed));
+  EXPECT_TRUE(closed);
+  motion.Open(gfx::RectF(0, 0, 680, 62), gfx::PointF(0, 25), 10);
+  EXPECT_EQ(1.f, last.opacity);
+  gfx::Animation::SetPrefersReducedMotionForTesting(false);
+  motion.Open(gfx::RectF(0, 0, 680, 262), gfx::PointF(0, 25), 10);
+  EXPECT_EQ(62.f, last.bounds.height());
+  motion.Close(base::DoNothing());
+  const auto interrupted_height = last.bounds.height();
+  motion.Open(gfx::RectF(0, 0, 680, 162), gfx::PointF(0, 25), 10);
+  EXPECT_NEAR(interrupted_height, last.bounds.height(), 1.f);
+  motion.Reset();
 }
 
