 IN_PROC_BROWSER_TEST_F(BrowserViewTest,
+                       EmberUtilityClicksHandleViewsAndAuraTargets) {
+  using Utility = ember::EmberUtilityController::Utility;
+  auto* owner = browser_view()->ember_utilities();
+  auto* widget = browser_view()->GetWidget();
+  gfx::Animation::SetPrefersReducedMotionForTesting(true);
+  for (Utility utility : {Utility::kMedia, Utility::kWorkspaces}) {
+    owner->Toggle(utility, owner->footer_for_testing()->children()[0].get());
+    widget->GetRootView()->DeprecatedLayoutImmediately();
+    auto* body = owner->popover_content_for_testing();
+    gfx::Point point = body->GetBoundsInScreen().CenterPoint();
+    views::View::ConvertPointFromScreen(widget->GetRootView(), &point);
+    aura::Window::ConvertPointToTarget(
+        widget->GetNativeWindow(), widget->GetNativeWindow()->GetRootWindow(),
+        &point);
+    ui::MouseEvent press(ui::EventType::kMousePressed, point, point,
+                         base::TimeTicks::Now(), ui::EF_LEFT_MOUSE_BUTTON,
+                         ui::EF_LEFT_MOUSE_BUTTON);
+    // The real crash required a Views target, not an Aura target or null.
+    ui::Event::DispatcherApi(&press).set_target(body);
+    owner->OnMouseEvent(&press);
+    EXPECT_EQ(utility, owner->active());
+    ui::Event::DispatcherApi(&press).set_target(widget->GetNativeWindow());
+    owner->OnMouseEvent(&press);
+    EXPECT_EQ(utility, owner->active());
+    press.set_root_location(gfx::Point(-100, -100));
+    owner->OnMouseEvent(&press);
+    EXPECT_EQ(Utility::kNone, owner->active());
+  }
+  gfx::Animation::SetPrefersReducedMotionForTesting(false);
+}
