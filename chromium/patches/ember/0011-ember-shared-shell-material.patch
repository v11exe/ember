+// The same window-relative material as Ember's shell-material.css. Every
+// bounded Views surface samples this coordinate system, including on resize.
+void PaintEmberShell(gfx::Canvas* canvas,
+                     const views::View* view,
+                     const BrowserView* browser_view) {
+  const float width = browser_view->width();
+  const float height = browser_view->height();
+  if (width <= 0 || height <= 0) {
+    return;
+  }
+
+  gfx::ScopedCanvas scoped(canvas);
+  canvas->ClipRect(view->GetLocalBounds());
+  gfx::Point origin;
+  views::View::ConvertPointToTarget(view, browser_view, &origin);
+  canvas->Translate(gfx::Vector2d(-origin.x(), -origin.y()));
+  const gfx::Rect bounds = browser_view->GetLocalBounds();
+
+  // CSS 110deg: project the window onto the gradient axis.
+  constexpr float dx = 0.93969262f;
+  constexpr float dy = 0.34202014f;
+  const float half_length = (width * dx + height * dy) * 0.5f;
+  const SkPoint endpoints[] = {
+      {width * 0.5f - dx * half_length, height * 0.5f - dy * half_length},
+      {width * 0.5f + dx * half_length, height * 0.5f + dy * half_length}};
+  const SkColor4f base_colors[] = {
+      SkColor4f::FromColor(SkColorSetRGB(0x1A, 0x10, 0x0A)),
+      SkColor4f::FromColor(SkColorSetRGB(0x12, 0x10, 0x0F)),
+      SkColor4f::FromColor(SkColorSetRGB(0x0E, 0x0E, 0x0E)),
+      SkColor4f::FromColor(SkColorSetRGB(0x0B, 0x0B, 0x0C))};
+  const SkScalar base_stops[] = {0.0f, 0.29f, 0.60f, 1.0f};
+  const SkGradient::Interpolation interpolation = {
+      .fInPremul = SkGradient::Interpolation::InPremul::kYes,
+      .fColorSpace = SkGradient::Interpolation::ColorSpace::kSRGB};
+  cc::PaintFlags flags;
+  flags.setShader(cc::PaintShader::MakeLinearGradient(
+      endpoints, base_colors, base_stops, 4, SkTileMode::kClamp, interpolation));
+  canvas->DrawRect(bounds, flags);
+
+  // Paint the lower radial layer first, matching CSS background order.
+  const SkColor4f broad_colors[] = {
+      {116.0f / 255.0f, 45.0f / 255.0f, 14.0f / 255.0f, 0.10f},
+      SkColors::kTransparent};
+  const SkScalar broad_stops[] = {0.0f, 0.64f};
+  SkMatrix broad = SkMatrix::Scale(width * 0.48f, height * 0.30f);
+  broad.postTranslate(width * 0.15f, 0.0f);
+  flags.setShader(cc::PaintShader::MakeRadialGradient(
+      SkPoint::Make(0, 0), 1.0f, broad_colors, broad_stops, 2,
+      SkTileMode::kClamp, interpolation, 0, &broad));
+  canvas->DrawRect(bounds, flags);
+
+  const SkColor4f glow_colors[] = {
+      {1.0f, 90.0f / 255.0f, 0.0f, 0.31f},
+      {165.0f / 255.0f, 58.0f / 255.0f, 5.0f / 255.0f, 0.19f},
+      {84.0f / 255.0f, 32.0f / 255.0f, 6.0f / 255.0f, 0.075f},
+      SkColors::kTransparent};
+  const SkScalar glow_stops[] = {0.0f, 0.21f, 0.45f, 0.69f};
+  SkMatrix glow = SkMatrix::Scale(width * 0.34f, height * 0.62f);
+  glow.postTranslate(width * 0.025f, height * 0.02f);
+  flags.setShader(cc::PaintShader::MakeRadialGradient(
+      SkPoint::Make(0, 0), 1.0f, glow_colors, glow_stops, 4,
+      SkTileMode::kClamp, interpolation, 0, &glow));
+  canvas->DrawRect(bounds, flags);
+}
