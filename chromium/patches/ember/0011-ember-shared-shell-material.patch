 void ThemedBackground::Paint(gfx::Canvas* canvas, views::View* view) const {
+  gfx::ScopedCanvas scoped(canvas);
+  // The root paints only the perimeter revealed around the real page. Child
+  // surfaces (sidebar and toolbar) remain bounded by their own Views clips.
+  if (view == browser_view_ && browser_view_->multi_contents_view() &&
+      browser_view_->multi_contents_view()->IsDrawn()) {
+    auto* contents = browser_view_->multi_contents_view();
+    const gfx::Rect bounds = views::View::ConvertRectToTarget(
+        contents, view, contents->GetLocalBounds());
+    const gfx::RoundedCornersF corners = contents->GetBackgroundRadii();
+    const SkVector radii[] = {
+        {corners.upper_left(), corners.upper_left()},
+        {corners.upper_right(), corners.upper_right()},
+        {corners.lower_right(), corners.lower_right()},
+        {corners.lower_left(), corners.lower_left()}};
+    canvas->ClipPath(
+        SkPath::RRect(SkRRect::MakeRectRadii(gfx::RectToSkRect(bounds), radii)),
+        true, SkClipOp::kDifference);
+  }
   PaintBackground(canvas, view, browser_view_, theme_choice_);
 }
 
