+IN_PROC_BROWSER_TEST_F(BrowserViewTest, EmberRoundedViewportExteriorKeepsShellTint) {
+  browser_view()->DeprecatedLayoutImmediately();
+  auto* contents = browser_view()->multi_contents_view();
+  const gfx::Rect viewport = views::View::ConvertRectToTarget(
+      contents, browser_view(), contents->GetLocalBounds());
+  ASSERT_GT(contents->GetBackgroundRadii().upper_left(), 0);
+  gfx::Canvas canvas(browser_view()->size(), 1.f, false);
+  browser_view()->background()->Paint(&canvas, browser_view());
+  const SkBitmap bitmap = canvas.GetBitmap();
+  EXPECT_GT(SkColorGetA(bitmap.getColor(viewport.x() + 1, viewport.y() + 1)), 0u);
+  EXPECT_GT(SkColorGetA(bitmap.getColor(
+      viewport.right() - 2, viewport.bottom() - 2)), 0u);
+  EXPECT_EQ(0u, SkColorGetA(bitmap.getColor(
+      viewport.CenterPoint().x(), viewport.CenterPoint().y())));
+}
