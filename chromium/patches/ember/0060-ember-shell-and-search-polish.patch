+gfx::Image ChromeOmniboxClient::GetEmberProviderFavicon(
+    const TemplateURL* provider, FaviconFetchedCallback callback) {
+  const GURL url = provider->favicon_url();
+  if (!url.SchemeIsHTTPOrHTTPS())
+    return favicon_cache_.GetFaviconForIconUrl(url, std::move(callback), false);
+  if (auto it = ember_provider_favicons_.find(url);
+      it != ember_provider_favicons_.end())
+    return it->second;
+  // FaviconCache only reads History's database; fresh/custom keyword icons
+  // need the existing profile image service to fetch their actual favicon.
+  gfx::Image cached = favicon_cache_.GetFaviconForIconUrl(
+      url, base::BindOnce([](const gfx::Image&) {}), false);
+  if (!cached.IsEmpty())
+    return cached;
+  auto* fetcher = BitmapFetcherServiceFactory::GetForBrowserContext(profile_);
+  if (!fetcher)
+    return gfx::Image();
+  auto [it, inserted] = ember_favicon_waiters_.try_emplace(url);
+  if (callback)
+    it->second.push_back(std::move(callback));
+  if (inserted) {
+    ember_favicon_requests_.push_back(fetcher->RequestImage(url, base::BindOnce(
+        [](base::WeakPtr<ChromeOmniboxClient> client, GURL icon_url,
+           SkBitmap bitmap) {
+          if (!client)
+            return;
+          gfx::Image image;
+          if (!bitmap.drawsNothing()) {
+            image = gfx::Image(gfx::ImageSkiaOperations::CreateResizedImage(
+                gfx::ImageSkia::CreateFrom1xBitmap(bitmap),
+                skia::ImageOperations::RESIZE_LANCZOS3, gfx::Size(16, 16)));
+          }
+          // Cache failures as well: typing must not retry a missing icon.
+          if (client->ember_provider_favicons_.size() >= 128)
+            client->ember_provider_favicons_.erase(
+                client->ember_provider_favicons_.begin());
+          client->ember_provider_favicons_[icon_url] = image;
+          auto found = client->ember_favicon_waiters_.find(icon_url);
+          if (found == client->ember_favicon_waiters_.end())
+            return;
+          auto callbacks = std::move(found->second);
+          client->ember_favicon_waiters_.erase(found);
+          for (auto& waiting : callbacks)
+            std::move(waiting).Run(image);
+        }, weak_factory_.GetWeakPtr(), url)));
+  }
+  return gfx::Image();
 }
 
