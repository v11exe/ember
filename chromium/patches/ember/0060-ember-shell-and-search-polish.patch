+IN_PROC_BROWSER_TEST_F(BrowserViewTest, EmberToolbarDoesNotDoubleTintCaption) {
+  auto* toolbar = browser_view()->toolbar();
+  auto* top = browser_view()->top_container();
+  const gfx::Rect bounds = views::View::ConvertRectToTarget(
+      toolbar, top, toolbar->GetLocalBounds());
+  gfx::Canvas canvas(top->size(), 1.f, false);
+  top->background()->Paint(&canvas, top);
+  canvas.Translate(bounds.OffsetFromOrigin());
+  toolbar->background()->Paint(&canvas, toolbar);
+  const SkBitmap bitmap = canvas.GetBitmap();
+  // The composite must retain the same alpha as one shell surface.
+  gfx::Canvas single(toolbar->size(), 1.f, false);
+  toolbar->background()->Paint(&single, toolbar);
+  EXPECT_EQ(single.GetBitmap().getColor(toolbar->width() / 2, 1),
+      bitmap.getColor(bounds.CenterPoint().x(), bounds.y() + 1));
+}
