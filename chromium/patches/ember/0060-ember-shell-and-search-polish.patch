 // The native omnibox is hosted above the page, in the browser's own Widget.
 // Its controller, keyword state, ranked popup and navigation handlers survive.
+// Native actions retain their hit targets; their feedback is a centered square.
+class EmberSearchActionButton final : public views::LabelButton {
+  METADATA_HEADER(EmberSearchActionButton, views::LabelButton)
+ public:
+  explicit EmberSearchActionButton(PressedCallback callback)
+      : views::LabelButton(std::move(callback)) {
+    views::InkDrop::Get(this)->SetMode(views::InkDropHost::InkDropMode::OFF);
+  }
+  void SetSearchActive(bool active) {
+    active_ = active;
+    SchedulePaint();
+  }
+ protected:
+  void StateChanged(ButtonState old_state) override {
+    views::LabelButton::StateChanged(old_state);
+    SchedulePaint();
+  }
+  void PaintButtonContents(gfx::Canvas* canvas) override {
+    const int alpha = GetState() == STATE_PRESSED ? 44
+        : GetState() == STATE_HOVERED ? 30 : active_ ? 22 : 0;
+    const float side = std::min({28, width(), height()});
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setColor(SkColorSetARGB(alpha, 255, 255, 255));
+    canvas->DrawRoundRect(gfx::RectF((width() - side) / 2,
+        (height() - side) / 2, side, side), 6, flags);
+    views::LabelButton::PaintButtonContents(canvas);
+  }
+ private:
+  bool active_ = false;
+};
+BEGIN_METADATA(EmberSearchActionButton)
+END_METADATA
