+IN_PROC_BROWSER_TEST_F(BrowserViewTest, EmberProviderFaviconsFetchWithoutHistory) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  TemplateURLData data;
+  data.SetShortName(u"Test provider");
+  data.SetKeyword(u"provider");
+  data.SetURL("https://example.test/?q={searchTerms}");
+  data.favicon_url = embedded_test_server()->GetURL("/android/favicon.png");
+  TemplateURL provider(data);
+  auto* client = browser_view()->GetLocationBar()->GetOmniboxController()->client();
+  base::test::TestFuture<gfx::Image> first, second;
+  EXPECT_TRUE(client->GetFaviconForKeywordSearchProvider(
+      &provider, first.GetCallback<const gfx::Image&>()).IsEmpty());
+  gfx::Image simultaneous = client->GetFaviconForKeywordSearchProvider(
+      &provider, second.GetCallback<const gfx::Image&>());
+  ASSERT_TRUE(first.Wait());
+  EXPECT_FALSE(first.Get().IsEmpty());
+  EXPECT_EQ(16, first.Get().Width());
+  if (simultaneous.IsEmpty()) {
+    ASSERT_TRUE(second.Wait());
+    EXPECT_FALSE(second.Get().IsEmpty());
+  }
+  gfx::Image cached = client->GetFaviconForKeywordSearchProvider(
+      &provider, base::BindOnce([](const gfx::Image&) {}));
+  EXPECT_FALSE(cached.IsEmpty());
+  EXPECT_EQ(16, cached.Height());
+}
