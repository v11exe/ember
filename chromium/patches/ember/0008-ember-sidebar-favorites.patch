+void BrowserView::InitializeEmberFavorites() {
+  ember_bookmark_model_ =
+      BookmarkModelFactory::GetForBrowserContext(browser_->profile());
+  if (!ember_bookmark_model_) {
+    return;
+  }
+  ember_bookmark_model_observation_.Observe(ember_bookmark_model_);
+  ScheduleEmberFavoritesRefresh();
+}
+
+const bookmarks::BookmarkNode* BrowserView::GetEmberFavoritesFolder() const {
+  if (!ember_bookmark_model_ || !ember_bookmark_model_->loaded()) {
+    return nullptr;
+  }
+
+  return FindMarkedEmberFavoritesFolder(ember_bookmark_model_->root_node());
+}
+
+void BrowserView::BookmarkModelChanged() {
+  ScheduleEmberFavoritesRefresh();
+}
+
+void BrowserView::ScheduleEmberFavoritesRefresh() {
+  if (!ember_bookmark_model_ || !ember_bookmark_model_->loaded() ||
+      ember_updating_favorites_ || ember_favorites_refresh_pending_) {
+    return;
+  }
+  ember_favorites_refresh_pending_ = true;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&BrowserView::RefreshEmberFavorites,
+                     weak_ptr_factory_.GetWeakPtr()));
+}
+
+void BrowserView::RefreshEmberFavorites() {
+  ember_favorites_refresh_pending_ = false;
+  if (!ember_bookmark_model_ || !ember_bookmark_model_->loaded() ||
+      ember_updating_favorites_) {
+    return;
+  }
+
+  base::AutoReset<bool> updating(&ember_updating_favorites_, true);
+  const bookmarks::BookmarkNode* folder = GetEmberFavoritesFolder();
+  const bookmarks::BookmarkNode* other = ember_bookmark_model_->other_node();
+  std::string initialized_marker;
+  const bool initialized =
+      other->GetMetaInfo(kEmberFavoritesInitializedMetaKey,
+                         &initialized_marker) &&
+      initialized_marker == kEmberFavoritesFolderMetaValue;
+  if (!initialized) {
+    ember_bookmark_model_->SetNodeMetaInfo(
+        other, kEmberFavoritesInitializedMetaKey,
+        kEmberFavoritesFolderMetaValue);
+  }
+  if (!initialized && !folder) {
+    bookmarks::BookmarkNode::MetaInfoMap metadata = {
+        {kEmberFavoritesFolderMetaKey, kEmberFavoritesFolderMetaValue}};
+    folder = ember_bookmark_model_->AddFolder(
+        other, other->children().size(), u"Ember Favorites", &metadata);
+    ember_bookmark_model_->AddURL(folder, folder->children().size(), u"Google",
+                                  GURL("https://www.google.com/"));
+    ember_bookmark_model_->AddURL(folder, folder->children().size(),
+                                  u"YouTube",
+                                  GURL("https://www.youtube.com/"));
+    ember_bookmark_model_->AddURL(folder, folder->children().size(),
+                                  u"Google Calendar",
+                                  GURL("https://calendar.google.com/"));
+  }
+  RebuildEmberFavorites();
+}
+
+void BrowserView::BookmarkModelBeingDeleted() {
+  ember_bookmark_model_observation_.Reset();
+  ember_bookmark_model_ = nullptr;
+  ember_favorites_refresh_pending_ = false;
+  RebuildEmberFavorites(/*force=*/true);
+}
+
+void BrowserView::BookmarkMetaInfoChanged(
+    const bookmarks::BookmarkNode* node) {
+  ScheduleEmberFavoritesRefresh();
+}
+
+void BrowserView::BookmarkNodeFaviconChanged(
+    const bookmarks::BookmarkNode* node) {
+  const bookmarks::BookmarkNode* folder = GetEmberFavoritesFolder();
+  if (folder && node && node->parent() == folder) {
+    RebuildEmberFavorites(/*force=*/true);
+  }
+}
