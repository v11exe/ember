 namespace {
 
+constexpr char kEmberFavoritesFolderMetaKey[] = "ember_favorites_folder";
+constexpr char kEmberFavoritesFolderMetaValue[] = "1";
+constexpr char kEmberFavoritesInitializedMetaKey[] =
+    "ember_favorites_initialized";
+constexpr size_t kEmberVisibleFavoriteCount = 4;
+
+std::string EmberFavoriteHost(const GURL& url) {
+  std::string host = base::ToLowerASCII(url.host());
+  if (base::StartsWith(host, "www.")) {
+    host.erase(0, 4);
+  }
+  return host;
+}
+
+bool IsEmberFavoriteMatch(const GURL& favorite_url, const GURL& tab_url) {
+  if (!favorite_url.SchemeIsHTTPOrHTTPS() ||
+      !tab_url.SchemeIsHTTPOrHTTPS()) {
+    return false;
+  }
+
+  const std::string favorite_host = EmberFavoriteHost(favorite_url);
+  const std::string tab_host = EmberFavoriteHost(tab_url);
+  const std::string_view favorite_path = favorite_url.path();
+  const std::string_view tab_path = tab_url.path();
+  if (favorite_host.empty() || tab_host.empty()) {
+    return false;
+  }
+
+  if (favorite_path.empty() || favorite_path == "/") {
+    const std::string child_suffix = "." + favorite_host;
+    return tab_host == favorite_host || tab_host.ends_with(child_suffix);
+  }
+  return tab_host == favorite_host && tab_path == favorite_path;
+}
+
+const bookmarks::BookmarkNode* FindMarkedEmberFavoritesFolder(
+    const bookmarks::BookmarkNode* parent) {
+  if (!parent) {
+    return nullptr;
+  }
+  for (const auto& child : parent->children()) {
+    std::string marker;
+    if (child->is_folder() &&
+        child->GetMetaInfo(kEmberFavoritesFolderMetaKey, &marker) &&
+        marker == kEmberFavoritesFolderMetaValue) {
+      return child.get();
+    }
+    if (child->is_folder()) {
+      if (const bookmarks::BookmarkNode* match =
+              FindMarkedEmberFavoritesFolder(child.get())) {
+        return match;
+      }
+    }
+  }
+  return nullptr;
+}
