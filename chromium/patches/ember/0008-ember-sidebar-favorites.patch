+void BrowserView::RebuildEmberFavorites(bool force) {
+  if (!ember_sidebar_favorites_) {
+    return;
+  }
+
+  const bookmarks::BookmarkNode* folder = GetEmberFavoritesFolder();
+  std::vector<const bookmarks::BookmarkNode*> favorite_nodes;
+  std::vector<GURL> favorite_urls;
+  std::vector<std::u16string> favorite_titles;
+  if (folder && ember_bookmark_model_) {
+    for (const auto& child : folder->children()) {
+      if (!child->is_url() || !child->url().SchemeIsHTTPOrHTTPS()) {
+        continue;
+      }
+      if (favorite_nodes.size() >= kEmberVisibleFavoriteCount) {
+        break;
+      }
+      std::u16string title = child->GetTitle();
+      if (title.empty()) {
+        title = base::UTF8ToUTF16(EmberFavoriteHost(child->url()));
+      }
+      favorite_nodes.push_back(child.get());
+      favorite_urls.push_back(child->url());
+      favorite_titles.push_back(std::move(title));
+    }
+  }
+  if (!force && favorite_urls == ember_favorite_urls_ &&
+      favorite_titles == ember_favorite_titles_) {
+    return;
+  }
+
+  ember_favorite_urls_ = favorite_urls;
+  ember_favorite_titles_ = favorite_titles;
+  ember_favorite_buttons_.clear();
+  ember_sidebar_favorites_->RemoveAllChildViews();
+  views::View* row = nullptr;
+  for (size_t index = 0; index < favorite_nodes.size(); ++index) {
+    const bookmarks::BookmarkNode* child = favorite_nodes[index];
+    if (index % 2 == 0) {
+      row = ember_sidebar_favorites_->AddChildView(
+          std::make_unique<views::View>());
+      row->SetPreferredSize(gfx::Size(0, 43));
+      row->SetLayoutManager(std::make_unique<views::BoxLayout>(
+          views::BoxLayout::Orientation::kHorizontal, gfx::Insets(), 10));
+    }
+
+    auto button = std::make_unique<views::LabelButton>(
+        base::BindRepeating(&BrowserView::OpenEmberFavorite,
+                            weak_ptr_factory_.GetWeakPtr(), child->url()),
+        favorite_titles[index]);
+    button->SetPreferredSize(gfx::Size(71, 43));
+    button->SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(4, 5)));
+    button->SetElideBehavior(gfx::ELIDE_TAIL);
+    button->SetHorizontalAlignment(gfx::ALIGN_CENTER);
+    button->SetImageLabelSpacing(4);
+    button->SetFocusBehavior(views::View::FocusBehavior::ALWAYS);
+    button->SetFocusRingCornerRadius(9);
+    button->SetTooltipText(favorite_titles[index]);
+    std::u16string accessible_name = u"Open ";
+    accessible_name += favorite_titles[index];
+    button->GetViewAccessibility().SetName(accessible_name);
+    const gfx::Image& favicon = ember_bookmark_model_->GetFavicon(child);
+    if (!favicon.IsEmpty()) {
+      const gfx::ImageSkia resized =
+          gfx::ImageSkiaOperations::CreateResizedImage(
+              favicon.AsImageSkia(), skia::ImageOperations::RESIZE_BEST,
+              gfx::Size(19, 19));
+      button->SetImageModel(views::Button::STATE_NORMAL,
+                            ui::ImageModel::FromImageSkia(resized));
+    }
+
+    views::LabelButton* button_ptr = row->AddChildView(std::move(button));
+    ember_favorite_buttons_.push_back(button_ptr);
+  }
+
+  UpdateEmberFavoriteOpenStates();
+  ember_sidebar_favorites_->InvalidateLayout();
+  ember_sidebar_favorites_->SchedulePaint();
+}
+
+content::WebContents* BrowserView::FindEmberFavoriteTab(
+    const GURL& favorite_url) const {
+  content::WebContents* first_match = nullptr;
+  const bool broad = favorite_url.path().empty() || favorite_url.path() == "/";
+  const std::string favorite_host = EmberFavoriteHost(favorite_url);
+  GlobalBrowserCollection::GetInstance()->ForEach(
+      [&](BrowserWindowInterface* candidate) {
+        if (candidate->GetProfile() != browser_->profile() ||
+            candidate->GetType() != BrowserWindowInterface::TYPE_NORMAL) {
+          return true;
+        }
+        TabStripModel* tab_strip = candidate->GetTabStripModel();
+        for (int index = 0; index < tab_strip->count(); ++index) {
+          content::WebContents* contents = tab_strip->GetWebContentsAt(index);
+          const GURL tab_url =
+              contents ? contents->GetVisibleURL() : GURL();
+          if (!IsEmberFavoriteMatch(favorite_url, tab_url)) {
+            continue;
+          }
+          if (!first_match) {
+            first_match = contents;
+          }
+          if (broad && EmberFavoriteHost(tab_url) == favorite_host &&
+              tab_url.path() == "/") {
+            first_match = contents;
+            return false;
+          }
+        }
+        return true;
+      },
+      BrowserCollection::Order::kActivation);
+  return first_match;
+}
+
+void BrowserView::UpdateEmberFavoriteOpenStates() {
+  const size_t count =
+      std::min(ember_favorite_urls_.size(), ember_favorite_buttons_.size());
+  for (size_t index = 0; index < count; ++index) {
+    const bool is_open = FindEmberFavoriteTab(ember_favorite_urls_[index]);
+    ember_favorite_buttons_[index]->SetEnabledTextColors(
+        is_open ? SkColorSetRGB(0xFF, 0xC9, 0x3C)
+                : SkColorSetARGB(0xE6, 0xFF, 0xFF, 0xFF));
+    ember_favorite_buttons_[index]->SetBackground(
+        views::CreateRoundedRectBackground(
+            is_open ? SkColorSetARGB(0x38, 0xFF, 0xC9, 0x3C)
+                    : SkColorSetARGB(0x24, 0xFF, 0xFF, 0xFF),
+            9));
+  }
+}
+
+void BrowserView::OpenEmberFavorite(GURL favorite_url) {
+  if (content::WebContents* existing = FindEmberFavoriteTab(favorite_url)) {
+    BrowserWindowInterface* target =
+        GlobalBrowserCollection::GetInstance()->FindBrowserWithTab(existing);
+    if (target) {
+      TabStripModel* tab_strip = target->GetTabStripModel();
+      const int existing_index = tab_strip->GetIndexOfWebContents(existing);
+      if (existing_index != TabStripModel::kNoTab) {
+        tab_strip->ActivateTabAt(existing_index);
+        target->GetWindow()->Activate();
+        return;
+      }
+    }
+  }
+  chrome::AddTabAt(browser_.get(), favorite_url, -1, true);
+}
