+#include "chrome/browser/ui/views/ember/ember_glass_transition.h"
+#include <algorithm>
+#include <cmath>
+#include <numbers>
+#include <utility>
+#include "base/time/time.h"
+#include "ui/gfx/animation/animation.h"
+
+namespace ember {
+EmberGlassTransition::EmberGlassTransition(Update update)
+    : update_(std::move(update)), clock_(base::Milliseconds(340), 120, this) {}
+EmberGlassTransition::~EmberGlassTransition() = default;
+void EmberGlassTransition::Reset() {
+  clock_.Stop();
+  finished_.Reset();
+  initialized_ = false;
+  closing_ = false;
+  axes_ = {};
+}
+void EmberGlassTransition::Open(const gfx::RectF& bounds,
+                               const gfx::PointF& origin, float radius) {
+  if (bounds.IsEmpty()) return;
+  // Sample before reversing so both position and velocity are continuous.
+  if (clock_.is_animating())
+    Sample(clock_.GetCurrentValue() * (closing_ ? .190 : .340));
+  clock_.Stop();
+  finished_.Reset();
+  bounds_ = bounds;
+  anchor_ = gfx::PointF(std::clamp((origin.x() - bounds.x()) / bounds.width(), 0.f, 1.f),
+                        std::clamp((origin.y() - bounds.y()) / bounds.height(), 0.f, 1.f));
+  final_radius_ = radius;
+  if (!initialized_) {
+    axes_ = {};
+    frame_.opacity = 0.f;
+  }
+  initialized_ = true;
+  Start(false);
+}
+void EmberGlassTransition::Close(base::OnceClosure finished) {
+  if (closing_) return;
+  if (clock_.is_animating()) Sample(clock_.GetCurrentValue() * .340);
+  clock_.Stop();
+  finished_ = std::move(finished);
+  Start(true);
+}
+void EmberGlassTransition::Start(bool closing) {
+  closing_ = closing;
+  initial_ = axes_;
+  opacity_from_ = frame_.opacity;
+  if (gfx::Animation::PrefersReducedMotion()) {
+    AnimationEnded(&clock_);
+    return;
+  }
+  Publish();
+  clock_.SetDuration(base::Milliseconds(closing ? 190 : 340));
+  clock_.Start();
+}
+void EmberGlassTransition::Sample(double seconds) {
+  constexpr double responses[] = {.190, .220, .200};
+  constexpr double damping[] = {.84, .80, .84};
+  const double target = closing_ ? 0. : 1.;
+  for (size_t i = 0; i < axes_.size(); ++i) {
+    const double omega = 2. * std::numbers::pi / (closing_ ? .165 : responses[i]);
+    const double zeta = closing_ ? .92 : damping[i];
+    const double decay = zeta * omega;
+    const double wd = omega * std::sqrt(1. - zeta * zeta);
+    const double a = initial_[i].position - target;
+    const double b = (initial_[i].velocity + decay * a) / wd;
+    const double c = std::cos(wd * seconds), s = std::sin(wd * seconds);
+    const double e = std::exp(-decay * seconds);
+    axes_[i].position = target + e * (a * c + b * s);
+    axes_[i].velocity = e * ((b * wd - decay * a) * c -
+                             (a * wd + decay * b) * s);
+  }
+  const double t = std::clamp(seconds / (closing_ ? .125 : .085), 0., 1.);
+  const float fade = static_cast<float>(1. - std::pow(1. - t, 3.));
+  frame_.opacity = opacity_from_ + ((closing_ ? 0.f : 1.f) - opacity_from_) * fade;
+}
+void EmberGlassTransition::Publish() {
+  const float small_w = std::min(28.f, bounds_.width());
+  const float small_h = std::min(20.f, bounds_.height());
+  const float w = std::max(1.f, small_w + (bounds_.width() - small_w) * static_cast<float>(axes_[0].position));
+  const float h = std::max(1.f, small_h + (bounds_.height() - small_h) * static_cast<float>(axes_[1].position));
+  frame_.bounds = gfx::RectF(bounds_.x() + (bounds_.width() - w) * anchor_.x(),
+                            bounds_.y() + (bounds_.height() - h) * anchor_.y(), w, h);
+  frame_.radius = std::clamp(12.f + (final_radius_ - 12.f) * static_cast<float>(axes_[2].position),
+                             0.f, std::min(w, h) * .5f);
+  update_.Run(frame_);
+}
+void EmberGlassTransition::AnimationProgressed(const gfx::Animation*) {
+  Sample(clock_.GetCurrentValue() * (closing_ ? .190 : .340));
+  Publish();
+}
+void EmberGlassTransition::AnimationEnded(const gfx::Animation*) {
+  for (auto& axis : axes_) axis = {closing_ ? 0. : 1., 0.};
+  frame_.opacity = closing_ ? 0.f : 1.f;
+  Publish();
+  if (finished_) std::move(finished_).Run();
+}
