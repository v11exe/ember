+  void Sample(double seconds);
+  void Publish();
+  void Start(bool closing);
+  Update update_;
+  base::OnceClosure finished_;
+  gfx::LinearAnimation clock_;
+  Frame frame_;
+  gfx::RectF bounds_;
+  gfx::PointF anchor_;
+  std::array<Axis, 3> axes_{};
+  std::array<Axis, 3> initial_{};
+  float final_radius_ = 12.f;
