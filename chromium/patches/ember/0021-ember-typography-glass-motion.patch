+// Copyright 2026 The Ember Authors
+// Use of this source code is governed by a BSD-style license.
+#include "chrome/app/ember_typography_win.h"
+
+#include <windows.h>
+
+#include <array>
+#include <utility>
+#include <vector>
+
+#include "base/check.h"
+#include "base/strings/string_util.h"
+#include "base/win/current_module.h"
+#include "skia/ext/font_utils.h"
+#include "third_party/skia/include/core/SkData.h"
+#include "third_party/skia/include/core/SkFontMgr.h"
+#include "third_party/skia/include/core/SkFontStyle.h"
+#include "third_party/skia/include/core/SkStream.h"
+#include "third_party/skia/include/core/SkString.h"
+#include "third_party/skia/include/core/SkTypeface.h"
+#include "third_party/skia/include/ports/SkTypeface_win.h"
+
+namespace ember {
+namespace {
+
+// The original OFL faces live in the module: no user-font installation and no
+// dependency on an installed Inter version. Process-private GDI registration
+// lets Windows report the same metrics used by the native Skia text pipeline.
+class InterStyleSet final : public SkFontStyleSet {
+ public:
+  explicit InterStyleSet(const sk_sp<SkFontMgr>& system) {
+    constexpr std::array names = {
+        L"EMBER_INTER_REGULAR", L"EMBER_INTER_MEDIUM", L"EMBER_INTER_SEMIBOLD",
+        L"EMBER_INTER_BOLD", L"EMBER_INTER_ITALIC", L"EMBER_INTER_MEDIUMITALIC",
+        L"EMBER_INTER_SEMIBOLDITALIC", L"EMBER_INTER_BOLDITALIC"};
+    for (const wchar_t* name : names) {
+      HMODULE module = CURRENT_MODULE();
+      HRSRC resource = FindResourceW(module, name, RT_RCDATA);
+      // Resource overlays can be stripped by a downstream branding build;
+      // keep the browser usable and let DirectWrite provide fallback in that
+      // case instead of aborting browser startup.
+      if (!resource)
+        continue;
+      const DWORD size = SizeofResource(module, resource);
+      void* bytes = LockResource(LoadResource(module, resource));
+      if (!bytes || !size)
+        continue;
+      DWORD count = 0;
+      // These handles intentionally live until process exit. Removing the font
+      // while native labels or cached typefaces remain alive is unsafe.
+      if (!AddFontMemResourceEx(bytes, size, nullptr, &count))
+        continue;
+      auto face = system->makeFromData(SkData::MakeWithoutCopy(bytes, size));
+      if (face)
+        faces_.push_back(std::move(face));
+    }
+  }
+  int count() override { return static_cast<int>(faces_.size()); }
+  void getStyle(int index, SkFontStyle* style, SkString* name) override {
+    *style = faces_[index]->fontStyle();
+    if (name) {
+      name->reset();
+    }
+  }
+  sk_sp<SkTypeface> createTypeface(int index) override { return faces_[index]; }
+  sk_sp<SkTypeface> matchStyle(const SkFontStyle& style) override {
+    return matchStyleCSS3(style);
+  }
+ private:
+  std::vector<sk_sp<SkTypeface>> faces_;
+};
+
+bool IsInter(const char* name) {
+  return name && base::EqualsCaseInsensitiveASCII(name, "Inter");
+}
+
+// This manager is installed ONLY in the browser. It adds one explicit family;
+// the system manager continues to own every other family, fallback character,
+// font stream and default. Renderer/GPU/utility processes never execute this.
+class BrowserFontManager final : public SkFontMgr {
+ public:
+  BrowserFontManager()
+      : system_(SkFontMgr_New_DirectWrite()),
+        inter_(sk_make_sp<InterStyleSet>(system_)) {}
+ private:
+  int onCountFamilies() const override { return system_->countFamilies() + 1; }
+  void onGetFamilyName(int index, SkString* name) const override {
+    if (index == system_->countFamilies()) {
+      name->set("Inter");
+    } else {
+      system_->getFamilyName(index, name);
+    }
+  }
+  sk_sp<SkFontStyleSet> onCreateStyleSet(int index) const override {
+    return index == system_->countFamilies() ? inter_ : system_->createStyleSet(index);
+  }
+  sk_sp<SkFontStyleSet> onMatchFamily(const char name[]) const override {
+    return IsInter(name) ? inter_ : system_->matchFamily(name);
+  }
+  sk_sp<SkTypeface> onMatchFamilyStyle(const char name[],
+                                     const SkFontStyle& style) const override {
+    return IsInter(name) ? inter_->matchStyle(style)
+                         : system_->matchFamilyStyle(name, style);
+  }
+  sk_sp<SkTypeface> onMatchFamilyStyleCharacter(
+      const char name[], const SkFontStyle& style, const char* languages[],
+      int count, SkUnichar character) const override {
+    if (IsInter(name)) {
+      auto face = inter_->matchStyle(style);
+      if (face->unicharToGlyph(character)) {
+        return face;
+      }
+    }
+    return system_->matchFamilyStyleCharacter(name, style, languages, count,
+                                              character);
+  }
+  sk_sp<SkTypeface> onMakeFromData(sk_sp<SkData> data, int index) const override {
+    return system_->makeFromData(std::move(data), index);
+  }
+  sk_sp<SkTypeface> onMakeFromStreamIndex(std::unique_ptr<SkStreamAsset> stream,
+                                        int index) const override {
+    return system_->makeFromStream(std::move(stream), index);
+  }
+  sk_sp<SkTypeface> onMakeFromStreamArgs(std::unique_ptr<SkStreamAsset> stream,
+                                       const SkFontArguments& args) const override {
+    return system_->makeFromStream(std::move(stream), args);
+  }
+  sk_sp<SkTypeface> onMakeFromFile(const char path[], int index) const override {
+    return system_->makeFromFile(path, index);
+  }
+  sk_sp<SkTypeface> onLegacyMakeTypeface(const char name[],
+                                        SkFontStyle style) const override {
+    return IsInter(name) ? inter_->matchStyle(style)
+                         : system_->legacyMakeTypeface(name, style);
+  }
+  sk_sp<SkFontMgr> system_;
+  sk_sp<SkFontStyleSet> inter_;
+};
+}  // namespace
+
+void InitializeBrowserTypography() {
+  skia::OverrideDefaultSkFontMgr(sk_make_sp<BrowserFontManager>());
+}
+}  // namespace ember
