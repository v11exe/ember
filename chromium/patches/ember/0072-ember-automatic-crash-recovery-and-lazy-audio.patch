+// Fresh WebContents, including discard replacements, have no audio factory.
+TEST_F(WebContentsImplTest, EmberGainBeforeAnyAudioStream) {
+  EXPECT_DOUBLE_EQ(1.0, contents()->GetAudioVolume());
+  contents()->SetAudioVolume(1.0);
+  EXPECT_DOUBLE_EQ(1.0, contents()->GetAudioVolume());
+  contents()->SetAudioVolume(1.75);
+  EXPECT_DOUBLE_EQ(1.75, contents()->GetAudioVolume());
+  contents()->SetAudioVolume(-1.0);
+  EXPECT_DOUBLE_EQ(0.0, contents()->GetAudioVolume());
+  contents()->SetAudioVolume(3.0);
+  EXPECT_DOUBLE_EQ(2.0, contents()->GetAudioVolume());
+  contents()->SetAudioMuted(true);
+  contents()->SetAudioMuted(false);
+  EXPECT_DOUBLE_EQ(2.0, contents()->GetAudioVolume());
+}
