+    popup->CloseNow();
+    EXPECT_EQ(ember::EmberUtilityController::Utility::kNone, owner->active());
+    EXPECT_EQ(nullptr, owner->volume_for_testing());
+    owner->ShowVolume(active_web_contents(), anchor);
+    popup = owner->volume_for_testing()->GetWidget();
+    popup->GetFocusManager()->ProcessAccelerator(
+        ui::Accelerator(ui::VKEY_ESCAPE, ui::EF_NONE));
+    EXPECT_EQ(ember::EmberUtilityController::Utility::kNone, owner->active());
+    base::RunLoop().RunUntilIdle();
   }
   gfx::Animation::SetPrefersReducedMotionForTesting(false);
 }
