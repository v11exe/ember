-// A native owned widget gives utility controls their own input/focus root.
-// Retain EmberGlassView material and motion, including interrupted closes.
+// A popup must expose an explicit client hit area to both Windows and Aura.
+// TYPE_POPUP has no NonClientView, so Views reports HTNOWHERE despite correct
+// descendant hit tests. Keep a decoration-free native bubble frame instead.
+class UtilityPopupFrame : public views::FrameView {
+ public:
+  gfx::Rect GetBoundsForClientView() const override { return GetLocalBounds(); }
+  int NonClientHitTest(const gfx::Point& point) override {
+    gfx::Rect panel = GetLocalBounds();
+    panel.Inset(EmberGlassView::kShadowMargin);
+    return panel.Contains(point) ? HTCLIENT : HTTRANSPARENT;
+  }
+};
+class UtilityPopupWidget : public views::Widget {
+ public:
+  std::unique_ptr<views::FrameView> CreateFrameView() override {
+    return std::make_unique<UtilityPopupFrame>();
+  }
+};
