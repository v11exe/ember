     const {
   CHECK(browser_view_);
+  // Ember draws a custom titlebar over DWM acrylic. The upstream titlebar
+  // gate otherwise makes DesktopNativeWidgetAura clear the compositor and
+  // both Aura roots opaquely during Init/FrameTypeChanged/fullscreen restore.
+  if (browser_view_->GetIsNormalType()) {
+    return views::DesktopWindowTreeHostWin::ShouldWindowContentsBeTransparent();
+  }
   return !ShouldBrowserCustomDrawTitlebar(browser_view_) &&
          views::DesktopWindowTreeHostWin::ShouldWindowContentsBeTransparent();
 }
