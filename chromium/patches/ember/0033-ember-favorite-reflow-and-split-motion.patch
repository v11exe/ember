+  // compresses the page into its opposite half again.
+  const bool switching_background_side =
+      drag_type == DragType::kBackgroundTab && GetVisible() && side_ &&
+      *side_ != side;
+  if (switching_background_side && ShouldShowAnimation()) {
+    animation_.Reset(0);
+    SetVisible(false);
+  }
+  animation_.SetSlideDuration(base::Milliseconds(
+      switching_background_side ? 180 : kAnimationDurationMs));
+
   // If transitioning from a nudge to full state, start a new animation.
   if (state == DropTargetState::kNudgeToFull &&
       state_ == MultiContentsDropTargetView::DropTargetState::kNudge) {
