@@ -0,0 +1,29 @@
+// Copyright 2026 The Ember Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/frame/ember_url_presentation.h"
+
+#include "base/strings/utf_string_conversions.h"
+#include "components/url_formatter/url_formatter.h"
+#include "url/gurl.h"
+
+namespace ember {
+
+std::u16string FormatUrlForCompactDisplay(const GURL& url) {
+  if (!url.is_valid()) {
+    return base::UTF8ToUTF16(url.possibly_invalid_spec());
+  }
+
+  const url_formatter::FormatUrlTypes kCompactFormat =
+      url_formatter::kFormatUrlOmitUsernamePassword |
+      url_formatter::kFormatUrlOmitHTTP |
+      url_formatter::kFormatUrlOmitHTTPS |
+      url_formatter::kFormatUrlOmitTrailingSlashOnBareHostname |
+      url_formatter::kFormatUrlOmitTrivialSubdomains;
+  return url_formatter::FormatUrl(url, kCompactFormat,
+                                  base::UnescapeRule::SPACES, nullptr, nullptr,
+                                  nullptr);
+}
+
+}  // namespace ember
