+// Copyright 2026 The Ember Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/frame/ember_url_presentation.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace ember {
+
+TEST(FormatEmberSidebarUrlTest, OmitsOnlyOrdinaryWebDecoration) {
+  EXPECT_EQ(u"example.com/path",
+            FormatUrlForCompactDisplay(
+                GURL("https://www.example.com/path")));
+  EXPECT_EQ(u"example.com/path",
+            FormatUrlForCompactDisplay(GURL("http://www.example.com/path")));
+  EXPECT_EQ(u"docs.example.com/path",
+            FormatUrlForCompactDisplay(GURL("https://docs.example.com/path")));
+}
+
+TEST(FormatEmberSidebarUrlTest, PreservesMeaningfulSchemes) {
+  EXPECT_EQ(u"chrome://settings/",
+            FormatUrlForCompactDisplay(GURL("chrome://settings")));
+  EXPECT_EQ(u"ember://start/",
+            FormatUrlForCompactDisplay(GURL("ember://start")));
+  EXPECT_EQ(u"file:///C:/path/file.txt",
+            FormatUrlForCompactDisplay(GURL("file:///C:/path/file.txt")));
+  EXPECT_EQ(u"view-source:https://www.example.com/path",
+            FormatUrlForCompactDisplay(
+                GURL("view-source:https://www.example.com/path")));
+}
+
+}  // namespace ember
