+// Copyright 2026 The Ember Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_FRAME_EMBER_URL_PRESENTATION_H_
+#define CHROME_BROWSER_UI_VIEWS_FRAME_EMBER_URL_PRESENTATION_H_
+
+#include <string>
+
+class GURL;
+
+namespace ember {
+
+// Formats a URL for Ember's compact, non-editing browser chrome. The returned
+// text is presentation-only; navigation and clipboard actions must retain the
+// original GURL as their source of truth.
+std::u16string FormatUrlForCompactDisplay(const GURL& url);
+
+}  // namespace ember
+
+#endif  // CHROME_BROWSER_UI_VIEWS_FRAME_EMBER_URL_PRESENTATION_H_
