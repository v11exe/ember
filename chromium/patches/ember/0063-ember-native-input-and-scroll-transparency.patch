+IN_PROC_BROWSER_TEST_F(BrowserViewTest,
+                       EmberUtilityLayersAllowNativePageInput) {
+  using Utility = ember::EmberUtilityController::Utility;
+  auto* owner = browser_view()->ember_utilities();
+  auto* widget = browser_view()->GetWidget();
+  widget->GetRootView()->DeprecatedLayoutImmediately();
+  EXPECT_EQ(nullptr, owner->layer());
+  auto* child = active_web_contents()->GetNativeView();
+  auto* root = widget->GetNativeWindow();
+  while (child && child->parent() != root)
+    child = child->parent();
+  ASSERT_TRUE(child);
+  ASSERT_NE(root->layer()->children().end(),
+            std::ranges::find(root->layer()->children(), child->layer()));
+  gfx::Point page_point = active_web_contents()
+                              ->GetRenderWidgetHostView()
+                              ->GetViewBounds()
+                              .right_center();
+  page_point.Offset(-40, 0);
+  views::View::ConvertPointFromScreen(widget->GetRootView(), &page_point);
+  const auto page_receives_input = [&] {
+    return widget->ShouldDescendIntoChildForEventHandling(
+        root->layer(), child, child->layer(), page_point);
+  };
+  EXPECT_TRUE(page_receives_input());
+  auto* shade = owner->capture_feedback_for_testing();
+  ASSERT_TRUE(shade->layer());
+  EXPECT_FALSE(shade->GetCanProcessEventsWithinSubtree());
+  // Visible capture feedback must paint over the source without blocking its
+  // native renderer; checking Views::HitTestRect alone missed this regression.
+  shade->SetBoundsRect(owner->GetLocalBounds());
+  shade->SetVisible(true);
+  EXPECT_TRUE(page_receives_input());
+  shade->SetVisible(false);
+  auto* anchor = owner->footer_for_testing()->children()[1].get();
+  gfx::Animation::SetPrefersReducedMotionForTesting(true);
+  owner->Toggle(Utility::kWorkspaces, anchor);
+  widget->GetRootView()->DeprecatedLayoutImmediately();
+  EXPECT_TRUE(page_receives_input());
+  gfx::Point panel_point =
+      owner->popover_content_for_testing()->GetBoundsInScreen().CenterPoint();
+  views::View::ConvertPointFromScreen(widget->GetRootView(), &panel_point);
+  EXPECT_FALSE(widget->ShouldDescendIntoChildForEventHandling(
+      root->layer(), child, child->layer(), panel_point));
+  owner->Close(false, true);
+  EXPECT_TRUE(page_receives_input());
+  gfx::Animation::SetPrefersReducedMotionForTesting(false);
+}
