+  EXPECT_TRUE(field->IsDrawn());
+  browser_view()->CloseEmberSearch();
+  EXPECT_FALSE(browser_view()->IsEmberSearchOpen());
+  EXPECT_EQ(nullptr, popup->parent());
+  browser_view()->ShowEmberSearch();
+  EXPECT_TRUE(omnibox->IsSelectAll());
 }
 
