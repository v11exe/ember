+void BrowserView::ScheduleEmberSearchClose() {
+  if (!IsEmberSearchOpen()) {
+    return;
+  }
+  // Native acceptance still holds references to the current match. Revert only
+  // after that callback finishes, and never dismiss a subsequently reopened edit.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+          [](base::WeakPtr<BrowserView> view, unsigned int generation) {
+            if (view && view->ember_search_generation_ == generation) {
+              view->CloseEmberSearch();
+            }
+          }, weak_ptr_factory_.GetWeakPtr(), ember_search_generation_));
+}
