+  browser_view()->ShowEmberSearch();
+  auto* omnibox = browser_view()->GetLocationBar()->GetOmniboxView();
+  omnibox->SetUserText(u"https://example.test/", true);
+  ui_test_utils::WaitForAutocompleteDone(browser());
+  auto* popup = static_cast<OmniboxPopupViewViews*>(
+      browser_view()->GetLocationBarView()->GetOmniboxPopupView());
+  ASSERT_TRUE(popup->parent());
+  EXPECT_EQ(browser_view(), popup->parent()->parent());
+  EXPECT_EQ(browser_view()->GetWidget(), popup->GetWidget());
+  EXPECT_TRUE(browser_view()->IsInEmberSearch(popup));
+  EXPECT_FALSE(browser_view()->IsInEmberSearch(browser_view()->contents_web_view()));
+  EXPECT_GT(popup->height(), 0);
