# Keep line endings LF in the repo so string edits and diffs behave the same
# for both agents on Windows. Git converts on checkout as needed.
* text=auto eol=lf
*.png binary
*.jpg binary
*.ico binary
# Unified-diff context lines representing a blank source line contain one
# required leading space. Keep other whitespace checks active for patch files.
*.patch whitespace=-blank-at-eol,-blank-at-eof
